@{
    ViewBag.Title = "About Us - Web Based Public Tender System";
    Layout = "_StaticLayout";
}

<!-- FontAwesome CSS -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;700&family=Playfair+Display:wght@700;900&display=swap" rel="stylesheet" />

<style>
    /* ══════════════════════════════════════════════════════════
           CSS VARIABLES
           ══════════════════════════════════════════════════════════ */
    :root {
        --navy: #0B1F3A;
        --navy-mid: #122848;
        --navy-light: #1a3560;
        --gold: #C8960C;
        --gold-lt: #E8B84B;
        --gold-pale: #f5e6c4;
        --ivory: #F7F3EC;
        --ivory-dark: #EDE7DC;
        --slate: #8A9BB5;
        --white: #ffffff;
        --muted-fg: #5a6a80;
        --font-body: 'DM Sans', system-ui, sans-serif;
        --font-heading: 'Playfair Display', Georgia, serif;
    }

    body {
        overflow-x: hidden;
        font-family: var(--font-body);
    }

    /* ═══════════════ ANIMATIONS ═══════════════ */
    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(28px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes float {
        0%, 100% {
            transform: translate(0, 0);
        }

        33% {
            transform: translate(15px, -20px);
        }

        66% {
            transform: translate(-10px, 10px);
        }
    }

    @@keyframes pulse-dot {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: 0.3;
        }
    }

    @@keyframes pulse-ring {
        0%, 100% {
            transform: scale(1);
            opacity: 0.5;
        }

        50% {
            transform: scale(1.08);
            opacity: 0.2;
        }
    }

    /* ═══════════════ HERO ═══════════════ */
    .about-hero {
        min-height: 80vh;
        background: var(--navy);
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 8rem 6vw 5rem;
        position: relative;
        overflow: hidden;
        width: 100vw;
        margin-left: calc(-50vw + 50%);
    }

    .about-hero-bg {
        position: absolute;
        inset: 0;
        background-image: linear-gradient(rgba(200,150,12,.04) 1px, transparent 1px), linear-gradient(90deg, rgba(200,150,12,.04) 1px, transparent 1px);
        background-size: 80px 80px;
        pointer-events: none;
    }

    .about-hero::after {
        content: '';
        position: absolute;
        bottom: -40%;
        left: 50%;
        transform: translateX(-50%);
        width: 900px;
        height: 900px;
        background: radial-gradient(circle, rgba(200,150,12,.1) 0%, transparent 60%);
        pointer-events: none;
    }

    .particle {
        position: absolute;
        border-radius: 50%;
        background: var(--gold);
        opacity: 0.08;
    }

    .particle-1 {
        width: 400px;
        height: 400px;
        top: 10%;
        right: 5%;
        animation: float 20s ease-in-out infinite;
    }

    .particle-2 {
        width: 200px;
        height: 200px;
        bottom: 20%;
        right: 25%;
        animation: float 15s ease-in-out infinite reverse;
    }

    .particle-3 {
        width: 120px;
        height: 120px;
        top: 40%;
        right: 40%;
        animation: float 12s ease-in-out infinite 3s;
    }

    .about-hero-content {
        position: relative;
        z-index: 2;
        max-width: 750px;
    }

    .hero-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        font-size: 0.7rem;
        font-weight: 500;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--gold);
        margin-bottom: 2rem;
        animation: fadeUp 0.7s ease both;
    }

    .eyebrow-line {
        display: inline-block;
        width: 36px;
        height: 1px;
        background: var(--gold);
    }

    .eyebrow-dot {
        display: inline-block;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--gold);
        animation: pulse-dot 2s ease-in-out infinite;
    }

    .about-hero-title {
        font-family: var(--font-heading);
        font-size: clamp(2.6rem, 5.5vw, 4.5rem);
        font-weight: 900;
        line-height: 1.1;
        color: var(--white);
        letter-spacing: -0.02em;
        animation: fadeUp 0.7s 0.12s ease both;
    }

        .about-hero-title em {
            font-style: normal;
            color: var(--gold-lt);
            position: relative;
        }

            .about-hero-title em::after {
                content: '';
                position: absolute;
                bottom: 4px;
                left: 0;
                width: 100%;
                height: 3px;
                background: linear-gradient(90deg, var(--gold), transparent);
                opacity: 0.4;
            }

    .about-hero-sub {
        margin-top: 2rem;
        font-size: 1.05rem;
        font-weight: 300;
        color: var(--slate);
        line-height: 1.8;
        animation: fadeUp 0.7s 0.24s ease both;
    }

    .about-hero-badges {
        margin-top: 2.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        flex-wrap: wrap;
        animation: fadeUp 0.7s 0.36s ease both;
    }

    .about-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1.2rem;
        border: 1px solid rgba(200,150,12,0.25);
        border-radius: 999px;
        font-size: 0.78rem;
        font-weight: 500;
        color: var(--gold-lt);
        letter-spacing: 0.04em;
        transition: all 0.3s;
    }

        .about-badge:hover {
            background: rgba(200,150,12,0.08);
            border-color: rgba(200,150,12,0.5);
        }

    /* ═══════════════ STORY ═══════════════ */
    .story-section {
        padding: 7rem 6vw;
        background: var(--ivory);
    }

    .story-inner {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        gap: 4rem;
        align-items: flex-start;
    }

    .story-left {
        flex: 0 0 360px;
        position: sticky;
        top: 6rem;
    }

    .story-right {
        flex: 1;
    }

    .section-label {
        font-size: 0.7rem;
        font-weight: 500;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--gold);
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }

    .section-label--light {
        color: var(--gold-lt);
    }

    .label-line {
        display: inline-block;
        width: 28px;
        height: 1px;
        background: var(--gold);
    }

    .label-line--light {
        background: var(--gold-lt);
    }

    .section-title {
        font-family: var(--font-heading);
        font-size: clamp(1.9rem, 3.5vw, 2.8rem);
        font-weight: 700;
        color: var(--navy);
        line-height: 1.2;
        margin-bottom: 1rem;
    }

        .section-title em {
            font-style: normal;
            color: var(--gold);
        }

    .section-title--light {
        color: var(--white);
    }

        .section-title--light em {
            color: var(--gold-lt);
        }

    .section-desc {
        font-size: 1rem;
        color: var(--muted-fg);
        line-height: 1.7;
        font-weight: 300;
    }

    .story-text {
        font-size: 1rem;
        color: var(--muted-fg);
        line-height: 1.85;
        font-weight: 300;
        margin-bottom: 1.5rem;
    }

    /* ═══════════════ VALUES ═══════════════ */
    .values-section {
        background: var(--navy);
        padding: 7rem 6vw;
        position: relative;
        overflow: hidden;
    }

        .values-section::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(200,150,12,.03) 1px, transparent 1px), linear-gradient(90deg, rgba(200,150,12,.03) 1px, transparent 1px);
            background-size: 80px 80px;
            pointer-events: none;
        }

    .values-inner {
        max-width: 1200px;
        margin: 0 auto;
        position: relative;
        z-index: 1;
    }

    .values-header {
        margin-bottom: 3.5rem;
    }

    .values-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.5rem;
    }

    .value-card {
        padding: 2rem;
        border: 1px solid rgba(200,150,12,0.1);
        border-radius: 10px;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        background: rgba(255,255,255,0.02);
    }

        .value-card:hover {
            background: rgba(200,150,12,0.06);
            border-color: rgba(200,150,12,0.25);
            transform: translateY(-4px);
        }

    .value-icon {
        width: 48px;
        height: 48px;
        border-radius: 10px;
        background: rgba(200,150,12,0.1);
        color: var(--gold);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1.2rem;
        transition: background 0.3s;
    }

    .value-card:hover .value-icon {
        background: rgba(200,150,12,0.18);
    }

    .value-title {
        font-family: var(--font-heading);
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--white);
        margin-bottom: 0.6rem;
    }

    .value-desc {
        font-size: 0.85rem;
        color: var(--slate);
        line-height: 1.75;
        font-weight: 300;
    }

    /* ═══════════════ TEAM ═══════════════ */
    .team-section {
        padding: 7rem 6vw;
        background: var(--ivory);
    }

    .team-inner {
        max-width: 1200px;
        margin: 0 auto;
    }

    .team-header {
        text-align: center;
        margin-bottom: 4rem;
        max-width: 560px;
        margin-left: auto;
        margin-right: auto;
    }

        .team-header .section-label {
            justify-content: center;
        }

    .team-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
    }

    .team-card {
        background: var(--white);
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid rgba(11,31,58,0.06);
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

        .team-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 30px 80px rgba(11,31,58,0.12);
            border-color: transparent;
        }

    .team-card-img {
        position: relative;
        overflow: hidden;
        aspect-ratio: 5/6;
    }

    .team-photo {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .team-card:hover .team-photo {
        transform: scale(1.05);
    }

    .team-card-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(11,31,58,0.85) 0%, transparent 50%);
        opacity: 0;
        transition: opacity 0.4s;
        display: flex;
        align-items: flex-end;
        justify-content: center;
        padding-bottom: 1.5rem;
    }

    .team-card:hover .team-card-overlay {
        opacity: 1;
    }

    .team-socials {
        display: flex;
        gap: 0.8rem;
    }

    .team-social-icon {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: rgba(255,255,255,0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--white);
        cursor: pointer;
        transition: all 0.3s;
        backdrop-filter: blur(4px);
        text-decoration: none;
    }

        .team-social-icon:hover {
            background: var(--gold);
            color: var(--navy);
        }

    .team-card-body {
        padding: 1.8rem;
    }

    .team-role-badge {
        display: inline-block;
        padding: 0.3rem 0.9rem;
        border-radius: 999px;
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        margin-bottom: 0.8rem;
    }

    .team-role-badge--gold {
        background: rgba(200,150,12,0.12);
        color: var(--gold);
    }

    .team-role-badge--blue {
        background: rgba(59,130,246,0.1);
        color: #3b82f6;
    }

    .team-role-badge--teal {
        background: rgba(20,184,166,0.1);
        color: #14b8a6;
    }

    .team-name {
        font-family: var(--font-heading);
        font-size: 1.35rem;
        font-weight: 700;
        color: var(--navy);
        margin-bottom: 0.6rem;
    }

    .team-desc {
        font-size: 0.88rem;
        color: var(--muted-fg);
        line-height: 1.75;
        font-weight: 300;
    }

    /* ═══════════════ MESSAGES ═══════════════ */
    .messages-section {
        background: var(--navy);
        padding: 7rem 6vw;
        position: relative;
        overflow: hidden;
    }

        .messages-section::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(200,150,12,.03) 1px, transparent 1px), linear-gradient(90deg, rgba(200,150,12,.03) 1px, transparent 1px);
            background-size: 80px 80px;
            pointer-events: none;
        }

    .messages-inner {
        max-width: 1100px;
        margin: 0 auto;
        position: relative;
        z-index: 1;
    }

    .messages-header {
        text-align: center;
        margin-bottom: 4rem;
    }

        .messages-header .section-label {
            justify-content: center;
        }

    .message-block {
        display: flex;
        gap: 3rem;
        align-items: flex-start;
        margin-bottom: 4rem;
        padding: 3rem;
        border: 1px solid rgba(200,150,12,0.1);
        border-radius: 16px;
        background: rgba(255,255,255,0.02);
        transition: all 0.4s;
    }

        .message-block:last-child {
            margin-bottom: 0;
        }

        .message-block:hover {
            background: rgba(200,150,12,0.04);
            border-color: rgba(200,150,12,0.2);
        }

    .message-avatar-col {
        flex: 0 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
    }

    .message-avatar-wrapper {
        position: relative;
        width: 100px;
        height: 100px;
    }

    .message-avatar {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid var(--gold);
    }

    .message-avatar-ring {
        position: absolute;
        inset: -6px;
        border-radius: 50%;
        border: 1px solid rgba(200,150,12,0.25);
        animation: pulse-ring 3s ease-in-out infinite;
    }

    .message-name {
        font-family: var(--font-heading);
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--white);
        text-align: center;
    }

    .message-role {
        font-size: 0.72rem;
        font-weight: 500;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--gold);
    }

    .message-content {
        flex: 1;
        position: relative;
    }

    .message-quote-mark {
        color: var(--gold);
        margin-bottom: 0.8rem;
    }

    .message-text {
        font-size: 1rem;
        color: var(--slate);
        line-height: 1.85;
        font-weight: 300;
        font-style: italic;
        border: none;
        margin: 0;
        padding: 0;
    }

    .message-signature {
        margin-top: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.8rem;
    }

    .message-sig-line {
        width: 32px;
        height: 1px;
        background: var(--gold);
    }

    .message-signature span {
        font-size: 0.78rem;
        font-weight: 500;
        color: var(--gold-lt);
        letter-spacing: 0.03em;
    }

    /* ═══════════════ EMPOWERMENT ═══════════════ */
    .empowerment-section {
        background: linear-gradient(135deg, var(--ivory) 0%, var(--ivory-dark) 100%);
        padding: 6rem 6vw;
        text-align: center;
    }

    .empowerment-inner {
        max-width: 800px;
        margin: 0 auto;
    }

    .empowerment-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: rgba(200,150,12,0.1);
        color: var(--gold);
        margin-bottom: 2rem;
    }

    .empowerment-title {
        font-family: var(--font-heading);
        font-size: clamp(1.8rem, 3.5vw, 2.5rem);
        font-weight: 700;
        color: var(--navy);
        margin-bottom: 1.2rem;
    }

    .empowerment-desc {
        font-size: 1rem;
        color: var(--muted-fg);
        line-height: 1.85;
        font-weight: 300;
        margin-bottom: 3rem;
    }

    .empowerment-stats {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 2.5rem;
        flex-wrap: wrap;
    }

    .empowerment-stat {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.3rem;
    }

    .empowerment-stat-num {
        font-family: var(--font-heading);
        font-size: 1.8rem;
        font-weight: 700;
        color: var(--navy);
    }

    .empowerment-stat-label {
        font-size: 0.72rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--muted-fg);
        font-weight: 500;
    }

    .empowerment-divider {
        width: 1px;
        height: 40px;
        background: rgba(11,31,58,0.12);
    }

    /* ═══════════════ CTA ═══════════════ */
    .cta-section {
        background: linear-gradient(135deg, var(--navy-mid) 0%, var(--navy) 100%);
        padding: 7rem 6vw;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

        .cta-section::before {
            content: '';
            position: absolute;
            top: -50%;
            left: 50%;
            transform: translateX(-50%);
            width: 800px;
            height: 800px;
            background: radial-gradient(circle, rgba(200,150,12,0.08) 0%, transparent 65%);
            pointer-events: none;
        }

    .cta-inner {
        position: relative;
        z-index: 1;
        max-width: 600px;
        margin: 0 auto;
    }

    .cta-badge {
        display: inline-block;
        padding: 0.4rem 1.2rem;
        border: 1px solid rgba(200,150,12,0.3);
        border-radius: 999px;
        font-size: 0.72rem;
        font-weight: 500;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--gold-lt);
        margin-bottom: 2rem;
    }

    .cta-section h2 {
        font-family: var(--font-heading);
        font-size: clamp(2rem, 4vw, 3rem);
        color: var(--white);
        margin-bottom: 1rem;
        font-weight: 700;
    }

    .cta-section p {
        color: var(--slate);
        font-size: 1.05rem;
        margin-bottom: 2.5rem;
        line-height: 1.7;
        font-weight: 300;
    }

    .cta-actions {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        flex-wrap: wrap;
    }

    /* ═══════════════ BUTTONS ═══════════════ */
    .btn-primary {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.9rem 2.2rem;
        background: var(--gold);
        color: var(--navy);
        font-weight: 700;
        font-size: 0.95rem;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        letter-spacing: 0.02em;
        box-shadow: 0 4px 20px rgba(200,150,12,0.25);
        position: relative;
        overflow: hidden;
    }

        .btn-primary:hover {
            background: var(--gold-lt);
            transform: translateY(-2px);
            box-shadow: 0 8px 30px rgba(200,150,12,0.35);
            color: var(--navy);
            text-decoration: none;
        }

    .btn-primary--lg {
        padding: 1.05rem 2.6rem;
        font-size: 1rem;
    }

    .btn-ghost {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.9rem 2rem;
        background: transparent;
        color: var(--slate);
        font-weight: 500;
        font-size: 0.95rem;
        border: none;
        cursor: pointer;
        text-decoration: none;
        transition: color 0.3s;
    }

        .btn-ghost:hover {
            color: var(--white);
            text-decoration: none;
        }

    /* ═══════════════ FOOTER ═══════════════ */
    .site-footer {
        background: var(--navy);
        border-top: 1px solid rgba(200,150,12,0.1);
        padding: 2.5rem 6vw;
    }

    .footer-inner {
        max-width: 1280px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .footer-brand {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
    }

    .footer-logo {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        color: var(--white);
        font-weight: 700;
        font-size: 0.95rem;
    }

        .footer-logo i {
            color: var(--gold);
        }

    .footer-tagline {
        font-size: 0.78rem;
        color: var(--slate);
        font-weight: 300;
        letter-spacing: 0.05em;
    }

    .footer-copy {
        font-size: 0.78rem;
        color: rgba(138,155,181,0.5);
    }

    /* ═══════════════ RESPONSIVE ═══════════════ */
    @@media (max-width: 1024px) {
        .values-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .team-grid {
