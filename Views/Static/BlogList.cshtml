@model IEnumerable<TenderSystem.Models.BlogContentEdit>
@{
    Layout = "_StaticLayout";
    ViewData["Title"] = "Blog Page";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

<style>
    :root {
        --navy: #0B1F3A;
        --navy-mid: #122848;
        --gold: #C8960C;
        --gold-lt: #E8B84B;
        --ivory: #F7F3EC;
        --slate: #8A9BB5;
        --white: #ffffff;
        --muted: #5a6a80;
    }

    /* ── PAGE HERO ── */
    .spb-hero {
        background: var(--navy);
        position: relative;
        overflow: hidden;
        padding: 3.5rem 2rem 5.5rem;
        text-align: center;
    }

        .spb-hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(200,150,12,.05) 1px, transparent 1px), linear-gradient(90deg, rgba(200,150,12,.05) 1px, transparent 1px);
            background-size: 40px 40px;
            pointer-events: none;
        }

        .spb-hero::after {
            content: '';
            position: absolute;
            top: -40%;
            left: 50%;
            transform: translateX(-50%);
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(200,150,12,.13) 0%, transparent 65%);
            pointer-events: none;
        }

    .spb-hero-inner {
        position: relative;
        z-index: 2;
    }

    .spb-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: .6rem;
        font-size: .65rem;
        font-weight: 600;
        letter-spacing: .22em;
        text-transform: uppercase;
        color: var(--gold);
        margin-bottom: .6rem;
        font-family: 'DM Sans', sans-serif;
    }

        .spb-eyebrow span {
            display: inline-block;
            width: 18px;
            height: 1px;
            background: var(--gold);
        }

    .spb-hero h1 {
        font-family: 'Playfair Display', serif;
        font-size: clamp(1.8rem, 4vw, 2.8rem);
        font-weight: 900;
        color: var(--white);
        margin: 0 0 .5rem;
        line-height: 1.15;
    }

        .spb-hero h1 em {
            font-style: normal;
            color: var(--gold-lt);
        }

    .spb-hero-sub {
        font-size: .92rem;
        color: var(--slate);
        font-family: 'DM Sans', sans-serif;
        margin: 0;
    }

    /* ── FEED ── */
    .spb-feed {
        max-width: 780px;
        margin: -2.5rem auto 4rem;
        padding: 0 1.2rem;
        position: relative;
        z-index: 2;
        font-family: 'DM Sans', sans-serif;
    }

    /* ── BLOG CARD ── */
    .blog-card {
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 5px 24px rgba(11,31,58,.08);
        transition: transform .3s ease, box-shadow .3s ease;
        margin-bottom: 1.8rem;
        background: var(--white);
        border: 1px solid rgba(11,31,58,.06);
    }

        .blog-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 14px 40px rgba(11,31,58,.14);
        }

    /* header */
    .blog-header {
        padding: .9rem 1.3rem;
        border-bottom: 1px solid rgba(11,31,58,.05);
        display: flex;
        align-items: center;
        gap: .75rem;
        background: var(--navy);
    }

    .user-photo {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid rgba(200,150,12,.3);
        box-shadow: 0 2px 8px rgba(11,31,58,.15);
        flex-shrink: 0;
    }

    .user-photo-placeholder {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: rgba(200,150,12,.15);
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid rgba(200,150,12,.25);
        color: var(--gold);
        font-size: 1.1rem;
        flex-shrink: 0;
    }

    .user-info {
        flex: 1;
    }

    .user-name {
        font-weight: 700;
        color: var(--white);
        font-size: .9rem;
        margin: 0 0 .1rem;
    }

    .post-date {
        font-size: .72rem;
        color: var(--slate);
        display: flex;
        align-items: center;
        gap: .3rem;
    }

        .post-date i {
            color: var(--gold);
            font-size: .68rem;
        }

    /* content */
    .blog-content {
        padding: 1.3rem 1.4rem;
    }

    .blog-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.25rem;
        font-weight: 900;
        color: var(--navy);
        margin: 0 0 .85rem;
        line-height: 1.3;
    }

    .blog-description {
        color: var(--muted);
        line-height: 1.7;
        font-size: .88rem;
        overflow: hidden;
        position: relative;
        max-height: 100px;
        transition: max-height 0.3s ease;
    }

        .blog-description.expanded {
            max-height: 2000px;
        }

        .blog-description.collapsed::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 70px;
            background: linear-gradient(to bottom, rgba(255,255,255,0), rgba(255,255,255,1));
            pointer-events: none;
        }

    .read-more-btn {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        color: var(--gold);
        font-weight: 700;
        font-size: .82rem;
        margin-top: .75rem;
        cursor: pointer;
        transition: color .2s ease;
    }

        .read-more-btn:hover {
            color: var(--gold-lt);
        }

    /* image */
    .blog-image-container {
        width: 100%;
        max-height: 400px;
        overflow: hidden;
    }

    .blog-image {
        width: 100%;
        height: auto;
        object-fit: cover;
        display: block;
        transition: transform 0.3s ease;
        cursor: pointer;
    }

        .blog-image:hover {
            transform: scale(1.02);
        }

    /* ── IMAGE MODAL ── */
    .image-modal {
        display: none;
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgba(0,0,0,.9);
        cursor: pointer;
    }

    .image-modal-content {
        position: relative;
        margin: auto;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        width: 100%;
        padding: 20px;
        box-sizing: border-box;
    }

    .image-modal-img {
        max-width: 90%;
        max-height: 90%;
        object-fit: contain;
        box-shadow: 0 0 20px rgba(255,255,255,.1);
        border-radius: 4px;
    }

    .image-modal-close {
        position: absolute;
        top: 20px;
        right: 30px;
        color: #f1f1f1;
        font-size: 40px;
        font-weight: bold;
        cursor: pointer;
        z-index: 1001;
        transition: .3s;
    }

        .image-modal-close:hover {
            color: var(--gold-lt);
            transform: scale(1.1);
        }

    /* empty */
    .spb-empty {
        text-align: center;
        padding: 4rem 1rem;
    }

        .spb-empty i {
            font-size: 2.8rem;
            color: var(--gold);
            opacity: .25;
            margin-bottom: 1rem;
            display: block;
        }

        .spb-empty h3 {
            font-family: 'Playfair Display', serif;
            font-size: 1.2rem;
            color: var(--navy);
            margin-bottom: .4rem;
        }

        .spb-empty p {
            font-size: .88rem;
            color: var(--slate);
        }

    @@media (max-width: 768px) {
        .spb-hero {
            padding: 2.5rem 1.2rem 4.5rem;
        }

        .spb-feed {
            padding: 0 .75rem;
        }
    }
</style>

<!-- PAGE HERO -->
<div class="spb-hero">
    <div class="spb-hero-inner">
        <p class="spb-eyebrow"><span></span> Our Blog <span></span></p>
        <h1>Insights &amp; <em>Updates</em></h1>
        <p class="spb-hero-sub">Thoughts, news and insights from our community</p>
    </div>
</div>

<!-- FEED -->
<div class="spb-feed">

    @if (Model.Any())
    {
        @foreach (var blog in Model)
        {
            <div class="blog-card">
                <div class="blog-header">
                    @if (!string.IsNullOrEmpty(blog.UserPhoto))
                    {
                        <img src="~/UserImage/@blog.UserPhoto" alt="@blog.FirstName's photo" class="user-photo" />
                    }
                    else
                    {
                        <div class="user-photo-placeholder">
                            <i class="fas fa-user"></i>
                        </div>
                    }
                    <div class="user-info">
                        <h6 class="user-name">
                            @blog.FirstName
                            @(!string.IsNullOrEmpty(blog.MiddleName) ? blog.MiddleName + " " : "")
                            @blog.LastName
                        </h6>
                        <span class="post-date">
                            <i class="far fa-calendar-alt me-1"></i>
                            @blog.Postdate.ToString("MMMM dd, yyyy")
                        </span>
                    </div>
                </div>

                <div class="blog-content">
                    <h2 class="blog-title">@blog.SectionHeading</h2>
                    <div class="blog-description collapsed">
                        @Html.Raw(blog.SectionDescription)
                    </div>
                    <div class="read-more-btn">
                        Read More <i class="fas fa-chevron-down ms-1"></i>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(blog.SectionImage))
                {
                    <div class="blog-image-container">
                        <img src="~/BlogImage/@blog.SectionImage" class="blog-image" alt="Blog Image" />
                    </div>
                }
            </div>
        }
    }
    else
    {
        <div class="spb-empty">
            <i class="fas fa-newspaper"></i>
            <h3>No posts yet</h3>
            <p>Check back soon for updates from our community.</p>
        </div>
    }

</div>

<script>
    $(document).ready(function () {
        $('.read-more-btn').each(function () {
            var button = $(this);
            var description = button.prev('.blog-description');

            // Check if description needs a "Read More" button
            if (description.prop('scrollHeight') <= 100) {
                button.hide();
                description.removeClass('collapsed');
            }

            // Add click event
            button.on('click', function () {
                var isCollapsed = description.hasClass('collapsed');

                if (isCollapsed) {
                    description.removeClass('collapsed').addClass('expanded');
                    button.html('Show Less <i class="fas fa-chevron-up ms-1"></i>');
                } else {
                    description.removeClass('expanded').addClass('collapsed');
                    button.html('Read More <i class="fas fa-chevron-down ms-1"></i>');

                    // Smooth scroll
                    $('html, body').animate({
                        scrollTop: button.closest('.blog-card').offset().top - 20
                    }, 300);
                }
            });
        });

        // New image viewer functionality
        $('.blog-image').on('click', function () {
            var imageUrl = $(this).attr('src');

            // Create modal for full-size image view
            var imageModal = $('<div id="imageModal" class="image-modal">' +
                '<div class="image-modal-content">' +
                '<span class="image-modal-close">&times;</span>' +
                '<img src="' + imageUrl + '" class="image-modal-img">' +
                '</div></div>');

            // Add modal to body
            $('body').append(imageModal);

            // Show the modal
            $('#imageModal').fadeIn(300);

            // Close modal when clicking X or outside the image
            $('.image-modal-close, .image-modal').on('click', function (e) {
                if (e.target === this || $(e.target).hasClass('image-modal-close')) {
                    $('#imageModal').fadeOut(300, function () {
                        $(this).remove();
                    });
                }
            });
        });
    });
</script>
