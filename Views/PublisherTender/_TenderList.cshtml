@model IEnumerable<TenderEdit>

<style>
    :root {
        --navy: #0B1F3A;
        --navy-mid: #122848;
        --gold: #C8960C;
        --gold-lt: #E8B84B;
        --ivory: #F7F3EC;
        --slate: #8A9BB5;
        --white: #ffffff;
        --muted: #5a6a80;
    }

    .tl-partial {
        font-family: 'DM Sans', sans-serif;
    }

    /* ── TOOLBAR ── */
    .tl-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 1.4rem;
    }

    .tl-toolbar-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--navy);
        display: flex;
        align-items: center;
        gap: .5rem;
    }

        .tl-toolbar-title i {
            color: var(--gold);
        }

    .tl-controls {
        display: flex;
        gap: .75rem;
        flex-wrap: wrap;
        align-items: center;
    }

        .tl-controls select,
        .tl-controls input[type="text"] {
            background: var(--white);
            border: 1px solid rgba(11,31,58,.14);
            color: var(--navy);
            font-size: .85rem;
            font-family: 'DM Sans', sans-serif;
            border-radius: 7px;
            padding: .55rem 1rem;
            outline: none;
            transition: border-color .2s, box-shadow .2s;
            min-width: 160px;
        }

            .tl-controls select:focus,
            .tl-controls input[type="text"]:focus {
                border-color: var(--gold);
                box-shadow: 0 0 0 3px rgba(200,150,12,.1);
            }

            .tl-controls input[type="text"]::placeholder {
                color: var(--slate);
            }

    .tl-result-count {
        font-size: .78rem;
        color: var(--slate);
        font-weight: 500;
    }

    /* ── TABLE ── */
    .tl-table-wrap {
        background: var(--white);
        border-radius: 12px;
        border: 1px solid rgba(11,31,58,.07);
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(11,31,58,.06);
    }

    .tl-table {
        width: 100%;
        border-collapse: collapse;
        font-size: .875rem;
    }

        .tl-table thead tr {
            background: var(--navy);
        }

        .tl-table thead th {
            padding: .95rem 1.4rem;
            font-size: .65rem;
            font-weight: 600;
            letter-spacing: .14em;
            text-transform: uppercase;
            color: var(--slate);
            text-align: center;
        }

        .tl-table tbody tr {
            border-bottom: 1px solid rgba(11,31,58,.05);
            transition: background .18s;
        }

            .tl-table tbody tr:last-child {
                border-bottom: none;
            }

            .tl-table tbody tr:hover {
                background: rgba(200,150,12,.03) !important;
            }

        .tl-table td {
            padding: 1rem 1.4rem;
            color: var(--muted);
            text-align: center;
            vertical-align: middle;
        }

    .tl-id {
        font-family: 'Playfair Display', serif;
        font-weight: 700;
        color: var(--navy);
        font-size: .9rem;
    }

    .tl-title {
        color: var(--navy);
        font-weight: 600;
        font-size: .9rem;
        max-width: 260px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        margin: 0 auto;
    }

    /* Status badges */
    .tl-badge {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        padding: .28rem .85rem;
        border-radius: 999px;
        font-size: .68rem;
        font-weight: 700;
        letter-spacing: .05em;
        text-transform: uppercase;
    }

    .tl-badge-verified {
        background: rgba(16,185,129,.1);
        color: #059669;
    }

    .tl-badge-pending {
        background: rgba(245,158,11,.1);
        color: #b45309;
    }

    .tl-badge-notverified {
        background: rgba(239,68,68,.1);
        color: #dc2626;
    }

    .tl-badge-na {
        background: rgba(138,155,181,.1);
        color: var(--slate);
    }

    /* Date */
    .tl-date {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        font-size: .85rem;
    }

        .tl-date i {
            color: var(--gold);
        }

    /* Action buttons */
    .tl-btn {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .4rem .9rem;
        border-radius: 6px;
        font-size: .78rem;
        font-weight: 600;
        font-family: 'DM Sans', sans-serif;
        text-decoration: none;
        transition: transform .2s, box-shadow .2s, filter .2s;
        border: none;
        cursor: pointer;
    }

        .tl-btn:hover {
            transform: translateY(-2px);
            filter: brightness(1.08);
        }

    .tl-btn-view {
        background: var(--navy);
        color: var(--white);
    }

    .tl-btn-edit {
        background: #10b981;
        color: var(--white);
    }

    .tl-btn-delete {
        background: #ef4444;
        color: var(--white);
    }

    .tl-actions {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .5rem;
        flex-wrap: wrap;
    }

    /* Empty state */
    .tl-empty {
        text-align: center;
        padding: 3rem;
        color: var(--slate);
    }

        .tl-empty i {
            font-size: 2.5rem;
            color: var(--gold);
            opacity: .35;
            display: block;
            margin-bottom: 1rem;
        }

    @@media (max-width: 768px) {
        .tl-toolbar

    {
        flex-direction: column;
        align-items: flex-start;
    }

    .tl-controls {
        width: 100%;
    }

        .tl-controls select, .tl-controls input[type="text"] {
            min-width: 0;
            flex: 1;
        }

    }
</style>

<div class="tl-partial">

    <!-- Toolbar -->
    <div class="tl-toolbar">
        <h2 class="tl-toolbar-title">
            <i class="fas fa-list"></i> Published Tenders
        </h2>
        <div class="tl-controls">
            <select id="statusFilter" onchange="filterTable()">
                <option value="">All Status</option>
                <option value="verified">Verified</option>
                <option value="not verified">Not Verified</option>
                <option value="pending">Pending</option>
            </select>
            <input type="text" id="searchInput" placeholder="Search tenders..." onkeyup="searchTable()" />
            <span class="tl-result-count" id="resultCount"></span>
        </div>
    </div>

    <!-- Table -->
    <div class="tl-table-wrap">
        <div style="overflow-x:auto;">
            <table class="tl-table" id="tenderTable">
                <thead>
                    <tr>
                        <th>Tender ID</th>
                        <th>Title</th>
                        <th>Status</th>
                        <th>Date Published</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var tender in Model)
                        {
                            <tr data-status="@tender.IsVerified.ToLower()">
                                <td><span class="tl-id">#@tender.TenderId</span></td>
                                <td><div class="tl-title" title="@tender.Title">@tender.Title</div></td>
                                <td>
                                    @if (tender.IsVerified == "Verified")
                                    {
                                        <span class="tl-badge tl-badge-verified">
                                            <i class="fas fa-check-circle"></i> Verified
                                        </span>
                                    }
                                    else if (tender.IsVerified == "Pending")
                                    {
                                        <span class="tl-badge tl-badge-pending">
                                            <i class="fas fa-clock"></i> Pending
                                        </span>
                                    }
                                    else if (!string.IsNullOrEmpty(tender.IsVerified))
                                    {
                                        <span class="tl-badge tl-badge-notverified">
                                            <i class="fas fa-times-circle"></i> @tender.IsVerified
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="tl-badge tl-badge-na">Not Available</span>
                                    }
                                </td>
                                <td>
                                    <span class="tl-date">
                                        <i class="fas fa-calendar-alt"></i>
                                        @tender.IssuedDate.ToShortDateString()
                                    </span>
                                </td>
                                <td>
                                    <div class="tl-actions">
                                        <a asp-action="TenderDetails" asp-controller="PublisherTender" asp-route-id="@tender.EncId"
                                           class="tl-btn tl-btn-view">
                                            <i class="fas fa-eye"></i> View
                                        </a>
                                        @if (tender.IsVerified == "Pending")
                                        {
                                            <a asp-action="EditTender" asp-controller="PublisherTender" asp-route-id="@tender.EncId"
                                               class="tl-btn tl-btn-edit">
                                                <i class="fas fa-edit"></i> Edit
                                            </a>
                                            <form asp-action="DeleteTenderConfirmed" asp-controller="PublisherTender" asp-route-id="@tender.EncId" method="post" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="tl-btn tl-btn-delete">
                                                    <i class="fas fa-trash-alt"></i> Delete
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5">
                                <div class="tl-empty">
                                    <i class="fas fa-file-alt"></i>
                                    <p style="font-family:'Playfair Display',serif;font-size:1rem;color:var(--navy);margin-bottom:.3rem;">No tenders found</p>
                                    <p style="font-size:.85rem;">You haven't published any tenders yet.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

<script>
    // Function to filter table rows based on status
    function filterTable() {
        const filterValue = document.getElementById("statusFilter").value.toLowerCase();
        const rows = document.querySelectorAll("#tenderTable tbody tr");

        rows.forEach(row => {
            const status = row.getAttribute("data-status").toLowerCase();
            if (filterValue === "" || status.includes(filterValue)) {
                row.style.display = "";
            } else {
                row.style.display = "none";
            }
        });
    }

    // Function to search the table by tender title
    function searchTable() {
        const searchValue = document.getElementById("searchInput").value.toLowerCase();
        const rows = document.querySelectorAll("#tenderTable tbody tr");

        rows.forEach(row => {
            const title = row.cells[1].textContent.toLowerCase();
            if (title.includes(searchValue)) {
                row.style.display = "";
            } else {
                row.style.display = "none";
            }
        });
    }
</script>
