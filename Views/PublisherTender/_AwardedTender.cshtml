@model IEnumerable<TenderEdit>

<style>
    :root {
        --navy: #0B1F3A;
        --gold: #C8960C;
        --gold-lt: #E8B84B;
        --ivory: #F7F3EC;
        --slate: #8A9BB5;
        --white: #ffffff;
        --muted: #5a6a80;
        --accent: #f59e0b; /* amber — Awarded */
        --accent-bg: rgba(245,158,11,.08);
    }

    .at-partial {
        font-family: 'DM Sans', sans-serif;
    }

    .at-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 1.4rem;
    }

    .at-toolbar-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--navy);
        display: flex;
        align-items: center;
        gap: .5rem;
    }

        .at-toolbar-title .title-icon {
            width: 30px;
            height: 30px;
            border-radius: 7px;
            background: var(--accent-bg);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--accent);
            font-size: .8rem;
        }

    .at-controls {
        display: flex;
        gap: .75rem;
        flex-wrap: wrap;
        align-items: center;
    }

        .at-controls select,
        .at-controls input[type="text"] {
            background: var(--white);
            border: 1px solid rgba(11,31,58,.14);
            color: var(--navy);
            font-size: .85rem;
            font-family: 'DM Sans', sans-serif;
            border-radius: 7px;
            padding: .55rem 1rem;
            outline: none;
            transition: border-color .2s, box-shadow .2s;
            min-width: 160px;
        }

            .at-controls select:focus,
            .at-controls input[type="text"]:focus {
                border-color: var(--gold);
                box-shadow: 0 0 0 3px rgba(200,150,12,.1);
            }

            .at-controls input[type="text"]::placeholder {
                color: var(--slate);
            }

    .at-count {
        font-size: .78rem;
        color: var(--slate);
        font-weight: 500;
    }

    .at-table-wrap {
        background: var(--white);
        border-radius: 12px;
        border: 1px solid rgba(11,31,58,.07);
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(11,31,58,.06);
    }

    .at-table {
        width: 100%;
        border-collapse: collapse;
        font-size: .875rem;
    }

        .at-table thead tr {
            background: var(--navy);
        }

        .at-table thead th {
            padding: .95rem 1rem;
            font-size: .7rem;
            font-weight: 700;
            letter-spacing: .12em;
            text-transform: uppercase;
            color: #ffffff;
            text-align: center;
            white-space: nowrap;
        }

        .at-table tbody tr {
            border-bottom: 1px solid rgba(11,31,58,.05);
            transition: background .18s;
        }

            .at-table tbody tr:last-child {
                border-bottom: none;
            }

            .at-table tbody tr:hover {
                background: rgba(200,150,12,.03) !important;
            }

        .at-table td {
            padding: .95rem 1rem;
            color: var(--muted);
            text-align: center;
            vertical-align: middle;
        }

    .at-id {
        font-family: 'Playfair Display', serif;
        font-weight: 700;
        color: var(--navy);
        font-size: .9rem;
    }

    .at-title {
        color: var(--navy);
        font-weight: 600;
        font-size: .88rem;
        max-width: 200px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        margin: 0 auto;
    }

    .at-type-badge {
        display: inline-flex;
        padding: .22rem .7rem;
        border-radius: 999px;
        font-size: .68rem;
        font-weight: 700;
        letter-spacing: .05em;
        text-transform: uppercase;
        background: rgba(11,31,58,.06);
        color: var(--navy);
    }

    .at-date {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        font-size: .85rem;
    }

        .at-date i {
            color: var(--gold);
        }

    }

    /* Action icon buttons */
    .at-action-wrap {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .6rem;
    }

    .at-icon-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        border-radius: 7px;
        font-size: .9rem;
        text-decoration: none;
        transition: transform .2s, filter .2s;
    }

        .at-icon-btn:hover {
            transform: translateY(-2px);
            filter: brightness(1.1);
            text-decoration: none;
        }

    .at-icon-view {
        background: rgba(11,31,58,.08);
        color: var(--navy);
    }

    .at-icon-pay {
        background: rgba(16,185,129,.1);
        color: #059669;
    }

    .at-empty {
        text-align: center;
        padding: 3rem;
        color: var(--slate);
    }

        .at-empty i {
            font-size: 2.5rem;
            color: var(--gold);
            opacity: .35;
            display: block;
            margin-bottom: 1rem;
        }

    @@media (max-width: 1024px) {
        .at-table thead th:nth-child(3),
        .at-table tbody td:nth-child(3) {
            display: none;
        }
    }

    @@media (max-width: 768px) {
        .at-toolbar {
            flex-direction: column;
            align-items: flex-start;
        }

        .at-controls {
            width: 100%;
        }

            .at-controls select, .at-controls input[type="text"] {
                min-width: 0;
                flex: 1;
            }
    }
</style>

<div class="at-partial">

    <div class="at-toolbar">
        <h2 class="at-toolbar-title">
            <span class="title-icon"><i class="fas fa-award"></i></span>
            Awarded Tenders
        </h2>
        <div class="at-controls">
            <select id="typeFilter" onchange="filterByType()">
                <option value="">All Types</option>
                @foreach (var type in Model.Select(t => t.TenderType).Distinct())
                {
                    <option value="@type">@type</option>
                }
            </select>
            <input type="text" id="searchInput" placeholder="Search tenders..." onkeyup="searchTable()" />
            <span class="at-count" id="resultCount"></span>
        </div>
    </div>

    <div class="at-table-wrap">
        <div style="overflow-x:auto;">
            <table class="at-table" id="tenderTable">
                <thead>
                    <tr>
                        <th>Tender ID</th>
                        <th>Title</th>
                        <th>Type</th>
                        <th>Award Date</th>
                        <th>Company</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var tender in Model)
                        {
                            <tr class="tender-card"
                                data-status="@tender.IsVerified"
                                data-type="@tender.TenderType.ToLower()"
                                data-search="@(tender.TenderId + " " + tender.Title + " " + tender.IsVerified)">
                                <td><span class="at-id">#@tender.TenderId</span></td>
                                <td><div class="at-title" title="@tender.Title">@tender.Title</div></td>
                                <td><span class="at-type-badge">@tender.TenderType</span></td>
                                <td>
                                    <span class="at-date">
                                        <i class="fas fa-calendar-alt"></i>
                                        @tender.AwardDate
                                    </span>
                                </td>
                                <td>
                                    <div class="at-title" title="@tender.AwardedCompany.CompanyName">
                                        @tender.AwardedCompany.CompanyName
                                    </div>
                                </td>
                                
                                <td>
                                    <div class="at-action-wrap">
                                        <a asp-action="TenderDetails" asp-controller="PublisherTender" asp-route-id="@tender.EncId"
                                           class="at-icon-btn at-icon-view" title="View Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7">
                                <div class="at-empty">
                                    <i class="fas fa-award"></i>
                                    <p style="font-family:'Playfair Display',serif;font-size:1rem;color:var(--navy);margin-bottom:.3rem;">No awarded tenders</p>
                                    <p style="font-size:.85rem;">There are currently no awarded tenders to display.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <div id="noResults" class="at-empty hidden">
                <p>No tenders found matching your criteria</p>
            </div>
        </div>
    </div>

</div>

<script>
    function searchTable() {
        const searchValue = document.getElementById("searchInput").value.toLowerCase();
        const rows = document.querySelectorAll("#tenderTable tbody tr");

        rows.forEach(row => {
            const title = row.cells[1].textContent.toLowerCase();
            if (title.includes(searchValue)) {
                row.style.display = "";
            } else {
                row.style.display = "none";
            }
        });
    }

    function filterByType() {
        const selectedType = document.getElementById("typeFilter").value;
        const rows = document.querySelectorAll("#tenderTable tbody tr");
        const noResults = document.getElementById("noResults");
        let visibleCount = 0;

        rows.forEach(row => {
            const type = row.getAttribute("data-type");
            if (!selectedType || type === selectedType.toLowerCase()) {
                row.style.display = "";
                visibleCount++;
            } else {
                row.style.display = "none";
            }
        });

        noResults.classList.toggle("hidden", visibleCount > 0);

        const resultCount = document.getElementById("resultCount");
        if (resultCount) {
            resultCount.textContent = `Showing ${visibleCount} result${visibleCount !== 1 ? 's' : ''}`;
        }
    }
</script>
