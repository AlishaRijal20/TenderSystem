@model PublisherDashboardViewModel
@{
    Layout = "_Layout";
}

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@300;400;500;700&display=swap" rel="stylesheet" />

<style>
    :root {
        --navy: #0B1F3A;
        --navy-mid: #122848;
        --gold: #C8960C;
        --gold-lt: #E8B84B;
        --ivory: #F7F3EC;
        --slate: #8A9BB5;
        --white: #ffffff;
        --muted: #5a6a80;
        --success: #10b981;
    }

    /*
            _Layout wraps @@RenderBody() inside:
    <div class="container mx-auto px-4 py-6" >
    That adds 1rem horizontal padding + 1.5rem top padding,
    causing the ivory bg and navy hero to leave gaps.
    .dash-bleed uses negative margins to escape that box fully.
    */
    .dash-bleed {
        /* True full-viewport bleed — escapes both the container's padding
               AND its max-width, so no side gaps at any screen size */
        position: relative;
        left: 50%;
        width: 100vw;
        margin-left: -50vw;
        margin-top: -1.5rem;
        background: var(--ivory);
        min-height: 100vh;
        overflow-x: hidden;
    }

    .dashboard-container {
        padding: 2rem;
        max-width: 1400px;
        margin: 0 auto;
        font-family: 'DM Sans', sans-serif;
    }

    /* ── HERO ── */
    .hero-section {
        position: relative;
        overflow: hidden;
        background: var(--navy);
    }

    .hero-pattern {
        position: absolute;
        inset: 0;
        background-image: linear-gradient(rgba(200,150,12,.05) 1px, transparent 1px), linear-gradient(90deg, rgba(200,150,12,.05) 1px, transparent 1px);
        background-size: 40px 40px;
        z-index: 1;
        pointer-events: none;
    }

    .hero-glow {
        position: absolute;
        top: -40%;
        right: -5%;
        width: 400px;
        height: 400px;
        background: radial-gradient(circle, rgba(200,150,12,.18) 0%, transparent 65%);
        z-index: 1;
        pointer-events: none;
    }

    .hero-content {
        padding: 3.5rem 2.5rem;
        position: relative;
        z-index: 2;
    }

    .welcome-message {
        max-width: 780px;
        margin: 0 auto;
        text-align: center;
    }

    .hero-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        font-size: .68rem;
        font-weight: 500;
        letter-spacing: .2em;
        text-transform: uppercase;
        color: var(--gold);
        margin-bottom: 1rem;
    }

        .hero-eyebrow span {
            display: inline-block;
            width: 24px;
            height: 1px;
            background: var(--gold);
        }

    .welcome-title {
        font-family: 'Playfair Display', serif;
        font-size: clamp(1.8rem, 3.5vw, 2.8rem);
        font-weight: 900;
        color: var(--white);
        margin-bottom: .9rem;
        line-height: 1.15;
    }

        .welcome-title em {
            font-style: normal;
            color: var(--gold-lt);
        }

    .welcome-subtitle {
        font-size: 1rem;
        color: var(--slate);
        margin-bottom: 0;
        line-height: 1.7;
        font-weight: 300;
    }

    .highlight {
        color: var(--gold-lt);
        font-weight: 600;
    }

    /* ── STATS ── */
    .stats-section {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1.2rem;
        margin-bottom: 2rem;
        padding-top: 2rem;
    }

    .stat-card {
        background: var(--white);
        border-radius: 12px;
        padding: 1.6rem;
        border: 1px solid rgba(11,31,58,.07);
        display: flex;
        flex-direction: column;
        position: relative;
        overflow: hidden;
        transition: transform .3s ease, box-shadow .3s ease;
    }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 3px;
            height: 100%;
            opacity: 0;
            transition: opacity .3s;
        }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 16px 40px rgba(11,31,58,.1);
        }

            .stat-card:hover::before {
                opacity: 1;
            }

    .stat-card--blue::before {
        background: #3b82f6;
    }

    .stat-card--green::before {
        background: var(--success);
    }

    .stat-card--purple::before {
        background: #8b5cf6;
    }

    .stat-header {
        display: flex;
        align-items: center;
        margin-bottom: 1rem;
        gap: .8rem;
    }

    .stat-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.1rem;
        flex-shrink: 0;
    }

    .stat-icon-blue {
        background: #3b82f6;
    }

    .stat-icon-green {
        background: var(--success);
    }

    .stat-icon-purple {
        background: #8b5cf6;
    }

    .stat-title {
        font-size: .72rem;
        font-weight: 600;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--slate);
    }

    .stat-value {
        font-family: 'Playfair Display', serif;
        font-size: 2rem;
        font-weight: 700;
        color: var(--navy);
        line-height: 1;
        margin-bottom: .5rem;
    }

    .stat-change {
        display: flex;
        align-items: center;
        font-size: .8rem;
        gap: .25rem;
        margin-top: .4rem;
    }

    .stat-change-positive {
        color: var(--success);
    }

    .stat-change-negative {
        color: #ef4444;
    }

    /* ── ACTION CARD ── */
    .action-card {
        background: var(--white);
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid rgba(11,31,58,.07);
        transition: transform .3s ease, box-shadow .3s ease;
        display: flex;
        flex-direction: column;
        margin-bottom: 2rem;
        max-width: 680px;
    }

        .action-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 16px 40px rgba(11,31,58,.1);
        }

    .action-header {
        padding: 1.6rem;
        border-bottom: 1px solid rgba(11,31,58,.06);
        background: var(--navy-mid);
    }

    .action-title {
        display: flex;
        align-items: center;
        gap: .75rem;
        font-family: 'Playfair Display', serif;
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--white);
        margin-bottom: .5rem;
    }

    .action-icon {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--navy);
        background: var(--gold);
        font-size: .95rem;
        flex-shrink: 0;
    }

    .action-description {
        color: var(--slate);
        line-height: 1.6;
        font-size: .9rem;
        margin-top: .6rem;
    }

    .action-content {
        padding: 1.6rem;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }

    .action-features {
        margin-bottom: 1.5rem;
    }

    .feature-item {
        display: flex;
        align-items: center;
        gap: .6rem;
        margin-bottom: .75rem;
        color: var(--muted);
        font-size: .9rem;
    }

    .feature-icon {
        color: var(--gold);
    }

    .action-footer {
        margin-top: auto;
        padding-top: 1rem;
    }

    .action-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .5rem;
        padding: .9rem 1.8rem;
        font-size: .95rem;
        font-weight: 700;
        border-radius: 8px;
        transition: all .3s ease;
        border: none;
        text-decoration: none;
        width: 100%;
        background: var(--gold);
        color: var(--navy);
        box-shadow: 0 4px 16px rgba(200,150,12,.3);
        font-family: 'DM Sans', sans-serif;
    }

        .action-button:hover {
            background: var(--gold-lt);
            transform: translateY(-2px);
            box-shadow: 0 6px 22px rgba(200,150,12,.4);
            color: var(--navy);
            text-decoration: none;
        }

    /* ── ACTIVITY ── */
    .activity-section {
        background: var(--white);
        border-radius: 16px;
        padding: 1.8rem;
        border: 1px solid rgba(11,31,58,.07);
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .section-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--navy);
        display: flex;
        align-items: center;
        gap: .5rem;
    }

        .section-title i {
            color: var(--gold);
        }

    .view-all {
        font-size: .8rem;
        font-weight: 600;
        letter-spacing: .06em;
        text-transform: uppercase;
        color: var(--gold);
        text-decoration: none;
        transition: color .2s;
    }

        .view-all:hover {
            color: var(--gold-lt);
            text-decoration: none;
        }

    .activity-list {
        display: flex;
        flex-direction: column;
        gap: .85rem;
    }

    .activity-item {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        padding: 1rem 1.2rem;
        border-radius: 8px;
        background: var(--ivory);
        border: 1px solid rgba(11,31,58,.05);
        transition: background .2s, border-color .2s;
    }

        .activity-item:hover {
            background: rgba(200,150,12,.04);
            border-color: rgba(200,150,12,.15);
        }

    .activity-icon {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: .9rem;
        color: white;
    }

    .activity-content {
        flex-grow: 1;
    }

    .activity-title {
        font-weight: 600;
        color: var(--navy);
        margin-bottom: .25rem;
        font-size: .92rem;
    }

    .activity-description {
        color: var(--muted);
        font-size: .85rem;
        margin-bottom: .5rem;
    }

    .activity-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .activity-time {
        font-size: .75rem;
        color: var(--slate);
    }

    .activity-status {
        font-size: .68rem;
        font-weight: 600;
        letter-spacing: .05em;
        text-transform: uppercase;
        padding: .25rem .7rem;
        border-radius: 999px;
    }

    .status-success {
        background: rgba(16,185,129,.1);
        color: #059669;
    }

    .status-pending {
        background: rgba(245,158,11,.1);
        color: #b45309;
    }

    .empty-activity {
        text-align: center;
        padding: 2.5rem;
        color: var(--slate);
    }

        .empty-activity i {
            font-size: 2rem;
            color: var(--gold);
            opacity: .4;
            display: block;
            margin-bottom: .8rem;
        }

    @@media (max-width: 1024px) {
        .stats-section {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 640px) {
        .stats-section {
            grid-template-columns: 1fr;
        }

        .hero-content {
            padding: 2rem 1rem;
        }

        .action-card {
            max-width: 100%;
        }
    }
</style>

<div class="dash-bleed">

    <div class="hero-section">
        <div class="hero-pattern"></div>
        <div class="hero-glow"></div>
        <div class="hero-content">
            <div class="welcome-message">
                <p class="hero-eyebrow"><span></span> Publisher Portal <span></span></p>
                <h1 class="welcome-title">
                    Welcome Back,<br><em>@User.FindFirst("FullName")?.Value</em>
                </h1>
                <p class="welcome-subtitle">
                    Your gateway to managing <span class="highlight">Tenders</span> with precision and ease.
                    Take control of your publishing activities and make informed decisions that drive success.
                </p>
            </div>
        </div>
    </div>

    <div class="dashboard-container">

        <div class="stats-section">
            <div class="stat-card stat-card--blue">
                <div class="stat-header">
                    <div class="stat-icon stat-icon-blue"><i class="fas fa-file-contract"></i></div>
                    <div class="stat-title">Active Tenders</div>
                </div>
                <div class="stat-value">@Model.ActiveTenders</div>
                <div class="stat-change stat-change-positive">
                    <i class="fas fa-arrow-up"></i> @Model.TendersChange% from last month
                </div>
            </div>

            <div class="stat-card stat-card--green">
                <div class="stat-header">
                    <div class="stat-icon stat-icon-green"><i class="fas fa-users"></i></div>
                    <div class="stat-title">Total Bidders</div>
                </div>
                <div class="stat-value">@Model.TotalBidders</div>
                <div class="stat-change stat-change-positive">
                    <i class="fas fa-arrow-up"></i> @Model.BiddersChange% from last month
                </div>
            </div>

            <div class="stat-card stat-card--purple">
                <div class="stat-header">
                    <div class="stat-icon stat-icon-purple"><i class="fas fa-chart-line"></i></div>
                    <div class="stat-title">Completion Rate</div>
                </div>
                <div class="stat-value">@Model.CompletionRate%</div>
                <div class="stat-change stat-change-positive">
                    <i class="fas fa-arrow-up"></i> @Model.CompletionRateChange% from last month
                </div>
            </div>
        </div>

        <div class="action-card">
            <div class="action-header">
                <div class="action-title">
                    <div class="action-icon"><i class="fas fa-file-contract"></i></div>
                    Tender Management
                </div>
                <p class="action-description">
                    Create, publish, and manage tenders with our comprehensive suite of tools designed for efficiency and transparency.
                </p>
            </div>
            <div class="action-content">
                <div class="action-features">
                    <div class="feature-item"><i class="fas fa-check-circle feature-icon"></i><span>Create and publish new tenders</span></div>
                    <div class="feature-item"><i class="fas fa-check-circle feature-icon"></i><span>Review and evaluate tender applications</span></div>
                    <div class="feature-item"><i class="fas fa-check-circle feature-icon"></i><span>Monitor active tender progress</span></div>
                    <div class="feature-item"><i class="fas fa-check-circle feature-icon"></i><span>Generate detailed tender reports</span></div>
                </div>
                <div class="action-footer">
                    <a asp-action="TenderPage" asp-controller="PublisherTender" asp-route-activeTab="TenderList" class="action-button">
                        <i class="fas fa-tasks"></i> Manage Tenders
                    </a>
                </div>
            </div>
        </div>

        <div class="activity-section">
            <div class="section-header">
                <h2 class="section-title"><i class="fas fa-clock"></i> Recent Activity</h2>
                <a href="#" class="view-all">View All</a>
            </div>
            <div class="activity-list">
                @if (Model.RecentActivities.Any())
                {
                    @foreach (var activity in Model.RecentActivities)
                    {
                        <div class="activity-item">
                            <div class="activity-icon stat-icon-blue">
                                <i class="@activity.IconClass"></i>
                            </div>
                            <div class="activity-content">
                                <div class="activity-title">@activity.Title</div>
                                <p class="activity-description">@activity.Description</p>
                                <div class="activity-meta">
                                    <span class="activity-time">@activity.GetTimeDisplay()</span>
                                    <span class="activity-status @activity.GetStatusClass()">@activity.Status</span>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-activity">
                        <i class="fas fa-inbox"></i>
                        <p>No recent activities to display.</p>
                    </div>
                }
            </div>
        </div>

    </div>
</div>
