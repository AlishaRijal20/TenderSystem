@model MonitorTenderViewModel

<link href="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.2.1/flowbite.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

<style>
    :root {
        --navy: #0B1F3A;
        --navy-mid: #122848;
        --gold: #C8960C;
        --gold-lt: #E8B84B;
        --ivory: #F7F3EC;
        --slate: #8A9BB5;
        --white: #ffffff;
        --muted: #5a6a80;
    }

    .mt-wrap {
        font-family: 'DM Sans', sans-serif;
        padding-bottom: 4rem;
    }

    /* ── HERO ── */
    .mt-hero {
        background: var(--navy);
        position: relative;
        overflow: hidden;
        padding: 2.8rem 2rem 4.5rem;
    }

        .mt-hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(200,150,12,.05) 1px, transparent 1px), linear-gradient(90deg, rgba(200,150,12,.05) 1px, transparent 1px);
            background-size: 40px 40px;
            pointer-events: none;
        }

        .mt-hero::after {
            content: '';
            position: absolute;
            top: -40%;
            right: -5%;
            width: 460px;
            height: 460px;
            background: radial-gradient(circle, rgba(200,150,12,.14) 0%, transparent 65%);
            pointer-events: none;
        }

    .mt-hero-inner {
        position: relative;
        z-index: 2;
        max-width: 1200px;
        margin: 0 auto;
    }

    .mt-back {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        color: var(--slate);
        font-size: .82rem;
        font-weight: 600;
        text-decoration: none;
        margin-bottom: 1.6rem;
        transition: color .2s, transform .2s;
    }

        .mt-back:hover {
            color: var(--gold-lt);
            transform: translateX(-3px);
            text-decoration: none;
        }

    .mt-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        font-size: .65rem;
        font-weight: 500;
        letter-spacing: .2em;
        text-transform: uppercase;
        color: var(--gold);
        margin-bottom: .5rem;
    }

        .mt-eyebrow span {
            display: inline-block;
            width: 18px;
            height: 1px;
            background: var(--gold);
        }

    .mt-hero h1 {
        font-family: 'Playfair Display', serif;
        font-size: clamp(1.4rem, 3vw, 2rem);
        font-weight: 900;
        color: var(--white);
        margin: 0 0 1rem;
        line-height: 1.2;
    }

    .mt-hero-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 1.4rem;
    }

    .mt-meta-item {
        display: flex;
        align-items: center;
        gap: .4rem;
        font-size: .82rem;
        color: var(--slate);
    }

        .mt-meta-item i {
            color: var(--gold);
            font-size: .78rem;
        }

        .mt-meta-item strong {
            color: var(--white);
            font-weight: 600;
        }

    /* ── BODY ── */
    .mt-body {
        max-width: 1200px;
        margin: -2rem auto 0;
        padding: 0 1.5rem;
        position: relative;
        z-index: 2;
    }

    /* ── TENDER INFO CARD ── */
    .mt-info-card {
        background: var(--white);
        border-radius: 16px;
        box-shadow: 0 12px 48px rgba(11,31,58,.12);
        overflow: hidden;
        margin-bottom: 1.6rem;
    }

    .mt-card-hd {
        background: var(--navy);
        padding: 1rem 1.5rem;
        display: flex;
        align-items: center;
        gap: .65rem;
    }

    .mt-card-hd-icon {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        background: rgba(200,150,12,.15);
        color: var(--gold);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .85rem;
        flex-shrink: 0;
    }

    .mt-card-hd h2 {
        font-family: 'Playfair Display', serif;
        font-size: .95rem;
        font-weight: 700;
        color: var(--white);
        margin: 0;
    }

    .mt-info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: .75rem;
        padding: 1.4rem;
    }

    .mt-info-item {
        display: flex;
        align-items: flex-start;
        gap: .75rem;
        padding: .85rem 1rem;
        background: var(--ivory);
        border-radius: 10px;
        border: 1px solid rgba(11,31,58,.05);
        transition: background .2s, transform .2s;
    }

        .mt-info-item:hover {
            background: rgba(200,150,12,.06);
            transform: translateX(3px);
        }

    .mt-info-icon {
        width: 32px;
        height: 32px;
        border-radius: 7px;
        background: rgba(200,150,12,.12);
        color: var(--gold);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .8rem;
        flex-shrink: 0;
        margin-top: .05rem;
    }

    .mt-info-label {
        font-size: .68rem;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--slate);
        margin-bottom: .2rem;
    }

    .mt-info-value {
        font-size: .88rem;
        font-weight: 600;
        color: var(--navy);
    }

        .mt-info-value.gold {
            color: var(--gold);
            font-family: 'Playfair Display', serif;
        }

    /* ── APPLICATIONS CARD ── */
    .mt-apps-card {
        background: var(--white);
        border-radius: 16px;
        box-shadow: 0 12px 48px rgba(11,31,58,.12);
        overflow: hidden;
    }

    .mt-apps-hd {
        background: var(--navy);
        padding: 1rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: .75rem;
    }

    .mt-apps-hd-left {
        display: flex;
        align-items: center;
        gap: .65rem;
    }

    .mt-apps-hd h2 {
        font-family: 'Playfair Display', serif;
        font-size: .95rem;
        font-weight: 700;
        color: var(--white);
        margin: 0;
    }

    .mt-count-pill {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .3rem .85rem;
        border-radius: 999px;
        background: rgba(200,150,12,.15);
        color: var(--gold-lt);
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .04em;
        border: 1px solid rgba(200,150,12,.2);
    }

    /* ── TABLE ── */
    .mt-table-wrap {
        overflow-x: auto;
    }

    .mt-table {
        width: 100%;
        border-collapse: collapse;
    }

        .mt-table thead tr {
            background: var(--ivory);
            border-bottom: 2px solid rgba(11,31,58,.07);
        }

        .mt-table th {
            padding: .9rem 1.2rem;
            font-size: .68rem;
            font-weight: 700;
            letter-spacing: .1em;
            text-transform: uppercase;
            color: var(--slate);
            text-align: left;
            white-space: nowrap;
        }

            .mt-table th:last-child {
                text-align: right;
            }

        .mt-table tbody tr {
            border-bottom: 1px solid rgba(11,31,58,.05);
            transition: background .15s;
        }

            .mt-table tbody tr:last-child {
                border-bottom: none;
            }

            .mt-table tbody tr:hover {
                background: rgba(200,150,12,.03);
            }

        .mt-table td {
            padding: 1rem 1.2rem;
            font-size: .85rem;
            color: var(--navy);
            vertical-align: middle;
        }

            .mt-table td:last-child {
                text-align: right;
            }

    /* app id chip */
    .mt-app-id {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        background: rgba(11,31,58,.06);
        color: var(--navy);
        font-weight: 700;
        font-size: .78rem;
        padding: .22rem .65rem;
        border-radius: 6px;
    }

        .mt-app-id i {
            color: var(--gold);
            font-size: .65rem;
        }

    /* company name */
    .mt-company-name {
        font-weight: 700;
        color: var(--navy);
        font-size: .88rem;
    }

    /* budget */
    .mt-budget {
        font-family: 'Playfair Display', serif;
        font-weight: 700;
        color: var(--gold);
        font-size: .88rem;
    }

    /* duration */
    .mt-duration {
        color: var(--muted);
        font-size: .84rem;
    }

    /* status pills */
    .mt-status {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .28rem .85rem;
        border-radius: 999px;
        font-size: .7rem;
        font-weight: 700;
        letter-spacing: .05em;
        text-transform: uppercase;
    }

    .st-won {
        background: #dcfce7;
        color: #166534;
    }

    .st-lost {
        background: #fee2e2;
        color: #991b1b;
    }

    .st-pending {
        background: #fef3c7;
        color: #92400e;
    }

    /* action buttons */
    .mt-action-wrap {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: .5rem;
    }

    .mt-btn-view {
        width: 32px;
        height: 32px;
        border-radius: 7px;
        background: rgba(11,31,58,.06);
        color: var(--navy);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: .8rem;
        text-decoration: none;
        transition: background .2s, transform .2s;
    }

        .mt-btn-view:hover {
            background: var(--navy);
            color: var(--gold);
            transform: translateY(-1px);
            text-decoration: none;
        }

    /* award dropdown */
    .mt-award-wrap {
        position: relative;
        display: inline-block;
    }

    .mt-btn-award {
        width: 32px;
        height: 32px;
        border-radius: 7px;
        background: rgba(200,150,12,.1);
        color: var(--gold);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: .8rem;
        cursor: pointer;
        border: none;
        transition: background .2s, transform .2s;
    }

        .mt-btn-award:hover {
            background: var(--gold);
            color: var(--navy);
            transform: translateY(-1px);
        }

    .mt-dropdown {
        display: none;
        position: absolute;
        right: 0;
        top: calc(100% + 6px);
        background: var(--white);
        border-radius: 10px;
        box-shadow: 0 8px 28px rgba(11,31,58,.15);
        border: 1px solid rgba(11,31,58,.08);
        overflow: hidden;
        min-width: 130px;
        z-index: 20;
    }

        .mt-dropdown.open {
            display: block;
        }

    .mt-drop-btn {
        display: flex;
        align-items: center;
        gap: .6rem;
        width: 100%;
        padding: .7rem 1rem;
        font-size: .82rem;
        font-weight: 600;
        background: none;
        border: none;
        cursor: pointer;
        text-align: left;
        transition: background .15s;
    }

        .mt-drop-btn.won {
            color: #166534;
        }

            .mt-drop-btn.won:hover {
                background: #dcfce7;
            }

        .mt-drop-btn.lost {
            color: #991b1b;
        }

            .mt-drop-btn.lost:hover {
                background: #fee2e2;
            }

    /* ── EMPTY STATE ── */
    .mt-empty {
        text-align: center;
        padding: 4rem 2rem;
        margin: 1.5rem;
        background: var(--ivory);
        border-radius: 12px;
        border: 2px dashed rgba(200,150,12,.2);
    }

    .mt-empty-icon {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: rgba(200,150,12,.1);
        color: var(--gold);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        margin: 0 auto 1.2rem;
    }

    .mt-empty h3 {
        font-family: 'Playfair Display', serif;
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--navy);
        margin-bottom: .5rem;
    }

    .mt-empty p {
        font-size: .85rem;
        color: var(--muted);
        max-width: 380px;
        margin: 0 auto;
        line-height: 1.6;
    }

    @@media (max-width: 768px) {
        .mt-hero {
            padding: 2rem 1.2rem 4rem;
        }

        .mt-body {
            padding: 0 .75rem;
        }

        .mt-info-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="mt-wrap">

    <!-- ── HERO ── -->
    <div class="mt-hero">
        <div class="mt-hero-inner">
            <a asp-action="TenderDetails" asp-controller="PublisherTender" asp-route-id="@Model.Tender.EncId" class="mt-back">
                <i class="fas fa-arrow-left"></i> Back to Tender
            </a>
            <p class="mt-eyebrow"><span></span> Tender Monitor</p>
            <h1>@Model.Tender.Title</h1>
            <div class="mt-hero-meta">
                <div class="mt-meta-item">
                    <i class="fas fa-hashtag"></i>
                    <span>ID: <strong>#@Model.Tender.TenderId</strong></span>
                </div>
                <div class="mt-meta-item">
                    <i class="fas fa-calendar-alt"></i>
                    <span>Posted: <strong>@Model.Tender.IssuedDate.ToString("MMM dd, yyyy")</strong></span>
                </div>
                <div class="mt-meta-item">
                    <i class="fas fa-building"></i>
                    <span>Issued by: <strong>@Model.Tender.IssuedBy</strong></span>
                </div>
            </div>
        </div>
    </div>

    <!-- ── BODY ── -->
    <div class="mt-body">

        <!-- Tender Info Card -->
        <div class="mt-info-card">
            <div class="mt-card-hd">
                <div class="mt-card-hd-icon"><i class="fas fa-clipboard-list"></i></div>
                <h2>Tender Overview</h2>
            </div>
            <div class="mt-info-grid">
                <div class="mt-info-item">
                    <div class="mt-info-icon"><i class="fas fa-building"></i></div>
                    <div>
                        <div class="mt-info-label">Issued By</div>
                        <div class="mt-info-value">@Model.Tender.IssuedBy</div>
                    </div>
                </div>
                <div class="mt-info-item">
                    <div class="mt-info-icon"><i class="fas fa-tag"></i></div>
                    <div>
                        <div class="mt-info-label">Type</div>
                        <div class="mt-info-value">@Model.Tender.TenderType</div>
                    </div>
                </div>
                <div class="mt-info-item">
                    <div class="mt-info-icon"><i class="fas fa-hourglass-half"></i></div>
                    <div>
                        <div class="mt-info-label">Duration</div>
                        <div class="mt-info-value">@Model.Tender.ProjectDuration</div>
                    </div>
                </div>
                <div class="mt-info-item">
                    <div class="mt-info-icon"><i class="fas fa-rupee-sign"></i></div>
                    <div>
                        <div class="mt-info-label">Budget Estimation</div>
                        <div class="mt-info-value gold">&#8377; @Model.Tender.BudgetEstimation.ToString("N2")</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Applications Card -->
        <div class="mt-apps-card">
            <div class="mt-apps-hd">
                <div class="mt-apps-hd-left">
                    <div class="mt-card-hd-icon"><i class="fas fa-file-signature"></i></div>
                    <h2>Tender Applications</h2>
                </div>
                <span class="mt-count-pill">
                    <i class="fas fa-users"></i>
                    @(Model.Applications?.Count() ?? 0) Applications
                </span>
            </div>

            @if (Model.Applications == null || !Model.Applications.Any())
            {
                <div class="mt-empty">
                    <div class="mt-empty-icon"><i class="fas fa-folder-open"></i></div>
                    <h3>No Applications Yet</h3>
                    <p>There are currently no applications submitted for this tender. They will appear here once companies start applying.</p>
                </div>
            }
            else
            {
                <div class="mt-table-wrap">
                    <table class="mt-table">
                        <thead>
                            <tr>
                                <th>App ID</th>
                                <th>Company</th>
                                <th>Proposed Budget</th>
                                <th>Duration</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var app in Model.Applications)
                            {
                                <tr>
                                    <td>
                                        <span class="mt-app-id">
                                            <i class="fas fa-hashtag"></i>@app.Application.ApplicationId
                                        </span>
                                    </td>
                                    <td>
                                        <div class="mt-company-name">@app.Company.CompanyName</div>
                                    </td>
                                    <td>
                                        <div class="mt-budget">&#8377; @app.Application.ProposedBudget.ToString("N2")</div>
                                    </td>
                                    <td>
                                        <div class="mt-duration">@app.Application.ProposedDuration</div>
                                    </td>
                                    <td>
                                        <span class="mt-status @(app.Application.ApplicationStatus.ToLower() == "won" ? "st-won" :
                                                                                                                app.Application.ApplicationStatus.ToLower() == "lost" ? "st-lost" : "st-pending")">
                                    <i class="fas @(app.Application.ApplicationStatus.ToLower() == "won" ? "fa-trophy" :
                                                                                                  app.Application.ApplicationStatus.ToLower() == "lost" ? "fa-times-circle" : "fa-hourglass-half")"></i>
                                    @app.Application.ApplicationStatus
                                </span>
                            </td>
                            <td>
                                <div class="mt-action-wrap">
                                    <a asp-action="ApplicationDetails" asp-controller="PublisherTender"
                                       asp-route-id="@app.Application.EncId"
                                       class="mt-btn-view" title="View Details">
                                        <i class="fas fa-eye"></i>
                                    </a>

                                    @if (app.Application.ApplicationStatus == "Pending")
                                            {
                                                <div class="mt-award-wrap">
                                                    <button class="mt-btn-award award-dropdown-btn" title="Award">
                                                        <i class="fas fa-trophy"></i>
                                                    </button>
                                                    <div class="mt-dropdown">
                                                        <button class="mt-drop-btn won" data-id="@app.Application.ApplicationId" data-status="Won">
                                                            <i class="fas fa-trophy"></i> Won
                                                        </button>
                                                        <button class="mt-drop-btn lost" data-id="@app.Application.ApplicationId" data-status="Lost">
                                                            <i class="fas fa-times-circle"></i> Lost
                                                        </button>
                                                    </div>
                                                </div>

                                                <form id="awardForm_@app.Application.ApplicationId" class="hidden" method="POST"
                                                      asp-action="AwardTender" asp-controller="PublisherTender">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="ApplicationId" value="@app.Application.ApplicationId" />
                                                    <input type="hidden" name="ApplicationStatus" />
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

    </div><!-- /mt-body -->
</div><!-- /mt-wrap -->

<script src="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.2.1/flowbite.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {

        // Toggle award dropdown
        document.querySelectorAll('.award-dropdown-btn').forEach(btn => {
            btn.addEventListener('click', function (e) {
                e.stopPropagation();
                const dd = this.nextElementSibling;
                // Close all others
                document.querySelectorAll('.mt-dropdown').forEach(d => {
                    if (d !== dd) d.classList.remove('open');
                });
                dd.classList.toggle('open');
            });
        });

        // Close on outside click
        document.addEventListener('click', function () {
            document.querySelectorAll('.mt-dropdown').forEach(d => d.classList.remove('open'));
        });

        // Award action
        document.querySelectorAll('.mt-drop-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                const applicationId = this.getAttribute('data-id');
                const applicationStatus = this.getAttribute('data-status');
                const form = document.getElementById(`awardForm_${applicationId}`);
                const formData = new FormData(form);
                formData.set('ApplicationStatus', applicationStatus);

                if (confirm(`Mark this application as '${applicationStatus}'?`)) {
                    fetch(form.action, {
                        method: form.method,
                        body: formData,
                        headers: {
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                        }
                    })
                    .then(r => r.json())
                    .then(data => {
                        if (data.success) {
                            alert(data.message);
                            window.location.href = data.redirectUrl;
                        } else {
                            alert('Failed to update award status.');
                        }
                    })
                    .catch(err => console.error('Error:', err));
                }
            });
        });
    });
</script>
