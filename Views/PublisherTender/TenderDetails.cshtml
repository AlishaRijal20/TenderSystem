@model TenderEdit

<link href="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.2.1/flowbite.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.min.js"></script>

<style>
    :root {
        --navy: #0B1F3A;
        --navy-mid: #122848;
        --gold: #C8960C;
        --gold-lt: #E8B84B;
        --ivory: #F7F3EC;
        --slate: #8A9BB5;
        --white: #ffffff;
        --muted: #5a6a80;
    }

    .tdp-wrap {
        font-family: 'DM Sans', sans-serif;
        background: var(--ivory);
        min-height: 100vh;
        padding-bottom: 3rem;
    }

    /* ── HERO HEADER ── */
    .tdp-hero {
        background: var(--navy);
        position: relative;
        overflow: hidden;
        padding: 0 2rem;
    }

        .tdp-hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(200,150,12,.05) 1px, transparent 1px), linear-gradient(90deg, rgba(200,150,12,.05) 1px, transparent 1px);
            background-size: 40px 40px;
            pointer-events: none;
        }

        .tdp-hero::after {
            content: '';
            position: absolute;
            top: -40%;
            right: -5%;
            width: 420px;
            height: 420px;
            background: radial-gradient(circle, rgba(200,150,12,.15) 0%, transparent 65%);
            pointer-events: none;
        }

    /* top bar */
    .tdp-topbar {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.2rem 0;
        flex-wrap: wrap;
        gap: .75rem;
    }

    .tdp-back {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        color: var(--slate);
        font-size: .85rem;
        font-weight: 500;
        text-decoration: none;
        transition: color .2s, transform .2s;
    }

        .tdp-back:hover {
            color: var(--gold-lt);
            transform: translateX(-2px);
            text-decoration: none;
        }

    .tdp-badges {
        display: flex;
        gap: .6rem;
        flex-wrap: wrap;
    }

    .tdp-badge {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .3rem .85rem;
        border-radius: 6px;
        font-size: .7rem;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
    }

    .tdp-badge-dot {
        width: 18px;
        height: 18px;
        border-radius: 50%;
        background: rgba(255,255,255,.2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .6rem;
    }

    .b-open {
        background: linear-gradient(135deg,#10b981,#059669);
        color: #fff;
    }

    .b-closed {
        background: linear-gradient(135deg,#ef4444,#dc2626);
        color: #fff;
    }

    .b-awarded {
        background: linear-gradient(135deg,#fbbf24,#f59e0b);
        color: #fff;
    }

    .b-pending {
        background: linear-gradient(135deg,#f59e0b,#d97706);
        color: #fff;
    }

    .b-verified {
        background: linear-gradient(135deg,#3b82f6,#2563eb);
        color: #fff;
    }

    .b-notver {
        background: linear-gradient(135deg,#6b7280,#4b5563);
        color: #fff;
    }

    .b-verpend {
        background: linear-gradient(135deg,#f59e0b,#d97706);
        color: #fff;
    }

    /* title block */
    .tdp-title-block {
        position: relative;
        z-index: 2;
        padding: 1.4rem 0 2.8rem;
    }

    .tdp-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        font-size: .65rem;
        font-weight: 500;
        letter-spacing: .2em;
        text-transform: uppercase;
        color: var(--gold);
        margin-bottom: .5rem;
    }

        .tdp-eyebrow span {
            display: inline-block;
            width: 18px;
            height: 1px;
            background: var(--gold);
        }

    .tdp-title-block h1 {
        font-family: 'Playfair Display', serif;
        font-size: clamp(1.3rem, 3vw, 1.9rem);
        font-weight: 900;
        color: var(--white);
        margin: 0 0 1rem;
        line-height: 1.2;
        max-width: 700px;
    }

    .tdp-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 1.2rem;
    }

    .tdp-meta-item {
        display: flex;
        align-items: center;
        gap: .4rem;
        font-size: .8rem;
        color: var(--slate);
    }

        .tdp-meta-item i {
            color: var(--gold);
            font-size: .78rem;
        }

        .tdp-meta-item strong {
            color: var(--white);
            font-weight: 600;
        }

    /* ── CONTENT AREA ── */
    .tdp-body {
        max-width: 1100px;
        margin: -1.5rem auto 0;
        padding: 0 1.5rem;
        position: relative;
        z-index: 2;
    }

    /* white card wrapper for tabs */
    .tdp-card {
        background: var(--white);
        border-radius: 16px;
        box-shadow: 0 12px 48px rgba(11,31,58,.12);
        overflow: hidden;
    }

    /* ── TAB BAR ── */
    .tdp-tab-bar {
        display: flex;
        align-items: stretch;
        justify-content: space-between;
        border-bottom: 1px solid rgba(11,31,58,.08);
        padding: 0 1.5rem;
        background: var(--white);
    }

    .tdp-tab-nav {
        display: flex;
        gap: .25rem;
    }

    .tab-btn {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: 1rem 1.1rem;
        font-size: .83rem;
        font-weight: 600;
        color: var(--muted);
        background: none;
        border: none;
        border-bottom: 2px solid transparent;
        cursor: pointer;
        position: relative;
        top: 1px;
        transition: color .2s, border-color .2s;
        font-family: 'DM Sans', sans-serif;
    }

        .tab-btn:hover {
            color: var(--navy);
        }

        .tab-btn.active {
            color: var(--navy);
            border-bottom-color: var(--gold);
        }

    .tdp-monitor-btn {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: .5rem 1.1rem;
        border-radius: 7px;
        background: var(--gold);
        color: var(--navy);
        font-size: .8rem;
        font-weight: 700;
        text-decoration: none;
        align-self: center;
        transition: background .2s, transform .2s, box-shadow .2s;
        box-shadow: 0 3px 12px rgba(200,150,12,.3);
    }

        .tdp-monitor-btn:hover {
            background: var(--gold-lt);
            transform: translateY(-1px);
            box-shadow: 0 5px 16px rgba(200,150,12,.4);
            text-decoration: none;
            color: var(--navy);
        }

    /* ── TAB CONTENT ── */
    .tab-content {
        display: none;
        opacity: 0;
        transition: opacity .3s ease;
    }

        .tab-content.active {
            display: block;
            opacity: 1;
        }

    .tdp-content {
        padding: 2rem;
    }

    /* ── SECTIONS ── */
    .tdp-section {
        background: var(--white);
        border-radius: 12px;
        border: 1px solid rgba(11,31,58,.07);
        overflow: hidden;
        margin-bottom: 1.4rem;
        box-shadow: 0 2px 12px rgba(11,31,58,.05);
        transition: box-shadow .3s, transform .3s;
    }

        .tdp-section:hover {
            box-shadow: 0 8px 30px rgba(11,31,58,.1);
            transform: translateY(-2px);
        }

    .tdp-section-hd {
        padding: 1rem 1.5rem;
        background: var(--navy);
        display: flex;
        align-items: center;
        gap: .65rem;
    }

        .tdp-section-hd i {
            color: var(--gold);
            font-size: .9rem;
        }

        .tdp-section-hd h2,
        .tdp-section-hd h3 {
            font-family: 'Playfair Display', serif;
            font-size: .95rem;
            font-weight: 700;
            color: var(--white);
            margin: 0;
        }

    .tdp-section-body {
        padding: 1.4rem 1.5rem;
    }

    .tdp-intro {
        font-size: .9rem;
        color: var(--muted);
        margin-bottom: 1.2rem;
        line-height: 1.6;
    }

    /* detail grid */
    .tdp-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: .75rem;
    }

    .tdp-item {
        display: flex;
        align-items: flex-start;
        gap: .75rem;
        padding: .8rem 1rem;
        background: var(--ivory);
        border-radius: 8px;
        border: 1px solid rgba(11,31,58,.05);
        transition: background .2s, transform .2s;
    }

        .tdp-item:hover {
            background: rgba(200,150,12,.05);
            transform: translateX(4px);
        }

    .tdp-item-icon {
        width: 32px;
        height: 32px;
        border-radius: 7px;
        background: rgba(200,150,12,.12);
        color: var(--gold);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .8rem;
        flex-shrink: 0;
        margin-top: .05rem;
    }

    .tdp-item-label {
        font-size: .68rem;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--slate);
        margin-bottom: .2rem;
    }

    .tdp-item-value {
        font-size: .88rem;
        font-weight: 600;
        color: var(--navy);
        line-height: 1.4;
    }

    /* awarded company sub-section */
    .tdp-company-block {
        margin-top: 1.4rem;
        padding-top: 1.4rem;
        border-top: 1px solid rgba(11,31,58,.07);
    }

    .tdp-company-title {
        font-family: 'Playfair Display', serif;
        font-size: .92rem;
        font-weight: 700;
        color: var(--navy);
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: .5rem;
    }

        .tdp-company-title i {
            color: var(--gold);
        }

    .tdp-profile-btn {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .5rem 1.1rem;
        border-radius: 7px;
        background: var(--navy);
        color: var(--white);
        font-size: .8rem;
        font-weight: 600;
        text-decoration: none;
        margin-top: 1rem;
        transition: background .2s, transform .2s;
    }

        .tdp-profile-btn:hover {
            background: var(--navy-mid);
            transform: translateY(-1px);
            color: var(--white);
            text-decoration: none;
        }

    /* ── TIMELINE ── */
    .tdp-timeline {
        position: relative;
        padding-left: 2.5rem;
    }

        .tdp-timeline::before {
            content: '';
            position: absolute;
            left: .9rem;
            top: 0;
            bottom: 0;
            width: 2px;
            background: linear-gradient(to bottom, var(--gold), rgba(200,150,12,.1));
            border-radius: 2px;
        }

    .tdp-tl-item {
        position: relative;
        padding: 1rem 1.2rem;
        background: var(--ivory);
        border-radius: 8px;
        margin-bottom: 1rem;
        transition: transform .2s, box-shadow .2s;
    }

        .tdp-tl-item:last-child {
            margin-bottom: 0;
        }

        .tdp-tl-item:hover {
            transform: translateX(4px);
            box-shadow: 0 4px 14px rgba(11,31,58,.08);
        }

    .tdp-tl-dot {
        position: absolute;
        left: -2.05rem;
        top: 50%;
        transform: translateY(-50%);
        width: 28px;
        height: 28px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .7rem;
        color: var(--white);
    }

    .dot-navy {
        background: var(--navy);
    }

    .dot-green {
        background: #10b981;
    }

    .dot-red {
        background: #ef4444;
    }

    .tdp-tl-label {
        font-size: .68rem;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--slate);
        margin-bottom: .25rem;
    }

    .tdp-tl-date {
        font-family: 'Playfair Display', serif;
        font-size: .95rem;
        font-weight: 700;
        color: var(--navy);
        display: flex;
        align-items: center;
        gap: .4rem;
    }

        .tdp-tl-date i {
            color: var(--gold);
            font-size: .8rem;
        }

    /* ── DOCUMENTS TAB ── */
    .tdp-doc-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.4rem;
        flex-wrap: wrap;
        gap: .75rem;
    }

    .tdp-doc-title {
        font-family: 'Playfair Display', serif;
        font-size: 1rem;
        font-weight: 700;
        color: var(--navy);
        display: flex;
        align-items: center;
        gap: .5rem;
    }

        .tdp-doc-title i {
            color: var(--gold);
        }

    .tdp-dl-btn {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: .6rem 1.2rem;
        border-radius: 7px;
        background: var(--navy);
        color: var(--white);
        font-size: .82rem;
        font-weight: 700;
        text-decoration: none;
        transition: background .2s, transform .2s, box-shadow .2s;
        box-shadow: 0 3px 12px rgba(11,31,58,.2);
    }

        .tdp-dl-btn:hover {
            background: var(--navy-mid);
            transform: translateY(-1px);
            box-shadow: 0 5px 18px rgba(11,31,58,.25);
            color: var(--white);
            text-decoration: none;
        }

        .tdp-dl-btn i {
            color: var(--gold-lt);
        }

    .tdp-doc-meta {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.2rem;
        background: var(--white);
        border-radius: 10px;
        border: 1px solid rgba(11,31,58,.07);
        margin-bottom: 1.2rem;
        box-shadow: 0 2px 8px rgba(11,31,58,.04);
    }

        .tdp-doc-meta i {
            color: #ef4444;
            font-size: 1.5rem;
        }

    .tdp-doc-name {
        font-weight: 600;
        color: var(--navy);
        font-size: .88rem;
    }

    .tdp-doc-hint {
        font-size: .78rem;
        color: var(--slate);
        margin-top: .15rem;
    }

    .pdf-viewer {
        height: 800px;
        border-radius: 10px;
        overflow-y: auto;
        background: #f8fafc;
        border: 1px solid rgba(11,31,58,.08);
        box-shadow: inset 0 2px 4px rgba(0,0,0,.04);
    }

        .pdf-viewer::-webkit-scrollbar {
            width: 6px;
        }

        .pdf-viewer::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 3px;
        }

        .pdf-viewer::-webkit-scrollbar-thumb {
            background: rgba(200,150,12,.3);
            border-radius: 3px;
        }

            .pdf-viewer::-webkit-scrollbar-thumb:hover {
                background: var(--gold);
            }

    @@media (max-width: 768px) {
        .tdp-hero {
            padding: 0 1rem;
        }

        .tdp-body {
            padding: 0 .75rem;
        }

        .tdp-content {
            padding: 1.2rem;
        }

        .tdp-grid {
            grid-template-columns: 1fr;
        }

        .tdp-tab-bar {
            padding: 0 .75rem;
        }
    }
</style>

<div class="tdp-wrap" data-status="@Model.TenderStatus.ToLower()" data-verified="@Model.IsVerified.ToLower()">

    <!-- ── HERO ── -->
    <div class="tdp-hero">
        <div class="tdp-topbar">
            <a asp-action="TenderPage" asp-controller="PublisherTender" asp-route-activeTab="TenderList" class="tdp-back">
                <i class="fas fa-arrow-left"></i> Back to Tenders
            </a>
            <div class="tdp-badges">
                <span class="tdp-badge
                    @(Model.TenderStatus.ToLower() == "open" ? "b-open" :
                                            Model.TenderStatus.ToLower() == "closed" ? "b-closed" :
                                            Model.TenderStatus.ToLower() == "awarded" ? "b-awarded" : "b-pending")">
                    <span class="tdp-badge-dot">
                        <i class="fas @(Model.TenderStatus.ToLower() == "open"    ? "fa-door-open" :
                                                                   Model.TenderStatus.ToLower() == "closed" ? "fa-lock" :
                                                                   Model.TenderStatus.ToLower() == "awarded" ? "fa-trophy" : "fa-clock")"></i>
                    </span>
                    @Model.TenderStatus
                </span>
                <span class="tdp-badge
                    @(Model.IsVerified == "Verified" ? "b-verified" :
                                            Model.IsVerified == "Not Verified" ? "b-notver" : "b-verpend")">
                    <span class="tdp-badge-dot">
                        <i class="fas @(Model.IsVerified == "Verified"     ? "fa-shield-alt"   :
                                                                   Model.IsVerified == "Not Verified" ? "fa-times-circle" : "fa-spinner fa-spin")"></i>
                    </span>
                    @Model.IsVerified
                </span>
            </div>
        </div>

        <div class="tdp-title-block">
            <p class="tdp-eyebrow"><span></span> Tender Details</p>
            <h1>@Model.Title</h1>
            <div class="tdp-meta">
                <div class="tdp-meta-item">
                    <i class="fas fa-hashtag"></i>
                    <span>ID: <strong>#@Model.TenderId</strong></span>
                </div>
                <div class="tdp-meta-item">
                    <i class="fas fa-calendar-alt"></i>
                    <span>Posted: <strong>@Model.IssuedDate.ToString("MMM dd, yyyy")</strong></span>
                </div>
                <div class="tdp-meta-item">
                    <i class="fas fa-building"></i>
                    <span>Issued by: <strong>@Model.IssuedBy</strong></span>
                </div>
            </div>
        </div>
    </div>

    <!-- ── CARD + TABS ── -->
    <div class="tdp-body">
        <div class="tdp-card">

            <div class="tdp-tab-bar">
                <div class="tdp-tab-nav">
                    <button onclick="showTab('details')" class="tab-btn active">
                        <i class="fas fa-info-circle"></i> Details
                    </button>
                    <button onclick="showTab('documents')" class="tab-btn">
                        <i class="fas fa-file-alt"></i> Documents
                    </button>
                </div>
                @if (Model.TenderStatus == "Closed")
                {
                    <a asp-action="MonitorTender" asp-controller="PublisherTender" asp-route-id="@Model.EncId"
                       class="tdp-monitor-btn">
                        <i class="fas fa-bell"></i> Monitor Now
                    </a>
                }
            </div>

            <div class="tdp-content">

                <!-- ── DETAILS TAB ── -->
                <div id="details-tab" class="tab-content active">

                    <!-- Summary -->
                    <div class="tdp-section">
                        <div class="tdp-section-hd">
                            <i class="fas fa-clipboard-list"></i><h2>Tender Summary</h2>
                        </div>
                        <div class="tdp-section-body">
                            <p class="tdp-intro">@Model.Title</p>
                            <div class="tdp-grid">
                                <div class="tdp-item">
                                    <div class="tdp-item-icon"><i class="fas fa-tag"></i></div>
                                    <div><div class="tdp-item-label">Type</div><div class="tdp-item-value">@Model.TenderType</div></div>
                                </div>
                                <div class="tdp-item">
                                    <div class="tdp-item-icon"><i class="fas fa-hourglass-half"></i></div>
                                    <div><div class="tdp-item-label">Duration</div><div class="tdp-item-value">@Model.ProjectDuration</div></div>
                                </div>
                                <div class="tdp-item">
                                    <div class="tdp-item-icon"><i class="fas fa-rupee-sign"></i></div>
                                    <div><div class="tdp-item-label">Budget</div><div class="tdp-item-value">&#8377; @Model.BudgetEstimation.ToString("N2")</div></div>
                                </div>
                                <div class="tdp-item">
                                    <div class="tdp-item-icon"><i class="fas fa-user-tie"></i></div>
                                    <div><div class="tdp-item-label">Issued By</div><div class="tdp-item-value">@Model.IssuedBy</div></div>
                                </div>
                                <div class="tdp-item" style="grid-column:1/-1;">
                                    <div class="tdp-item-icon"><i class="fas fa-align-left"></i></div>
                                    <div>
                                        <div class="tdp-item-label">Description</div>
                                        <div class="tdp-item-value" style="font-weight:400;color:var(--muted);">@Model.TenderDescription</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Financial Details -->
                    <div class="tdp-section">
                        <div class="tdp-section-hd">
                            <i class="fas fa-coins"></i><h2>Financial Details</h2>
                        </div>
                        <div class="tdp-section-body">
                            <div class="tdp-grid">
                                <div class="tdp-item">
                                    <div class="tdp-item-icon"><i class="fas fa-rupee-sign"></i></div>
                                    <div><div class="tdp-item-label">Budget Estimation</div><div class="tdp-item-value">&#8377; @Model.BudgetEstimation.ToString("N2")</div></div>
                                </div>
                            </div>

                            @if (Model.AwardedCompany != null)
                            {
                                <div class="tdp-company-block">
                                    <h3 class="tdp-company-title"><i class="fas fa-building"></i> Awarded Company Details</h3>
                                    <div class="tdp-grid">
                                        <div class="tdp-item">
                                            <div class="tdp-item-icon"><i class="fas fa-building"></i></div>
                                            <div><div class="tdp-item-label">Company Name</div><div class="tdp-item-value">@Model.AwardedCompany.CompanyName</div></div>
                                        </div>
                                        <div class="tdp-item">
                                            <div class="tdp-item-icon"><i class="fas fa-map-marker-alt"></i></div>
                                            <div><div class="tdp-item-label">Address</div><div class="tdp-item-value">@Model.AwardedCompany.FullAddress</div></div>
                                        </div>
                                        <div class="tdp-item">
                                            <div class="tdp-item-icon"><i class="fas fa-envelope"></i></div>
                                            <div><div class="tdp-item-label">Email</div><div class="tdp-item-value">@Model.AwardedCompany.OfficeEmail</div></div>
                                        </div>
                                        <div class="tdp-item">
                                            <div class="tdp-item-icon"><i class="fas fa-globe"></i></div>
                                            <div>
                                                <div class="tdp-item-label">Website</div>
                                                <div class="tdp-item-value">
                                                    @if (!string.IsNullOrEmpty(Model.AwardedCompany.CompanyWebsiteUrl))
                                                    {
                                                        <a href="@Model.AwardedCompany.CompanyWebsiteUrl" target="_blank" style="color:var(--gold);text-decoration:none;">@Model.AwardedCompany.CompanyWebsiteUrl</a>
                                                    }
                                                    else
                                                    {

                                                        <span style="color:var(--slate);">Not provided</span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                        <div class="tdp-item">
                                            <div class="tdp-item-icon"><i class="fas fa-star"></i></div>
                                            <div><div class="tdp-item-label">Rating</div><div class="tdp-item-value">@(Model.AwardedCompany.Rating?.ToString("N1") ?? "Not rated") / 5.0</div></div>
                                        </div>
                                    </div>
                                    <a asp-action="Index" asp-controller="Company"
                                       asp-route-id="@Model.AwardedCompany.EncId"
                                       asp-route-tenderId="@Model.TenderId"
                                       class="tdp-profile-btn">
                                        <i class="fas fa-external-link-alt"></i> View Company Profile
                                    </a>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Timeline -->
                    <div class="tdp-section">
                        <div class="tdp-section-hd">
                            <i class="fas fa-calendar-alt"></i><h2>Important Dates</h2>
                        </div>
                        <div class="tdp-section-body">
                            <div class="tdp-timeline">
                                <div class="tdp-tl-item">
                                    <div class="tdp-tl-dot dot-navy"><i class="fas fa-flag"></i></div>
                                    <div class="tdp-tl-label">Issued Date</div>
                                    <div class="tdp-tl-date"><i class="fas fa-calendar-day"></i> @Model.IssuedDate.ToString("MMMM dd, yyyy")</div>
                                </div>
                                <div class="tdp-tl-item">
                                    <div class="tdp-tl-dot dot-green"><i class="fas fa-door-open"></i></div>
                                    <div class="tdp-tl-label">Opening Date</div>
                                    <div class="tdp-tl-date"><i class="fas fa-calendar-day"></i> @Model.OpeningDate.ToString("MMMM dd, yyyy")</div>
                                </div>
                                <div class="tdp-tl-item">
                                    <div class="tdp-tl-dot dot-red"><i class="fas fa-lock"></i></div>
                                    <div class="tdp-tl-label">Closing Date</div>
                                    <div class="tdp-tl-date"><i class="fas fa-calendar-day"></i> @Model.ClosingDate.ToString("MMMM dd, yyyy")</div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div><!-- /details-tab -->
                <!-- ── DOCUMENTS TAB ── -->
                <div id="documents-tab" class="tab-content">

                    <div class="tdp-doc-header">
                        <h2 class="tdp-doc-title"><i class="fas fa-file-alt"></i> Tender Documents</h2>
                        <a href="@Url.Content("~/TenderDocument/" + Model.TenderDocument)" download class="tdp-dl-btn">
                            <i class="fas fa-download"></i> Download PDF
                        </a>
                    </div>

                    <div class="tdp-doc-meta">
                        <i class="fas fa-file-pdf"></i>
                        <div>
                            <div class="tdp-doc-name">@(Model.TenderDocument ?? "Tender Document.pdf")</div>
                            <div class="tdp-doc-hint">Click on the document to view or use the download button above</div>
                        </div>
                    </div>

                    <div class="pdf-viewer">
                        <div id="pdf-container" class="p-4"></div>
                    </div>

                </div><!-- /documents-tab -->

            </div><!-- /tdp-content -->
        </div><!-- /tdp-card -->
    </div><!-- /tdp-body -->

</div><!-- /tdp-wrap -->

<script src="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.2.1/flowbite.min.js"></script>
<script>
    // Show tab function
    function showTab(tabName) {
        const tabs = document.querySelectorAll('.tab-content');
        const buttons = document.querySelectorAll('.tab-btn');

        tabs.forEach(tab => {
            tab.classList.remove('active');
        });

        buttons.forEach(btn => {
            btn.classList.remove('active');
            btn.classList.add('text-gray-500');
            btn.classList.remove('text-blue-600');
        });

        document.getElementById(`${tabName}-tab`).classList.add('active');
        const activeButton = document.querySelector(`[onclick="showTab('${tabName}')"]`);
        activeButton.classList.add('active');
        activeButton.classList.add('text-blue-600');
        activeButton.classList.remove('text-gray-500');
    }

    // Initialize PDF.js
    pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';

    // Load the PDF into the viewer
    const url = "@Url.Content("~/TenderDocument/" + Model.TenderDocument)";

    // Function to load PDF
    function loadPDF() {
        const pdfContainer = document.getElementById('pdf-container');

        // Clear container first
        pdfContainer.innerHTML = '<div class="flex justify-center items-center p-4"><i class="fas fa-spinner fa-spin text-blue-600 mr-2"></i> Loading document...</div>';

        pdfjsLib.getDocument(url).promise.then(pdf => {
            pdfContainer.innerHTML = ''; // Clear loading message
            const scale = 1.5;
            const numPages = pdf.numPages;

            // Render all pages
            for (let pageNum = 1; pageNum <= numPages; pageNum++) {
                const pageContainer = document.createElement('div');
                pageContainer.className = 'mb-4 relative';

                const pageLabel = document.createElement('div');
                pageLabel.className = 'absolute top-2 right-2 bg-blue-600 text-white text-xs font-bold px-2 py-1 rounded-md opacity-75';
                pageLabel.textContent = `Page ${pageNum} of ${numPages}`;

                const canvas = document.createElement('canvas');
                canvas.className = 'mx-auto shadow-md rounded';

                pageContainer.appendChild(canvas);
                pageContainer.appendChild(pageLabel);
                pdfContainer.appendChild(pageContainer);

                pdf.getPage(pageNum).then(page => {
                    const viewport = page.getViewport({ scale });
                    canvas.height = viewport.height;
                    canvas.width = viewport.width;
                    const ctx = canvas.getContext('2d');

                    page.render({
                        canvasContext: ctx,
                        viewport: viewport
                    });
                });
            }
        }).catch(error => {
            pdfContainer.innerHTML = `<div class="text-center p-8 text-red-500"><i class="fas fa-exclamation-triangle mr-2"></i>Error loading PDF: ${error.message}</div>`;
        });
    }

    // Load PDF when documents tab is clicked
    document.querySelector('[onclick="showTab(\'documents\')"]').addEventListener('click', loadPDF);

    // Initialize the page with the details tab active
    document.addEventListener('DOMContentLoaded', function() {
        showTab('details');
    });
</script>
