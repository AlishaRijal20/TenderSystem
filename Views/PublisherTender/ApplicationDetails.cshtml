@model TenderApplicationViewModel

<link href="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.2.1/flowbite.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

<style>
    :root {
        --navy: #0B1F3A;
        --navy-mid: #122848;
        --gold: #C8960C;
        --gold-lt: #E8B84B;
        --ivory: #F7F3EC;
        --slate: #8A9BB5;
        --white: #ffffff;
        --muted: #5a6a80;
    }

    .ad-wrap {
        font-family: 'DM Sans', sans-serif;
        padding-bottom: 4rem;
    }

    .ad-hero {
        background: var(--navy);
        position: relative;
        overflow: hidden;
        padding: 2.8rem 2rem 4.5rem;
    }

        .ad-hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(200,150,12,.05) 1px, transparent 1px), linear-gradient(90deg, rgba(200,150,12,.05) 1px, transparent 1px);
            background-size: 40px 40px;
            pointer-events: none;
        }

        .ad-hero::after {
            content: '';
            position: absolute;
            top: -40%;
            right: -5%;
            width: 460px;
            height: 460px;
            background: radial-gradient(circle, rgba(200,150,12,.14) 0%, transparent 65%);
            pointer-events: none;
        }

    .ad-hero-inner {
        position: relative;
        z-index: 2;
        max-width: 1200px;
        margin: 0 auto;
    }

    .ad-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: .75rem;
        margin-bottom: 1.6rem;
    }

    .ad-back {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        color: var(--slate);
        font-size: .82rem;
        font-weight: 600;
        text-decoration: none;
        transition: color .2s, transform .2s;
    }

        .ad-back:hover {
            color: var(--gold-lt);
            transform: translateX(-3px);
            text-decoration: none;
        }

    .ad-award-wrap {
        position: relative;
        display: inline-block;
    }

    .ad-btn-award {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: .4rem 1rem;
        border-radius: 7px;
        background: rgba(200,150,12,.15);
        color: var(--gold-lt);
        font-size: .8rem;
        font-weight: 700;
        cursor: pointer;
        border: 1px solid rgba(200,150,12,.25);
        transition: background .2s, transform .2s;
        font-family: 'DM Sans', sans-serif;
    }

        .ad-btn-award:hover {
            background: var(--gold);
            color: var(--navy);
            transform: translateY(-1px);
        }

    .ad-dropdown {
        display: none;
        position: absolute;
        right: 0;
        top: calc(100% + 6px);
        background: var(--white);
        border-radius: 10px;
        box-shadow: 0 8px 28px rgba(11,31,58,.18);
        border: 1px solid rgba(11,31,58,.08);
        overflow: hidden;
        min-width: 130px;
        z-index: 30;
    }

        .ad-dropdown.open {
            display: block;
        }

    .ad-drop-btn {
        display: flex;
        align-items: center;
        gap: .6rem;
        width: 100%;
        padding: .75rem 1rem;
        font-size: .82rem;
        font-weight: 600;
        background: none;
        border: none;
        cursor: pointer;
        text-align: left;
        transition: background .15s;
        font-family: 'DM Sans', sans-serif;
    }

        .ad-drop-btn.won {
            color: #166534;
        }

            .ad-drop-btn.won:hover {
                background: #dcfce7;
            }

        .ad-drop-btn.lost {
            color: #991b1b;
        }

            .ad-drop-btn.lost:hover {
                background: #fee2e2;
            }

    .ad-status {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .35rem 1rem;
        border-radius: 999px;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .05em;
        text-transform: uppercase;
    }

    .st-won {
        background: linear-gradient(135deg,#10b981,#059669);
        color: #fff;
    }

    .st-lost {
        background: linear-gradient(135deg,#ef4444,#dc2626);
        color: #fff;
    }

    .st-pending {
        background: linear-gradient(135deg,#f59e0b,#d97706);
        color: #fff;
    }

    .ad-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        font-size: .65rem;
        font-weight: 500;
        letter-spacing: .2em;
        text-transform: uppercase;
        color: var(--gold);
        margin-bottom: .5rem;
    }

        .ad-eyebrow span {
            display: inline-block;
            width: 18px;
            height: 1px;
            background: var(--gold);
        }

    .ad-hero h1 {
        font-family: 'Playfair Display', serif;
        font-size: clamp(1.4rem,3vw,2rem);
        font-weight: 900;
        color: var(--white);
        margin: 0 0 1rem;
        line-height: 1.2;
    }

    .ad-hero-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 1.4rem;
    }

    .ad-meta-item {
        display: flex;
        align-items: center;
        gap: .4rem;
        font-size: .82rem;
        color: var(--slate);
    }

        .ad-meta-item i {
            color: var(--gold);
            font-size: .78rem;
        }

        .ad-meta-item strong {
            color: var(--white);
            font-weight: 600;
        }

    .ad-body {
        max-width: 1200px;
        margin: -2rem auto 0;
        padding: 0 1.5rem;
        position: relative;
        z-index: 2;
    }

    .ad-card {
        background: var(--white);
        border-radius: 16px;
        box-shadow: 0 8px 32px rgba(11,31,58,.1);
        overflow: hidden;
        margin-bottom: 1.4rem;
    }

    .ad-card-hd {
        background: var(--navy);
        padding: 1rem 1.5rem;
        display: flex;
        align-items: center;
        gap: .65rem;
    }

    .ad-card-hd-icon {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        background: rgba(200,150,12,.15);
        color: var(--gold);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .85rem;
        flex-shrink: 0;
    }

    .ad-card-hd h2 {
        font-family: 'Playfair Display', serif;
        font-size: .95rem;
        font-weight: 700;
        color: var(--white);
        margin: 0;
    }

    .ad-card-hd-sub {
        font-size: .72rem;
        color: var(--slate);
        margin-top: .1rem;
    }

    .ad-card-body {
        padding: 1.4rem;
    }

    .ad-info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: .75rem;
    }

    .ad-info-item {
        display: flex;
        align-items: flex-start;
        gap: .75rem;
        padding: .85rem 1rem;
        background: var(--ivory);
        border-radius: 10px;
        border: 1px solid rgba(11,31,58,.05);
        transition: background .2s, transform .2s;
    }

        .ad-info-item:hover {
            background: rgba(200,150,12,.06);
            transform: translateX(3px);
        }

    .ad-info-icon {
        width: 30px;
        height: 30px;
        border-radius: 7px;
        background: rgba(200,150,12,.12);
        color: var(--gold);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .78rem;
        flex-shrink: 0;
    }

    .ad-info-label {
        font-size: .66rem;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--slate);
        margin-bottom: .2rem;
    }

    .ad-info-value {
        font-size: .88rem;
        font-weight: 600;
        color: var(--navy);
        word-break: break-word;
    }

        .ad-info-value.gold {
            color: var(--gold);
            font-family: 'Playfair Display', serif;
        }

        .ad-info-value a {
            color: var(--gold);
            text-decoration: none;
        }

            .ad-info-value a:hover {
                text-decoration: underline;
            }

    .ad-two-col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.4rem;
    }

    .ad-company-hd {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: .75rem;
    }

    .ad-company-type {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .25rem .8rem;
        border-radius: 999px;
        background: rgba(200,150,12,.1);
        color: var(--gold);
        border: 1px solid rgba(200,150,12,.2);
        font-size: .7rem;
        font-weight: 700;
        letter-spacing: .05em;
        text-transform: uppercase;
    }

    .ad-rating {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .25rem .8rem;
        border-radius: 999px;
        background: rgba(251,191,36,.1);
        border: 1px solid rgba(251,191,36,.2);
        font-size: .78rem;
        font-weight: 700;
        color: #92400e;
    }

        .ad-rating i {
            color: #fbbf24;
            font-size: .75rem;
        }

    .ad-bidder-layout {
        display: flex;
        gap: 1.4rem;
        align-items: flex-start;
    }

    .ad-bidder-photo {
        width: 90px;
        height: 90px;
        border-radius: 12px;
        object-fit: cover;
        border: 3px solid rgba(200,150,12,.25);
        box-shadow: 0 4px 14px rgba(11,31,58,.12);
        flex-shrink: 0;
    }

    .ad-bidder-placeholder {
        width: 90px;
        height: 90px;
        border-radius: 12px;
        background: rgba(200,150,12,.1);
        border: 3px solid rgba(200,150,12,.2);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .ad-bidder-placeholder i {
            color: var(--gold);
            font-size: 2rem;
            opacity: .5;
        }

    .ad-bidder-info {
        flex: 1;
    }

    .ad-bidder-name {
        font-family: 'Playfair Display', serif;
        font-size: 1.05rem;
        font-weight: 900;
        color: var(--navy);
        margin-bottom: .25rem;
    }

    .ad-bidder-role {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        padding: .18rem .7rem;
        border-radius: 999px;
        background: rgba(200,150,12,.1);
        color: var(--gold);
        font-size: .68rem;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
        margin-bottom: .9rem;
    }

    .ad-bidder-contacts {
        display: flex;
        flex-direction: column;
        gap: .4rem;
    }

    .ad-contact-row {
        display: flex;
        align-items: center;
        gap: .6rem;
        font-size: .83rem;
        color: var(--muted);
    }

    .ad-contact-icon {
        width: 26px;
        height: 26px;
        border-radius: 6px;
        background: rgba(200,150,12,.1);
        color: var(--gold);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .72rem;
        flex-shrink: 0;
    }

    .ad-verified {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .22rem .75rem;
        border-radius: 999px;
        background: #dcfce7;
        color: #166534;
        font-size: .7rem;
        font-weight: 700;
        letter-spacing: .04em;
    }

    .ad-btn {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: .6rem 1.2rem;
        border-radius: 8px;
        font-size: .82rem;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
        border: none;
        transition: background .2s, transform .2s, box-shadow .2s;
        font-family: 'DM Sans', sans-serif;
    }

    .ad-btn-navy {
        background: var(--navy);
        color: var(--white);
        box-shadow: 0 3px 12px rgba(11,31,58,.18);
    }

        .ad-btn-navy i {
            color: var(--gold-lt);
        }

        .ad-btn-navy:hover {
            background: var(--navy-mid);
            transform: translateY(-1px);
            box-shadow: 0 5px 16px rgba(11,31,58,.25);
            color: var(--white);
            text-decoration: none;
        }

    .ad-btn-outline {
        background: var(--ivory);
        color: var(--navy);
        border: 1px solid rgba(11,31,58,.12);
    }

        .ad-btn-outline:hover {
            background: rgba(200,150,12,.08);
            border-color: rgba(200,150,12,.3);
            transform: translateY(-1px);
            color: var(--navy);
            text-decoration: none;
        }

    /* ── DOC MODAL ── */
    .ad-modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(11,31,58,.6);
        z-index: 50;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
    }

        .ad-modal-overlay.open {
            display: flex;
        }

    .ad-modal {
        background: var(--white);
        border-radius: 16px;
        width: 100%;
        max-width: 860px;
        max-height: 90vh;
        display: flex;
        flex-direction: column;
        box-shadow: 0 24px 64px rgba(11,31,58,.25);
    }

    .ad-modal-hd {
        background: var(--navy);
        padding: 1rem 1.4rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-radius: 16px 16px 0 0;
    }

        .ad-modal-hd h3 {
            font-family: 'Playfair Display', serif;
            font-size: .95rem;
            font-weight: 700;
            color: var(--white);
            margin: 0;
            display: flex;
            align-items: center;
            gap: .5rem;
        }

            .ad-modal-hd h3 i {
                color: var(--gold);
            }

    .ad-modal-close {
        width: 30px;
        height: 30px;
        border-radius: 7px;
        background: rgba(255,255,255,.1);
        color: var(--slate);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        border: none;
        transition: background .2s, color .2s;
    }

        .ad-modal-close:hover {
            background: rgba(255,255,255,.2);
            color: var(--white);
        }

    .ad-modal-body {
        padding: 1.2rem;
        flex: 1;
        overflow: hidden;
    }

        .ad-modal-body iframe {
            width: 100%;
            height: 70vh;
            border: none;
            border-radius: 8px;
        }

    /* ── AWARD OVERLAY ── */
    .award-overlay {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(11,31,58,.92);
        backdrop-filter: blur(10px);
        opacity: 0;
        pointer-events: none;
        transition: opacity .35s ease;
    }

        .award-overlay.active {
            opacity: 1;
            pointer-events: all;
        }

    .award-card {
        background: var(--white);
        border-radius: 24px;
        padding: 2.8rem 2.5rem;
        width: min(460px, 93vw);
        text-align: center;
        box-shadow: 0 48px 100px rgba(11,31,58,.45);
        transform: translateY(30px) scale(.95);
        transition: transform .45s cubic-bezier(.34,1.56,.64,1);
        position: relative;
        overflow: hidden;
    }

    .award-overlay.active .award-card {
        transform: translateY(0) scale(1);
    }

    /* shimmer top bar — gold for won, red for lost */
    .award-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background-size: 200% 100%;
        animation: aw-shimmer 1.8s linear infinite;
    }

    .award-card.won-card::before {
        background: linear-gradient(90deg,var(--gold),var(--gold-lt),var(--gold));
    }

    .award-card.lost-card::before {
        background: linear-gradient(90deg,#ef4444,#fca5a5,#ef4444);
    }
    @@keyframes aw-shimmer {
        0%

    {
        background-position: 200% center;
    }

    100% {
        background-position: -200% center;
    }

    }

    /* particles */
    .award-particles {
        position: absolute;
        inset: 0;
        pointer-events: none;
        overflow: hidden;
        border-radius: 24px;
    }

    .award-particle {
        position: absolute;
        border-radius: 50%;
        opacity: 0;
        animation: aw-float 3s ease-in-out infinite;
    }

    .won-card .award-particle {
        background: var(--gold-lt);
    }

    .lost-card .award-particle {
        background: #fca5a5;
    }

    .award-particle:nth-child(1) {
        width: 5px;
        height: 5px;
        left: 10%;
        animation-delay: 0s;
    }

    .award-particle:nth-child(2) {
        width: 4px;
        height: 4px;
        left: 28%;
        animation-delay: .5s;
    }

    .award-particle:nth-child(3) {
        width: 6px;
        height: 6px;
        left: 52%;
        animation-delay: 1.0s;
    }

    .award-particle:nth-child(4) {
        width: 4px;
        height: 4px;
        left: 74%;
        animation-delay: 1.6s;
    }

    .award-particle:nth-child(5) {
        width: 5px;
        height: 5px;
        left: 90%;
        animation-delay: 0.3s;
    }
    @@keyframes aw-float {
        0%

    {
        transform: translateY(110px) scale(0);
        opacity: 0;
    }

    20% {
        opacity: .7;
    }

    80% {
        opacity: .4;
    }

    100% {
        transform: translateY(-20px) scale(1);
        opacity: 0;
    }

    }

    /* icon ring */
    .award-ring {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.5rem;
        animation: aw-pulse 2s ease-in-out infinite;
    }

    .won-card .award-ring {
        background: linear-gradient(135deg,rgba(200,150,12,.16),rgba(200,150,12,.04));
        border: 2px solid rgba(200,150,12,.3);
    }

    .lost-card .award-ring {
        background: linear-gradient(135deg,rgba(239,68,68,.14),rgba(239,68,68,.04));
        border: 2px solid rgba(239,68,68,.3);
    }
    @@keyframes aw-pulse {
        0%,100%

    {
        box-shadow: 0 0 0 0 rgba(200,150,12,.25);
    }

    50% {
        box-shadow: 0 0 0 16px rgba(200,150,12,.0);
    }

    }

    .award-ring i {
        font-size: 2rem;
        animation: aw-bounce 1.6s ease-in-out infinite;
    }

    .won-card .award-ring i {
        color: var(--gold);
    }

    .lost-card .award-ring i {
        color: #ef4444;
    }
    @@keyframes aw-bounce {
        0%,100%

    {
        transform: translateY(0) scale(1);
    }

    45% {
        transform: translateY(-7px) scale(1.1);
    }

    65% {
        transform: translateY(-3px) scale(1.05);
    }

    }

    /* dots */
    .award-dots {
        display: flex;
        justify-content: center;
        gap: .5rem;
        margin: 1.1rem 0 .4rem;
    }

        .award-dots span {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            animation: aw-dot .9s ease-in-out infinite;
        }

    .won-card .award-dots span {
        background: var(--gold);
    }

    .lost-card .award-dots span {
        background: #ef4444;
    }

    .award-dots span:nth-child(2) {
        animation-delay: .15s;
        opacity: .7;
    }

    .award-dots span:nth-child(3) {
        animation-delay: .30s;
    }
    @@keyframes aw-dot {
        0%,80%,100%

    {
        transform: translateY(0);
        opacity: .4;
    }

    40% {
        transform: translateY(-9px);
        opacity: 1;
    }

    }

    /* progress */
    .award-progress-track {
        height: 5px;
        background: rgba(11,31,58,.08);
        border-radius: 99px;
        overflow: hidden;
        margin: .9rem 0 1.4rem;
    }

    .award-progress-fill {
        height: 100%;
        width: 0%;
        border-radius: 99px;
        transition: width .5s ease;
    }

    .won-card .award-progress-fill {
        background: linear-gradient(90deg,var(--gold),var(--gold-lt));
    }

    .lost-card .award-progress-fill {
        background: linear-gradient(90deg,#ef4444,#fca5a5);
    }

    /* text */
    .award-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--navy);
        margin: 0 0 .35rem;
    }

    .award-sub {
        font-size: .86rem;
        color: var(--muted);
        line-height: 1.6;
        margin: 0;
    }

    /* steps */
    .award-steps {
        list-style: none;
        padding: 0;
        margin: 1.3rem 0 0;
        text-align: left;
    }

        .award-steps li {
            display: flex;
            align-items: center;
            gap: .7rem;
            font-size: .82rem;
            color: var(--muted);
            padding: .38rem 0;
            border-bottom: 1px solid rgba(11,31,58,.05);
            transition: color .3s;
        }

            .award-steps li:last-child {
                border-bottom: none;
            }

            .award-steps li .s-icon {
                width: 24px;
                height: 24px;
                border-radius: 50%;
                border: 1.5px solid rgba(11,31,58,.15);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: .65rem;
                color: var(--slate);
                flex-shrink: 0;
                transition: all .3s;
            }

            .award-steps li.done .s-icon {
                background: #22c55e;
                border-color: #22c55e;
                color: white;
            }

            .award-steps li.active {
                color: var(--navy);
                font-weight: 600;
            }

                .award-steps li.active .s-icon {
                    border-color: var(--gold);
                    color: var(--gold);
                    animation: aw-spin 1.4s linear infinite;
                }

    .lost-card .award-steps li.active .s-icon {
        border-color: #ef4444;
        color: #ef4444;
    }
    @@keyframes aw-spin {
        to

    {
        transform: rotate(360deg);
    }

    }

    /* success / error final states */
    .award-final {
        display: none;
    }

        .award-final.show {
            display: block;
        }

    .award-final-ring {
        width: 86px;
        height: 86px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.3rem;
        animation: aw-pop .5s cubic-bezier(.34,1.56,.64,1) both;
    }

        .award-final-ring.won-ring {
            background: rgba(34,197,94,.12);
            border: 2px solid rgba(34,197,94,.35);
        }

        .award-final-ring.lost-ring {
            background: rgba(239,68,68,.1);
            border: 2px solid rgba(239,68,68,.3);
        }

        .award-final-ring.err-ring {
            background: rgba(239,68,68,.08);
            border: 2px solid rgba(239,68,68,.25);
        }

        .award-final-ring i.won-ic {
            font-size: 2rem;
            color: #22c55e;
        }

        .award-final-ring i.lost-ic {
            font-size: 2rem;
            color: #ef4444;
        }

        .award-final-ring i.err-ic {
            font-size: 2rem;
            color: #ef4444;
        }
    @@keyframes aw-pop {
        from

    {
        transform: scale(0);
        opacity: 0;
    }

    to {
        transform: scale(1);
        opacity: 1;
    }

    }

    .award-final-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--navy);
        margin: 0 0 .3rem;
    }

    .award-final-sub {
        font-size: .85rem;
        color: var(--muted);
        line-height: 1.6;
    }

    .award-dismiss {
        margin-top: 1.2rem;
        padding: .55rem 1.6rem;
        border-radius: 8px;
