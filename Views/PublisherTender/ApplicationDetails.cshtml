@model TenderApplicationViewModel

<link href="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.2.1/flowbite.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

<style>
    :root {
        --navy: #0B1F3A;
        --navy-mid: #122848;
        --gold: #C8960C;
        --gold-lt: #E8B84B;
        --ivory: #F7F3EC;
        --slate: #8A9BB5;
        --white: #ffffff;
        --muted: #5a6a80;
    }

    .ad-wrap {
        font-family: 'DM Sans', sans-serif;
        padding-bottom: 4rem;
    }

    .ad-hero {
        background: var(--navy);
        position: relative;
        overflow: hidden;
        padding: 2.8rem 2rem 4.5rem;
    }

        .ad-hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(200,150,12,.05) 1px, transparent 1px), linear-gradient(90deg, rgba(200,150,12,.05) 1px, transparent 1px);
            background-size: 40px 40px;
            pointer-events: none;
        }

        .ad-hero::after {
            content: '';
            position: absolute;
            top: -40%;
            right: -5%;
            width: 460px;
            height: 460px;
            background: radial-gradient(circle, rgba(200,150,12,.14) 0%, transparent 65%);
            pointer-events: none;
        }

    .ad-hero-inner {
        position: relative;
        z-index: 2;
        max-width: 1200px;
        margin: 0 auto;
    }

    .ad-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: .75rem;
        margin-bottom: 1.6rem;
    }

    .ad-back {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        color: var(--slate);
        font-size: .82rem;
        font-weight: 600;
        text-decoration: none;
        transition: color .2s, transform .2s;
    }

        .ad-back:hover {
            color: var(--gold-lt);
            transform: translateX(-3px);
            text-decoration: none;
        }

    .ad-award-wrap {
        position: relative;
        display: inline-block;
    }

    .ad-btn-award {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: .4rem 1rem;
        border-radius: 7px;
        background: rgba(200,150,12,.15);
        color: var(--gold-lt);
        font-size: .8rem;
        font-weight: 700;
        cursor: pointer;
        border: 1px solid rgba(200,150,12,.25);
        transition: background .2s, transform .2s;
        font-family: 'DM Sans', sans-serif;
    }

        .ad-btn-award:hover {
            background: var(--gold);
            color: var(--navy);
            transform: translateY(-1px);
        }

    .ad-dropdown {
        display: none;
        position: absolute;
        right: 0;
        top: calc(100% + 6px);
        background: var(--white);
        border-radius: 10px;
        box-shadow: 0 8px 28px rgba(11,31,58,.18);
        border: 1px solid rgba(11,31,58,.08);
        overflow: hidden;
        min-width: 130px;
        z-index: 30;
    }

        .ad-dropdown.open {
            display: block;
        }

    .ad-drop-btn {
        display: flex;
        align-items: center;
        gap: .6rem;
        width: 100%;
        padding: .75rem 1rem;
        font-size: .82rem;
        font-weight: 600;
        background: none;
        border: none;
        cursor: pointer;
        text-align: left;
        transition: background .15s;
        font-family: 'DM Sans', sans-serif;
    }

        .ad-drop-btn.won {
            color: #166534;
        }

            .ad-drop-btn.won:hover {
                background: #dcfce7;
            }

        .ad-drop-btn.lost {
            color: #991b1b;
        }

            .ad-drop-btn.lost:hover {
                background: #fee2e2;
            }

    .ad-status {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .35rem 1rem;
        border-radius: 999px;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .05em;
        text-transform: uppercase;
    }

    .st-won {
        background: linear-gradient(135deg,#10b981,#059669);
        color: #fff;
    }

    .st-lost {
        background: linear-gradient(135deg,#ef4444,#dc2626);
        color: #fff;
    }

    .st-pending {
        background: linear-gradient(135deg,#f59e0b,#d97706);
        color: #fff;
    }

    .ad-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        font-size: .65rem;
        font-weight: 500;
        letter-spacing: .2em;
        text-transform: uppercase;
        color: var(--gold);
        margin-bottom: .5rem;
    }

        .ad-eyebrow span {
            display: inline-block;
            width: 18px;
            height: 1px;
            background: var(--gold);
        }

    .ad-hero h1 {
        font-family: 'Playfair Display', serif;
        font-size: clamp(1.4rem, 3vw, 2rem);
        font-weight: 900;
        color: var(--white);
        margin: 0 0 1rem;
        line-height: 1.2;
    }

    .ad-hero-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 1.4rem;
    }

    .ad-meta-item {
        display: flex;
        align-items: center;
        gap: .4rem;
        font-size: .82rem;
        color: var(--slate);
    }

        .ad-meta-item i {
            color: var(--gold);
            font-size: .78rem;
        }

        .ad-meta-item strong {
            color: var(--white);
            font-weight: 600;
        }

    .ad-body {
        max-width: 1200px;
        margin: -2rem auto 0;
        padding: 0 1.5rem;
        position: relative;
        z-index: 2;
    }

    .ad-card {
        background: var(--white);
        border-radius: 16px;
        box-shadow: 0 8px 32px rgba(11,31,58,.1);
        overflow: hidden;
        margin-bottom: 1.4rem;
    }

    .ad-card-hd {
        background: var(--navy);
        padding: 1rem 1.5rem;
        display: flex;
        align-items: center;
        gap: .65rem;
    }

    .ad-card-hd-icon {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        background: rgba(200,150,12,.15);
        color: var(--gold);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .85rem;
        flex-shrink: 0;
    }

    .ad-card-hd h2 {
        font-family: 'Playfair Display', serif;
        font-size: .95rem;
        font-weight: 700;
        color: var(--white);
        margin: 0;
    }

    .ad-card-hd-sub {
        font-size: .72rem;
        color: var(--slate);
        margin-top: .1rem;
    }

    .ad-card-body {
        padding: 1.4rem;
    }

    .ad-info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: .75rem;
    }

    .ad-info-item {
        display: flex;
        align-items: flex-start;
        gap: .75rem;
        padding: .85rem 1rem;
        background: var(--ivory);
        border-radius: 10px;
        border: 1px solid rgba(11,31,58,.05);
        transition: background .2s, transform .2s;
    }

        .ad-info-item:hover {
            background: rgba(200,150,12,.06);
            transform: translateX(3px);
        }

    .ad-info-icon {
        width: 30px;
        height: 30px;
        border-radius: 7px;
        background: rgba(200,150,12,.12);
        color: var(--gold);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .78rem;
        flex-shrink: 0;
    }

    .ad-info-label {
        font-size: .66rem;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--slate);
        margin-bottom: .2rem;
    }

    .ad-info-value {
        font-size: .88rem;
        font-weight: 600;
        color: var(--navy);
        word-break: break-word;
    }

        .ad-info-value.gold {
            color: var(--gold);
            font-family: 'Playfair Display', serif;
        }

        .ad-info-value a {
            color: var(--gold);
            text-decoration: none;
        }

            .ad-info-value a:hover {
                text-decoration: underline;
            }

    .ad-two-col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.4rem;
    }

    .ad-company-hd {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: .75rem;
    }

    .ad-company-type {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .25rem .8rem;
        border-radius: 999px;
        background: rgba(200,150,12,.1);
        color: var(--gold);
        border: 1px solid rgba(200,150,12,.2);
        font-size: .7rem;
        font-weight: 700;
        letter-spacing: .05em;
        text-transform: uppercase;
    }

    .ad-rating {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .25rem .8rem;
        border-radius: 999px;
        background: rgba(251,191,36,.1);
        border: 1px solid rgba(251,191,36,.2);
        font-size: .78rem;
        font-weight: 700;
        color: #92400e;
    }

        .ad-rating i {
            color: #fbbf24;
            font-size: .75rem;
        }

    .ad-bidder-layout {
        display: flex;
        gap: 1.4rem;
        align-items: flex-start;
    }

    .ad-bidder-photo {
        width: 90px;
        height: 90px;
        border-radius: 12px;
        object-fit: cover;
        border: 3px solid rgba(200,150,12,.25);
        box-shadow: 0 4px 14px rgba(11,31,58,.12);
        flex-shrink: 0;
    }

    .ad-bidder-placeholder {
        width: 90px;
        height: 90px;
        border-radius: 12px;
        background: rgba(200,150,12,.1);
        border: 3px solid rgba(200,150,12,.2);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .ad-bidder-placeholder i {
            color: var(--gold);
            font-size: 2rem;
            opacity: .5;
        }

    .ad-bidder-info {
        flex: 1;
    }

    .ad-bidder-name {
        font-family: 'Playfair Display', serif;
        font-size: 1.05rem;
        font-weight: 900;
        color: var(--navy);
        margin-bottom: .25rem;
    }

    .ad-bidder-role {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        padding: .18rem .7rem;
        border-radius: 999px;
        background: rgba(200,150,12,.1);
        color: var(--gold);
        font-size: .68rem;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
        margin-bottom: .9rem;
    }

    .ad-bidder-contacts {
        display: flex;
        flex-direction: column;
        gap: .4rem;
    }

    .ad-contact-row {
        display: flex;
        align-items: center;
        gap: .6rem;
        font-size: .83rem;
        color: var(--muted);
    }

    .ad-contact-icon {
        width: 26px;
        height: 26px;
        border-radius: 6px;
        background: rgba(200,150,12,.1);
        color: var(--gold);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .72rem;
        flex-shrink: 0;
    }

    .ad-verified {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .22rem .75rem;
        border-radius: 999px;
        background: #dcfce7;
        color: #166534;
        font-size: .7rem;
        font-weight: 700;
        letter-spacing: .04em;
    }

    .ad-btn {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: .6rem 1.2rem;
        border-radius: 8px;
        font-size: .82rem;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
        border: none;
        transition: background .2s, transform .2s, box-shadow .2s;
        font-family: 'DM Sans', sans-serif;
    }

    .ad-btn-navy {
        background: var(--navy);
        color: var(--white);
        box-shadow: 0 3px 12px rgba(11,31,58,.18);
    }

        .ad-btn-navy i {
            color: var(--gold-lt);
        }

        .ad-btn-navy:hover {
            background: var(--navy-mid);
            transform: translateY(-1px);
            box-shadow: 0 5px 16px rgba(11,31,58,.25);
            color: var(--white);
            text-decoration: none;
        }

    .ad-btn-outline {
        background: var(--ivory);
        color: var(--navy);
        border: 1px solid rgba(11,31,58,.12);
    }

        .ad-btn-outline:hover {
            background: rgba(200,150,12,.08);
            border-color: rgba(200,150,12,.3);
            transform: translateY(-1px);
            color: var(--navy);
            text-decoration: none;
        }

    .ad-modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(11,31,58,.6);
        z-index: 50;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
    }

        .ad-modal-overlay.open {
            display: flex;
        }

    .ad-modal {
        background: var(--white);
        border-radius: 16px;
        width: 100%;
        max-width: 860px;
        max-height: 90vh;
        display: flex;
        flex-direction: column;
        box-shadow: 0 24px 64px rgba(11,31,58,.25);
    }

    .ad-modal-hd {
        background: var(--navy);
        padding: 1rem 1.4rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-radius: 16px 16px 0 0;
    }

        .ad-modal-hd h3 {
            font-family: 'Playfair Display', serif;
            font-size: .95rem;
            font-weight: 700;
            color: var(--white);
            margin: 0;
            display: flex;
            align-items: center;
            gap: .5rem;
        }

            .ad-modal-hd h3 i {
                color: var(--gold);
            }

    .ad-modal-close {
        width: 30px;
        height: 30px;
        border-radius: 7px;
        background: rgba(255,255,255,.1);
        color: var(--slate);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        border: none;
        transition: background .2s, color .2s;
    }

        .ad-modal-close:hover {
            background: rgba(255,255,255,.2);
            color: var(--white);
        }

    .ad-modal-body {
        padding: 1.2rem;
        flex: 1;
        overflow: hidden;
    }

        .ad-modal-body iframe {
            width: 100%;
            height: 70vh;
            border: none;
            border-radius: 8px;
        }
    @@media (max-width: 900px) {
        .ad-two-col

    {
        grid-template-columns: 1fr;
    }

    .ad-hero {
        padding: 2rem 1.2rem 4rem;
    }

    .ad-body {
        padding: 0 .75rem;
    }

    .ad-bidder-layout {
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .ad-bidder-contacts {
        align-items: center;
    }

    }
</style>
<div class="ad-wrap">
    <div class="ad-hero">
        <div class="ad-hero-inner">
            <div class="ad-topbar">
                <a asp-action="MonitorTender" asp-controller="PublisherTender" asp-route-id="@Model.Tender.EncId" class="ad-back">
                    <i class="fas fa-arrow-left"></i> Back to Monitor
                </a>
                <div style="display:flex;align-items:center;gap:.75rem;flex-wrap:wrap;">
                    @if (Model.Application.ApplicationStatus == "Pending")
                    {
                        <div class="ad-award-wrap">
                            <button class="ad-btn-award award-dropdown-btn">
                                <i class="fas fa-trophy"></i> Award
                            </button>
                            <div class="ad-dropdown">
                                <button class="ad-drop-btn won" data-id="@Model.Application.ApplicationId" data-status="Won">
                                    <i class="fas fa-trophy"></i> Won
                                </button>
                                <button class="ad-drop-btn lost" data-id="@Model.Application.ApplicationId" data-status="Lost">
                                    <i class="fas fa-times-circle"></i> Lost
                                </button>
                            </div>
                        </div>
                        <form id="awardForm_@Model.Application.ApplicationId" class="hidden" method="POST"
                              asp-action="AwardTender" asp-controller="PublisherTender">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ApplicationId" value="@Model.Application.ApplicationId" />
                            <input type="hidden" name="ApplicationStatus" />
                        </form>
                    }
                    <span class="ad-status @(Model.Application.ApplicationStatus.ToLower() == "won" ? "st-won" :
                                                                      Model.Application.ApplicationStatus.ToLower() == "lost" ? "st-lost" : "st-pending")">
                        <i class="fas @(Model.Application.ApplicationStatus.ToLower() == "won" ? "fa-trophy" :
                                                                   Model.Application.ApplicationStatus.ToLower() == "lost" ? "fa-times-circle" : "fa-hourglass-half")"></i>
                        @Model.Application.ApplicationStatus
                    </span>
                </div>
            </div>
            <p class="ad-eyebrow"><span></span> Application Details</p>
            <h1>@Model.Tender.Title</h1>
            <div class="ad-hero-meta">
                <div class="ad-meta-item"><i class="fas fa-hashtag"></i><span>Tender ID: <strong>#@Model.Tender.TenderId</strong></span></div>
                <div class="ad-meta-item"><i class="fas fa-file-alt"></i><span>Application ID: <strong>#@Model.Application.ApplicationId</strong></span></div>
                <div class="ad-meta-item"><i class="fas fa-building"></i><span>Issued by: <strong>@Model.Tender.IssuedBy</strong></span></div>
            </div>
        </div>
    </div>

    <div class="ad-body">

        <!-- Tender Overview -->
        <div class="ad-card">
            <div class="ad-card-hd">
                <div class="ad-card-hd-icon"><i class="fas fa-clipboard-list"></i></div>
                <div><h2>Tender Overview</h2><div class="ad-card-hd-sub">Key details of the tender</div></div>
            </div>
            <div class="ad-card-body">
                <div class="ad-info-grid">
                    <div class="ad-info-item">
                        <div class="ad-info-icon"><i class="fas fa-building"></i></div>
                        <div><div class="ad-info-label">Issued By</div><div class="ad-info-value">@Model.Tender.IssuedBy</div></div>
                    </div>
                    <div class="ad-info-item">
                        <div class="ad-info-icon"><i class="fas fa-rupee-sign"></i></div>
                        <div><div class="ad-info-label">Budget Estimation</div><div class="ad-info-value gold">&#8377; @Model.Tender.BudgetEstimation.ToString("N2")</div></div>
                    </div>
                    <div class="ad-info-item">
                        <div class="ad-info-icon"><i class="fas fa-hourglass-half"></i></div>
                        <div><div class="ad-info-label">Project Duration</div><div class="ad-info-value">@Model.Tender.ProjectDuration</div></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Two column -->
        <div class="ad-two-col">

            <!-- Company Profile -->
            <div class="ad-card">
                <div class="ad-card-hd">
                    <div class="ad-card-hd-icon"><i class="fas fa-building"></i></div>
                    <div><h2>Company Profile</h2><div class="ad-card-hd-sub">Business registration details</div></div>
                </div>
                <div class="ad-card-body">
                    <div class="ad-company-hd" style="margin-bottom:1rem;">
                        <span class="ad-company-type"><i class="fas fa-briefcase"></i> @Model.Company.CompanyType</span>
                        <span class="ad-rating">
                            @{
                                var rating = Model.Company.Rating ?? 0;
                                for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= rating)
                                    {
                                        <i class="fas fa-star"></i>
                                    }
                                    else if ((i - 0.5M) <= rating)
                                    {

                                        <i class="fas fa-star-half-alt"></i>
                                    }
                                    else
                                    {

                                        <i class="far fa-star"></i>
                                    }
                                }
                            }
                            <span>@(Model.Company.Rating?.ToString("0.0") ?? "N/A")</span>
                        </span>
                    </div>
                    <div style="display:flex;flex-direction:column;gap:.65rem;">
                        <div class="ad-info-item">
                            <div class="ad-info-icon"><i class="fas fa-building"></i></div>
                            <div><div class="ad-info-label">Company Name</div><div class="ad-info-value">@Model.Company.CompanyName</div></div>
                        </div>
                        <div class="ad-info-item">
                            <div class="ad-info-icon"><i class="fas fa-fingerprint"></i></div>
                            <div><div class="ad-info-label">Registration No.</div><div class="ad-info-value">@Model.Company.RegistrationNumber</div></div>
                        </div>
                        <div class="ad-info-item">
                            <div class="ad-info-icon"><i class="fas fa-map-marker-alt"></i></div>
                            <div><div class="ad-info-label">Office Address</div><div class="ad-info-value">@Model.Company.FullAddress</div></div>
                        </div>
                        <div class="ad-info-item">
                            <div class="ad-info-icon"><i class="fas fa-envelope"></i></div>
                            <div><div class="ad-info-label">Email</div><div class="ad-info-value"><a href="mailto:@Model.Company.OfficeEmail">@Model.Company.OfficeEmail</a></div></div>
                        </div>
                        <div class="ad-info-item">
                            <div class="ad-info-icon"><i class="fas fa-globe"></i></div>
                            <div>
                                <div class="ad-info-label">Website</div>
                                <div class="ad-info-value">
                                    @if (!string.IsNullOrEmpty(Model.Company.CompanyWebsiteUrl))
                                    {
                                        <a href="@Model.Company.CompanyWebsiteUrl" target="_blank">@Model.Company.CompanyWebsiteUrl <i class="fas fa-external-link-alt" style="font-size:.65rem;"></i></a>
                                    }
                                    else
                                    {

                                        <span style="color:var(--slate);">Not provided</span>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="ad-info-item">
                            <div class="ad-info-icon"><i class="fas fa-user-tie"></i></div>
                            <div><div class="ad-info-label">Position</div><div class="ad-info-value">@Model.Company.Position</div></div>
                        </div>
                    </div>
                    <div style="margin-top:1.2rem;">
                        <a asp-action="ViewCompanyReview" asp-controller="Company"
                           asp-route-id="@Model.Company.EncId" asp-route-applicationId="@Model.Application.EncId"
                           class="ad-btn ad-btn-navy">
                            <i class="fas fa-id-card"></i> View Company Review
                        </a>
                    </div>
                </div>
            </div>

            <!-- Application + Bank -->
            <div style="display:flex;flex-direction:column;gap:1.4rem;">

                <div class="ad-card">
                    <div class="ad-card-hd">
                        <div class="ad-card-hd-icon"><i class="fas fa-file-alt"></i></div>
                        <div><h2>Application Details</h2><div class="ad-card-hd-sub">Submitted proposal summary</div></div>
                    </div>
                    <div class="ad-card-body">
                        <div style="display:flex;flex-direction:column;gap:.65rem;">
                            <div class="ad-info-item">
                                <div class="ad-info-icon"><i class="fas fa-rupee-sign"></i></div>
                                <div><div class="ad-info-label">Proposed Budget</div><div class="ad-info-value gold">&#8377; @Model.Application.ProposedBudget.ToString("N2")</div></div>
                            </div>
                            <div class="ad-info-item">
                                <div class="ad-info-icon"><i class="fas fa-calendar-alt"></i></div>
                                <div><div class="ad-info-label">Proposed Duration</div><div class="ad-info-value">@Model.Application.ProposedDuration</div></div>
                            </div>
                        </div>
                        <div style="margin-top:1.2rem;padding:1rem;background:var(--ivory);border-radius:10px;border:1px solid rgba(11,31,58,.05);">
                            <div class="ad-info-label" style="margin-bottom:.75rem;">Application Document</div>
                            <div style="display:flex;gap:.65rem;flex-wrap:wrap;">
                                <button class="ad-btn ad-btn-navy" onclick="downloadDocument()"><i class="fas fa-download"></i> Download</button>
                                <button class="ad-btn ad-btn-outline" onclick="previewDocument()"><i class="fas fa-eye"></i> Preview</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="ad-card">
                    <div class="ad-card-hd">
                        <div class="ad-card-hd-icon"><i class="fas fa-university"></i></div>
                        <div><h2>Bank Details</h2><div class="ad-card-hd-sub">Applicant's bank information</div></div>
                    </div>
                    <div class="ad-card-body">
                        <div class="ad-info-grid">
                            <div class="ad-info-item">
                                <div class="ad-info-icon"><i class="fas fa-university"></i></div>
                                <div><div class="ad-info-label">Bank Name</div><div class="ad-info-value">@Model.Bank.BankName</div></div>
                            </div>
                            <div class="ad-info-item">
                                <div class="ad-info-icon"><i class="fas fa-user"></i></div>
                                <div><div class="ad-info-label">Account Holder</div><div class="ad-info-value">@Model.Bank.AccountHolderName</div></div>
                            </div>
                            <div class="ad-info-item">
                                <div class="ad-info-icon"><i class="fas fa-credit-card"></i></div>
                                <div><div class="ad-info-label">Account Number</div><div class="ad-info-value">@Model.Bank.AccountNumber</div></div>
                            </div>
                            <div class="ad-info-item">
                                <div class="ad-info-icon"><i class="fas fa-file-invoice-dollar"></i></div>
                                <div><div class="ad-info-label">Account Type</div><div class="ad-info-value">@Model.Bank.AccountType</div></div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- Bidder Details -->
        <div class="ad-card">
            <div class="ad-card-hd">
                <div class="ad-card-hd-icon"><i class="fas fa-user"></i></div>
                <div><h2>Bidder Details</h2><div class="ad-card-hd-sub">Personal information of the applicant</div></div>
            </div>
            <div class="ad-card-body">
                <div class="ad-bidder-layout">
                    @if (string.IsNullOrEmpty(Model.User.UserPhoto))
                    {
                        <div class="ad-bidder-placeholder"><i class="fas fa-user"></i></div>
                    }
                    else
                    {
                        <img src="~/UserImage/@Model.User.UserPhoto" alt="@Model.User.FirstName" class="ad-bidder-photo" />
                    }
                    <div class="ad-bidder-info">
                        <div class="ad-bidder-name">@Model.User.FirstName @Model.User.MiddleName @Model.User.LastName</div>
                        <span class="ad-bidder-role"><i class="fas fa-user-tie"></i> @Model.User.UserRole &nbsp;·&nbsp; @Model.Company.Position</span>
                        <div class="ad-bidder-contacts">
                            <div class="ad-contact-row"><div class="ad-contact-icon"><i class="fas fa-envelope"></i></div><span>@Model.User.EmailAddress</span></div>
                            <div class="ad-contact-row"><div class="ad-contact-icon"><i class="fas fa-phone"></i></div><span>@Model.User.Phone</span></div>
                            <div class="ad-contact-row"><div class="ad-contact-icon"><i class="fas fa-map-marker-alt"></i></div><span>@Model.User.City, @Model.User.District, @Model.User.Province</span></div>
                            <div class="ad-contact-row" style="margin-top:.3rem;"><span class="ad-verified"><i class="fas fa-check-circle"></i> Verified Account</span></div>
                        </div>
                        <div style="margin-top:1.1rem;">
                            <a asp-action="UserMessage" asp-controller="Chat" asp-route-receiverId="@Model.User.UserId" class="ad-btn ad-btn-navy">
                                <i class="fas fa-paper-plane"></i> Send Message
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<div id="adModal" class="ad-modal-overlay">
    <div class="ad-modal">
        <div class="ad-modal-hd">
            <h3><i class="fas fa-file-alt"></i> Document Preview</h3>
            <button class="ad-modal-close" onclick="closePreview()"><i class="fas fa-times"></i></button>
        </div>
        <div class="ad-modal-body">
            <iframe id="docViewer" frameborder="0"></iframe>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.2.1/flowbite.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.award-dropdown-btn').forEach(btn => {
            btn.addEventListener('click', function (e) {
                e.stopPropagation();
                const dd = this.nextElementSibling;
                document.querySelectorAll('.ad-dropdown').forEach(d => { if (d !== dd) d.classList.remove('open'); });
                dd.classList.toggle('open');
            });
        });

        document.addEventListener('click', function () {
            document.querySelectorAll('.ad-dropdown').forEach(d => d.classList.remove('open'));
        });

        document.querySelectorAll('.ad-drop-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                const applicationId = this.getAttribute('data-id');
                const applicationStatus = this.getAttribute('data-status');
                const form = document.getElementById(`awardForm_${applicationId}`);
                const formData = new FormData(form);
                formData.set('ApplicationStatus', applicationStatus);

                if (confirm(`Mark this application as '${applicationStatus}'?`)) {
                    fetch(form.action, {
                        method: form.method,
                        body: formData,
                        headers: {
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                        }
                    })
                    .then(r => r.json())
                    .then(data => {
                        if (data.success) {
                            alert(data.message);
                            window.location.href = data.redirectUrl;
                        } else {
                            alert('Failed to update: ' + data.message);
                        }
                    })
                    .catch(err => console.error('Error:', err));
                }
            });
        });
    });

    function downloadDocument() {
        const filePath = '@Url.Content("~/ProposalTender/")' + '@Model.Application.ApplicationDocument';
        const link = document.createElement('a');
        link.href = filePath;
        link.download = '@Model.Application.ApplicationDocument';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    }

    function previewDocument() {
        const filePath = '@Url.Content("~/ProposalTender/")' + '@Model.Application.ApplicationDocument';
        const iframe = document.getElementById('docViewer');
        if (filePath.endsWith('.pdf') || filePath.endsWith('.jpg') || filePath.endsWith('.png')) {
            iframe.src = filePath;
        } else {
            iframe.src = `https://docs.google.com/gview?url=${encodeURIComponent(window.location.origin + filePath)}&embedded=true`;
        }
        document.getElementById('adModal').classList.add('open');
    }

    function closePreview() {
        document.getElementById('adModal').classList.remove('open');
        document.getElementById('docViewer').src = '';
    }
</script>
