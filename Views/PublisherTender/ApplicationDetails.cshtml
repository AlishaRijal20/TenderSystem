        color: var(--white);
        border: none;
        font-family: 'DM Sans', sans-serif;
        font-size: .85rem;
        font-weight: 700;
        cursor: pointer;
        transition: background .2s;
    }

        .award-dismiss:hover {
            background: var(--navy-mid);
        }

    @@media (max-width: 900px) {
