@model TenderApplicationViewModel
@{
    ViewData["Title"] = "Tender Application - " + Model.Tender.Title;
    Layout = "_Layout";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.2.1/flowbite.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.min.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

<style>
    :root {
        --navy: #0B1F3A;
        --navy-mid: #122848;
        --gold: #C8960C;
        --gold-lt: #E8B84B;
        --ivory: #F7F3EC;
        --slate: #8A9BB5;
        --white: #ffffff;
        --muted: #5a6a80;
    }

    .page-container *, .page-container *::before, .page-container *::after {
        box-sizing: border-box;
    }

    /* ── PAGE ── */
    /* Escape the layout's container div using negative margins */
    .page-container {
        width: 100vw;
        position: relative;
        left: 50%;
        right: 50%;
        margin-left: -50vw;
        margin-right: -50vw;
        padding-bottom: 4rem;
        animation: fadeIn .5s ease-out;
        overflow-x: hidden;
    }

    @@keyframes fadeIn {
        from

    {
        opacity: 0;
        transform: translateY(8px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    /* ── INNER CONTENT MAX-WIDTH WRAPPER ── */
    .page-inner {
        max-width: 1280px;
        margin: 0 auto;
        padding: 2rem 1.5rem 0;
    }

    /* ── HERO ── */
    .tender-header {
        background: var(--navy);
        border-radius: 16px 16px 0 0;
        padding: 2.5rem 2rem 2rem;
        position: relative;
        overflow: hidden;
    }

        .tender-header::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(200,150,12,.05) 1px, transparent 1px), linear-gradient(90deg, rgba(200,150,12,.05) 1px, transparent 1px);
            background-size: 40px 40px;
            pointer-events: none;
        }

        .tender-header::after {
            content: '';
            position: absolute;
            top: -40%;
            right: -5%;
            width: 420px;
            height: 420px;
            background: radial-gradient(circle, rgba(200,150,12,.13) 0%, transparent 65%);
            pointer-events: none;
        }

        .tender-header > * {
            position: relative;
            z-index: 2;
        }

    /* back button */
    .back-button {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        color: var(--slate);
        font-size: .82rem;
        font-weight: 600;
        background: none;
        border: none;
        cursor: pointer;
        text-decoration: none;
        font-family: 'DM Sans', sans-serif;
        transition: color .2s, transform .2s;
        padding: 0;
    }

        .back-button:hover {
            color: var(--gold-lt);
            transform: translateX(-3px);
            text-decoration: none;
        }

    /* status badges */
    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .35rem 1rem;
        border-radius: 999px;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .05em;
        text-transform: uppercase;
        transition: transform .2s, box-shadow .2s;
    }

        .status-badge:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(0,0,0,.15);
        }

    .status-won {
        background: linear-gradient(135deg, #10b981, #059669);
        color: white;
    }

    .status-lost {
        background: linear-gradient(135deg, #ef4444, #dc2626);
        color: white;
    }

    .status-pending {
        background: linear-gradient(135deg, #f59e0b, #d97706);
        color: white;
    }

    .tender-header h1 {
        font-family: 'Playfair Display', serif;
        font-size: clamp(1.4rem, 3vw, 2rem);
        font-weight: 900;
        color: var(--white);
        margin: .9rem 0 .6rem;
        line-height: 1.2;
    }

    .th-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 1.2rem;
        font-size: .8rem;
        color: rgba(255,255,255,.7);
    }

        .th-meta span {
            display: flex;
            align-items: center;
            gap: .4rem;
        }

        .th-meta i {
            color: var(--gold);
        }

    /* contract button */
    .contract-button {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        padding: .7rem 1.5rem;
        border-radius: 9px;
        background: var(--gold);
        color: var(--navy);
        font-weight: 700;
        font-size: .85rem;
        text-decoration: none;
        transition: background .2s, transform .2s, box-shadow .2s;
        box-shadow: 0 4px 14px rgba(200,150,12,.3);
        font-family: 'DM Sans', sans-serif;
    }

        .contract-button:hover {
            background: var(--gold-lt);
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(200,150,12,.4);
            text-decoration: none;
            color: var(--navy);
        }

    /* ── TABS ── */
    .tabs-container {
        background: var(--white);
        padding: 0 1.5rem;
        border-bottom: 1px solid rgba(11,31,58,.07);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .tabs-wrapper {
        display: flex;
        gap: .5rem;
    }

    .tab-button {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: 1.1rem 1.3rem;
        color: var(--muted);
        font-weight: 600;
        font-size: .83rem;
        background: none;
        border: none;
        cursor: pointer;
        border-bottom: 2px solid transparent;
        position: relative;
        top: 1px;
        transition: color .2s, border-color .2s;
        font-family: 'DM Sans', sans-serif;
    }

        .tab-button:hover {
            color: var(--navy);
        }

        .tab-button.active {
            color: var(--navy);
            border-bottom-color: var(--gold);
        }

    .tab-icon {
        width: 26px;
        height: 26px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .72rem;
    }

    .tab-icon-blue {
        background: rgba(59,130,246,.1);
        color: #3b82f6;
    }

    .tab-icon-green {
        background: rgba(16,185,129,.1);
        color: #10b981;
    }

    .tab-icon-red {
        background: rgba(239,68,68,.08);
        color: #ef4444;
    }

    /* ── CONTENT WRAPPER ── */
    .content-area {
        background: var(--white);
        border-radius: 0 0 16px 16px;
        box-shadow: 0 10px 40px rgba(11,31,58,.1);
    }

    .tab-content {
        animation: fadeIn .4s ease-out;
    }

    .hidden {
        display: none !important;
    }

    /* ── CONTENT GRID ── */
    .content-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1.4rem;
        padding: 1.6rem;
    }

    /* ── CARDS ── */
    .info-card {
        background: var(--white);
        border-radius: 12px;
        padding: 1.5rem;
        border: 1px solid rgba(11,31,58,.06);
        box-shadow: 0 4px 16px rgba(11,31,58,.06);
        transition: transform .25s, box-shadow .25s;
    }

        .info-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 28px rgba(11,31,58,.1);
        }

    .card-title {
        font-family: 'Playfair Display', serif;
        font-size: 1rem;
        font-weight: 900;
        color: var(--navy);
        margin-bottom: 1.2rem;
        display: flex;
        align-items: center;
        gap: .5rem;
    }

        .card-title i {
            color: var(--gold);
            font-size: .9rem;
        }

    /* publisher card */
    .publisher-card {
        text-align: center;
    }

    .publisher-photo {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        margin: 0 auto 1rem;
        border: 3px solid rgba(200,150,12,.25);
        object-fit: cover;
        box-shadow: 0 4px 14px rgba(11,31,58,.12);
    }

    .publisher-photo-placeholder {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        margin: 0 auto 1rem;
        background: rgba(200,150,12,.1);
        border: 3px solid rgba(200,150,12,.2);
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .publisher-photo-placeholder i {
            font-size: 2.2rem;
            color: var(--gold);
            opacity: .5;
        }

    .pub-name {
        font-family: 'Playfair Display', serif;
        font-size: 1.05rem;
        font-weight: 900;
        color: var(--navy);
        margin-bottom: .3rem;
    }

    .pub-role {
        display: inline-block;
        background: rgba(200,150,12,.1);
        color: var(--gold);
        border: 1px solid rgba(200,150,12,.2);
        padding: .2rem .8rem;
        border-radius: 999px;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
        margin-bottom: 1.1rem;
    }

    .contact-item {
        display: flex;
        align-items: center;
        gap: .65rem;
        padding: .45rem 0;
        font-size: .83rem;
        color: var(--muted);
        text-align: left;
    }

    .contact-icon {
        width: 28px;
        height: 28px;
        border-radius: 7px;
        background: rgba(200,150,12,.1);
        color: var(--gold);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .75rem;
        flex-shrink: 0;
    }

    /* message button */
    .message-button {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: .65rem 1.4rem;
        border-radius: 9px;
        background: var(--navy);
        color: var(--white);
        font-size: .82rem;
        font-weight: 700;
        text-decoration: none;
        margin-top: 1rem;
        transition: background .2s, transform .2s, box-shadow .2s;
        box-shadow: 0 4px 14px rgba(11,31,58,.18);
        font-family: 'DM Sans', sans-serif;
    }

        .message-button:hover {
            background: var(--navy-mid);
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(11,31,58,.25);
            color: var(--white);
            text-decoration: none;
        }

        .message-button i {
            color: var(--gold-lt);
        }

    /* info rows */
    .info-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: .65rem 0;
        border-bottom: 1px solid rgba(11,31,58,.05);
        font-size: .84rem;
    }

        .info-item:last-child {
            border-bottom: none;
        }

    .info-label {
        color: var(--slate);
        font-weight: 500;
    }

    .info-value {
        font-weight: 700;
        color: var(--navy);
    }

        .info-value.green {
            color: #059669;
            font-family: 'Playfair Display', serif;
        }

    /* tender status pill */
    .ts-pill {
        display: inline-flex;
        align-items: center;
        gap: .25rem;
        padding: .18rem .7rem;
        border-radius: 999px;
        font-size: .68rem;
        font-weight: 700;
        letter-spacing: .05em;
        text-transform: uppercase;
    }

    .ts-open {
        background: #dcfce7;
        color: #166534;
    }

    .ts-closed {
        background: #fee2e2;
        color: #991b1b;
    }

    .ts-other {
        background: #fef3c7;
        color: #92400e;
    }

    /* description box */
    .description-box {
        background: var(--ivory);
        border-radius: 10px;
        padding: 1.2rem;
        border-left: 3px solid var(--gold);
        margin-top: 1.1rem;
    }

        .description-box h4 {
            font-family: 'Playfair Display', serif;
            font-size: .95rem;
            font-weight: 900;
            color: var(--navy);
            margin-bottom: .6rem;
            display: flex;
            align-items: center;
            gap: .4rem;
        }

            .description-box h4 i {
                color: var(--gold);
            }

        .description-box p {
            font-size: .85rem;
            color: var(--muted);
            line-height: 1.7;
        }

    /* ── TIMELINE ── */
    .timeline-wrap {
        margin: 0 1.6rem 1.6rem;
    }

    .timeline-container {
        display: flex;
        justify-content: space-between;
        position: relative;
        padding: 1.5rem 0;
    }

        .timeline-container::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 2rem;
            right: 2rem;
            height: 2px;
            background: linear-gradient(90deg, var(--gold) 0%, rgba(200,150,12,.2) 100%);
            z-index: 0;
        }

    .timeline-item {
        flex: 1;
        text-align: center;
        position: relative;
        z-index: 1;
    }

    .timeline-point {
        width: 38px;
        height: 38px;
        background: var(--navy);
        border: 2px solid var(--gold);
        border-radius: 50%;
        margin: 0 auto .7rem;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        z-index: 1;
        transition: transform .25s, box-shadow .25s;
    }

    .timeline-item:hover .timeline-point {
        transform: scale(1.12);
        box-shadow: 0 4px 14px rgba(200,150,12,.3);
    }

    .timeline-point i {
        color: var(--gold);
        font-size: .78rem;
    }

    .tl-label {
        font-size: .72rem;
        font-weight: 700;
        color: var(--navy);
        letter-spacing: .04em;
        text-transform: uppercase;
    }

    .tl-date {
        font-size: .75rem;
        color: var(--slate);
        margin-top: .15rem;
    }

    /* ── APP STATUS PILL (application tab) ── */
    .app-status-pill {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .35rem 1rem;
        border-radius: 999px;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .05em;
        text-transform: uppercase;
    }

    .app-status-won {
        background: #dcfce7;
        color: #166534;
    }

    .app-status-lost {
        background: #fee2e2;
        color: #991b1b;
    }

    .app-status-pending {
        background: #fef3c7;
        color: #92400e;
    }

    /* congrats box */
    .congrats-box {
        background: linear-gradient(135deg, rgba(200,150,12,.06), rgba(200,150,12,.02));
        border: 1px solid rgba(200,150,12,.2);
        border-radius: 12px;
        padding: 1.4rem;
        margin-top: 1.2rem;
    }

        .congrats-box h3 {
            font-family: 'Playfair Display', serif;
            font-size: .95rem;
            color: var(--navy);
            font-weight: 900;
            margin-bottom: .5rem;
            display: flex;
            align-items: center;
            gap: .4rem;
        }

        .congrats-box p {
            font-size: .83rem;
            color: var(--muted);
            margin-bottom: 1rem;
        }

    /* ── DOCUMENTS TAB ── */
    .document-card {
        background: var(--white);
        border-radius: 12px;
        padding: 1.4rem;
        border: 1px solid rgba(11,31,58,.06);
        box-shadow: 0 4px 16px rgba(11,31,58,.06);
        margin-bottom: 1.4rem;
        transition: transform .25s, box-shadow .25s;
    }

        .document-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 28px rgba(11,31,58,.1);
        }

    .document-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid rgba(11,31,58,.06);
    }

    .document-title {
        display: flex;
        align-items: center;
        gap: .75rem;
    }

    .document-icon {
        width: 38px;
        height: 38px;
        border-radius: 9px;
        background: rgba(200,150,12,.1);
        color: var(--gold);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
    }

    .document-title h3 {
        font-weight: 700;
        color: var(--navy);
        font-size: .92rem;
        margin: 0 0 .15rem;
    }

    .document-title p {
        font-size: .73rem;
        color: var(--slate);
        margin: 0;
    }

    /* download button */
    .action-button {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .55rem 1.1rem;
        border-radius: 8px;
        font-size: .78rem;
        font-weight: 700;
        cursor: pointer;
        transition: background .2s, transform .2s, box-shadow .2s;
        font-family: 'DM Sans', sans-serif;
        text-decoration: none;
    }

    .primary-button {
        background: var(--navy);
        color: var(--white);
        box-shadow: 0 3px 12px rgba(11,31,58,.18);
    }

        .primary-button i {
            color: var(--gold-lt);
        }

        .primary-button:hover {
            background: var(--navy-mid);
            transform: translateY(-1px);
            box-shadow: 0 5px 16px rgba(11,31,58,.25);
            color: var(--white);
            text-decoration: none;
        }

    /* PDF viewer */
    .pdf-viewer {
        background: var(--ivory);
        border-radius: 10px;
        padding: 1.2rem;
        height: 800px;
        overflow-y: auto;
        border: 1px solid rgba(11,31,58,.07);
        scrollbar-width: thin;
        scrollbar-color: var(--gold) transparent;
    }

        .pdf-viewer::-webkit-scrollbar {
            width: 5px;
        }

        .pdf-viewer::-webkit-scrollbar-thumb {
            background: var(--gold);
            border-radius: 99px;
        }

    .pdf-container {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        align-items: center;
    }

        .pdf-container canvas {
            max-width: 100%;
            height: auto;
            box-shadow: 0 4px 14px rgba(11,31,58,.1);
            border-radius: 8px;
        }

    /* spinner */
    .pdf-spinner {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: 3px solid rgba(200,150,12,.15);
        border-top-color: var(--gold);
        animation: spin .8s linear infinite;
        margin: 0 auto .8rem;
    }
    @@keyframes spin {
        to

    {
        transform: rotate(360deg);
    }

    }

    /* pdf error */
    .pdf-error {
        text-align: center;
        padding: 2rem;
    }

        .pdf-error i {
            font-size: 2.5rem;
            color: #ef4444;
            margin-bottom: .7rem;
            display: block;
        }

        .pdf-error h3 {
            font-family: 'Playfair Display', serif;
            color: var(--navy);
            margin-bottom: .4rem;
            font-size: .95rem;
        }

        .pdf-error p {
            font-size: .82rem;
            color: var(--slate);
        }

    /* page label on PDF */
    .pdf-page-label {
        position: absolute;
        top: 8px;
        right: 8px;
        background: var(--navy);
        color: var(--gold-lt);
        font-size: .65rem;
        font-weight: 700;
        padding: .2rem .55rem;
        border-radius: 5px;
    }

    @@media (max-width: 768px) {
        .page-inner {
            padding: 1rem .75rem 0;
        }

        .tender-header {
            padding: 1.8rem 1.2rem 1.5rem;
        }

        .content-grid {
            padding: 1rem;
        }

        .document-header {
            flex-direction: column;
            align-items: flex-start;
            gap: .75rem;
        }
    }
</style>

<div class="page-container">
    <div class="page-inner">

        <!-- HERO -->
        <div class="tender-header">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:.8rem;">
                <a asp-action="TenderBidTab" asp-controller="BidTender" asp-route-activeTab="UpcomingTender" class="back-button">
                    <i class="fas fa-arrow-left"></i>
                    <span>Back</span>
                </a>
                <span class="status-badge status-@Model.Application.ApplicationStatus.ToLower()">
                    <i class="fas @(Model.Application.ApplicationStatus.ToLower() == "won" ? "fa-trophy" :
                                                     Model.Application.ApplicationStatus.ToLower() == "lost" ? "fa-times-circle" : "fa-hourglass-half")"></i>
                    @Model.Application.ApplicationStatus
                </span>
            </div>

            <h1>@Model.Tender.Title</h1>

            <div class="th-meta">
                <span><i class="fas fa-hashtag"></i> Tender ID: @Model.Tender.TenderId</span>
                <span><i class="fas fa-file-alt"></i> Application ID: @Model.Application.ApplicationId</span>
            </div>
        </div>

        <!-- CONTRACT BTN (won only) -->
        @if (Model.Application.ApplicationStatus.ToLower() == "won")
        {
            <div style="display:flex;justify-content:center;background:var(--white);padding:.9rem 1.5rem;border-bottom:1px solid rgba(11,31,58,.06);">
                <a asp-action="Index" asp-controller="TenderContract" asp-route-id="@Model.Application.EncId" class="contract-button">
                    <i class="fas fa-file-contract"></i>
                    Generate Contract
                </a>
            </div>
        }

        <!-- TABS -->
        <div class="tabs-container">
            <div class="tabs-wrapper">
                <button onclick="showTab('details')" class="tab-button active" id="details-tab-btn">
                    <span class="tab-icon tab-icon-blue"><i class="fas fa-info-circle"></i></span>
                    Details
                </button>
                <button onclick="showTab('application')" class="tab-button" id="application-tab-btn">
                    <span class="tab-icon tab-icon-green"><i class="fas fa-file-alt"></i></span>
                    Application
                </button>
                <button onclick="showTab('documents')" class="tab-button" id="documents-tab-btn">
                    <span class="tab-icon tab-icon-red"><i class="fas fa-file-pdf"></i></span>
                    Documents
                </button>
            </div>
        </div>

        <!-- CONTENT -->
        <div class="content-area">

            <!-- ── DETAILS TAB ── -->
            <div id="details-tab" class="tab-content">
                <div class="content-grid">

                    <!-- Publisher Card -->
                    <div class="info-card publisher-card">
                        @if (!string.IsNullOrEmpty(Model.User.UserPhoto))
                        {
                            <img src="@Url.Content("~/UserImage/" + Model.User.UserPhoto)" alt="Publisher" class="publisher-photo" />
                        }
                        else
                        {
                            <div class="publisher-photo-placeholder">
                                <i class="fas fa-user"></i>
                            </div>
                        }
                        <div class="pub-name">@Model.User.FirstName @Model.User.MiddleName @Model.User.LastName</div>
                        <span class="pub-role">@Model.User.UserRole</span>

                        <div>
                            <div class="contact-item">
                                <div class="contact-icon"><i class="fas fa-envelope"></i></div>
                                <span>@Model.User.EmailAddress</span>
                            </div>
                            <div class="contact-item">
                                <div class="contact-icon"><i class="fas fa-phone"></i></div>
                                <span>@Model.User.Phone</span>
                            </div>
                            <div class="contact-item">
                                <div class="contact-icon"><i class="fas fa-map-marker-alt"></i></div>
                                <span>@Model.User.City, @Model.User.District</span>
                            </div>
                        </div>

                        <a asp-action="UserMessage" asp-controller="Chat" asp-route-receiverId="@Model.User.UserId" class="message-button">
                            <i class="fas fa-paper-plane"></i>
                            Send Message
                        </a>
                    </div>

                    <!-- Tender Info -->
                    <div class="info-card">
                        <div class="card-title"><i class="fas fa-info-circle"></i> Tender Information</div>

                        <div class="info-item">
                            <span class="info-label">Type</span>
                            <span class="info-value">@Model.Tender.TenderType</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Duration</span>
                            <span class="info-value">@Model.Tender.ProjectDuration</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Budget</span>
                            <span class="info-value green">₹ @Model.Tender.BudgetEstimation.ToString("N2")</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Status</span>
                            <span class="ts-pill @(Model.Tender.TenderStatus.ToLower() == "open" ? "ts-open" :
                                                                                Model.Tender.TenderStatus.ToLower() == "closed" ? "ts-closed" : "ts-other")">
                                @Model.Tender.TenderStatus
                            </span>
                        </div>

                        <div class="description-box">
                            <h4><i class="fas fa-align-left"></i> Project Description</h4>
                            <p>@Model.Tender.TenderDescription</p>
                        </div>
                    </div>
                </div>

                <!-- Timeline -->
                <div class="timeline-wrap">
                    <div class="info-card">
                        <div class="card-title"><i class="fas fa-clock"></i> Timeline</div>
                        <div class="timeline-container">
                            <div class="timeline-item">
                                <div class="timeline-point"><i class="fas fa-flag"></i></div>
                                <div class="tl-label">Issue Date</div>
                                <div class="tl-date">@Model.Tender.IssuedDate.ToString("MMM dd, yyyy")</div>
                            </div>
                            <div class="timeline-item">
                                <div class="timeline-point"><i class="fas fa-door-open"></i></div>
                                <div class="tl-label">Opening Date</div>
                                <div class="tl-date">@Model.Tender.OpeningDate.ToString("MMM dd, yyyy")</div>
                            </div>
                            <div class="timeline-item">
                                <div class="timeline-point"><i class="fas fa-lock"></i></div>
                                <div class="tl-label">Closing Date</div>
                                <div class="tl-date">@Model.Tender.ClosingDate.ToString("MMM dd, yyyy")</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ── APPLICATION TAB ── -->
            <div id="application-tab" class="tab-content hidden">
                <div style="padding:1.6rem;">
                    <div class="info-card">
                        <div class="card-title"><i class="fas fa-file-alt"></i> Application Details</div>

                        <div class="info-item">
                            <span class="info-label">Application ID</span>
                            <span class="info-value">@Model.Application.ApplicationId</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Proposed Duration</span>
                            <span class="info-value">@Model.Application.ProposedDuration</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Proposed Budget</span>
                            <span class="info-value green">₹ @Model.Application.ProposedBudget.ToString("N2")</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Status</span>
                            <span class="app-status-pill app-status-@Model.Application.ApplicationStatus.ToLower()">
                                <i class="fas @(Model.Application.ApplicationStatus.ToLower() == "won" ? "fa-trophy" :
                                                                             Model.Application.ApplicationStatus.ToLower() == "lost" ? "fa-times-circle" :
                                                                             "fa-hourglass-half")"></i>
                                @Model.Application.ApplicationStatus
                            </span>
                        </div>
                    </div>

                    @if (Model.Application.ApplicationStatus.ToLower() == "won")
                    {
                        <div class="congrats-box">
                            <h3><i class="fas fa-trophy" style="color:var(--gold);"></i> Congratulations!</h3>
                            <p>Your application has been accepted. You can now generate a contract for this tender.</p>
                            <a asp-action="Index" asp-controller="TenderContract" asp-route-id="@Model.Application.EncId" class="contract-button">
                                <i class="fas fa-file-contract"></i>
                                Generate Contract
                            </a>
                        </div>
                    }
                </div>
            </div>

            <!-- ── DOCUMENTS TAB ── -->
            <div id="documents-tab" class="tab-content hidden">
                <div style="padding:1.6rem;">

                    <!-- Tender Document -->
                    <div class="document-card">
                        <div class="document-header">
                            <div class="document-title">
                                <div class="document-icon"><i class="fas fa-file-pdf"></i></div>
                                <div>
                                    <h3>Tender Document</h3>
                                    <p>Original tender document published by the issuer</p>
                                </div>
                            </div>
                            <a href="@Url.Content("~/TenderDocument/" + Model.Tender.TenderDocument)"
                               class="action-button primary-button" download>
                                <i class="fas fa-download"></i> Download
                            </a>
                        </div>
                        <div class="pdf-viewer">
                            <div id="tenderPdfContainer" class="pdf-container">
                                <div style="text-align:center;padding:2rem;">
                                    <div class="pdf-spinner"></div>
                                    <p style="font-size:.82rem;color:var(--slate);">Loading document...</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Application Document -->
                    <div class="document-card">
                        <div class="document-header">
                            <div class="document-title">
                                <div class="document-icon"><i class="fas fa-file-alt"></i></div>
                                <div>
                                    <h3>Application Document</h3>
                                    <p>Your submitted proposal document</p>
                                </div>
                            </div>
                            <a href="@Url.Content("~/ProposalTender/" + Model.Application.ApplicationDocument)"
                               class="action-button primary-button" download>
                                <i class="fas fa-download"></i> Download
                            </a>
                        </div>
                        <div class="pdf-viewer">
                            <div id="applicationPdfContainer" class="pdf-container">
                                <div style="text-align:center;padding:2rem;">
                                    <div class="pdf-spinner"></div>
                                    <p style="font-size:.82rem;color:var(--slate);">Loading document...</p>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

        </div><!-- /content-area -->
    </div><!-- /page-inner -->
</div><!-- /page-container -->

<script>
    function showTab(tabName) {
        const tabs = document.querySelectorAll('.tab-content');
        const buttons = document.querySelectorAll('.tab-button');

        tabs.forEach(tab => tab.classList.add('hidden'));
        buttons.forEach(btn => btn.classList.remove('active'));

        document.getElementById(`${tabName}-tab`).classList.remove('hidden');
        document.getElementById(`${tabName}-tab-btn`).classList.add('active');

        // Load PDFs when documents tab is clicked
        if (tabName === 'documents') {
            loadTenderPDF();
            loadApplicationPDF();
        }
    }

    // Function to load Tender PDF
    function loadTenderPDF() {
        const url = "@Url.Content("~/TenderDocument/" + Model.Tender.TenderDocument)";
        const pdfContainer = document.getElementById('tenderPdfContainer');

        // Check if PDF is already loaded
        if (pdfContainer.querySelector('canvas')) return;

        pdfContainer.innerHTML = `<div style="text-align:center;padding:2rem;"><div class="pdf-spinner"></div><p style="font-size:.82rem;color:var(--slate);">Loading document...</p></div>`;

        pdfjsLib.getDocument(url).promise.then(pdf => {
            pdfContainer.innerHTML = '';
            const scale = 1.5;
            const numPages = pdf.numPages;

            for (let pageNum = 1; pageNum <= numPages; pageNum++) {
                const pageContainer = document.createElement('div');
                pageContainer.className = 'mb-6 relative';

                const pageLabel = document.createElement('div');
                pageLabel.className = 'pdf-page-label';
                pageLabel.textContent = `Page ${pageNum} of ${numPages}`;

                const canvas = document.createElement('canvas');
                canvas.className = 'mx-auto shadow-md rounded-lg';

                pageContainer.appendChild(canvas);
                pageContainer.appendChild(pageLabel);
                pdfContainer.appendChild(pageContainer);

                pdf.getPage(pageNum).then(page => {
                    const viewport = page.getViewport({ scale });
                    canvas.height = viewport.height;
                    canvas.width = viewport.width;
                    const ctx = canvas.getContext('2d');
                    page.render({ canvasContext: ctx, viewport: viewport }).promise.then(() => {
                        console.log(`Tender PDF Page ${pageNum} rendered successfully`);
                    }).catch(error => {
                        console.error(`Error rendering tender PDF page ${pageNum}:`, error);
                    });
                });
            }
        }).catch(error => {
            console.error('Error loading tender PDF:', error);
            pdfContainer.innerHTML = `<div class="pdf-error"><i class="fas fa-exclamation-circle"></i><h3>Error Loading PDF</h3><p>There was an error loading the tender document. Please try downloading it instead.</p></div>`;
        });
    }

    // Function to load Application PDF
    function loadApplicationPDF() {
        const url = "@Url.Content("~/ProposalTender/" + Model.Application.ApplicationDocument)";
        const pdfContainer = document.getElementById('applicationPdfContainer');

        // Check if PDF is already loaded
        if (pdfContainer.querySelector('canvas')) return;

        pdfContainer.innerHTML = `<div style="text-align:center;padding:2rem;"><div class="pdf-spinner"></div><p style="font-size:.82rem;color:var(--slate);">Loading document...</p></div>`;

        pdfjsLib.getDocument(url).promise.then(pdf => {
            pdfContainer.innerHTML = '';
            const scale = 1.5;
            const numPages = pdf.numPages;

            for (let pageNum = 1; pageNum <= numPages; pageNum++) {
                const pageContainer = document.createElement('div');
                pageContainer.className = 'mb-6 relative';

                const pageLabel = document.createElement('div');
                pageLabel.className = 'pdf-page-label';
                pageLabel.textContent = `Page ${pageNum} of ${numPages}`;

                const canvas = document.createElement('canvas');
                canvas.className = 'mx-auto shadow-md rounded-lg';

                pageContainer.appendChild(canvas);
                pageContainer.appendChild(pageLabel);
                pdfContainer.appendChild(pageContainer);

                pdf.getPage(pageNum).then(page => {
                    const viewport = page.getViewport({ scale });
                    canvas.height = viewport.height;
                    canvas.width = viewport.width;
                    const ctx = canvas.getContext('2d');
                    page.render({ canvasContext: ctx, viewport: viewport }).promise.then(() => {
                        console.log(`Application PDF Page ${pageNum} rendered successfully`);
                    }).catch(error => {
                        console.error(`Error rendering application PDF page ${pageNum}:`, error);
                    });
                });
            }
        }).catch(error => {
            console.error('Error loading application PDF:', error);
            pdfContainer.innerHTML = `<div class="pdf-error"><i class="fas fa-exclamation-circle"></i><h3>Error Loading PDF</h3><p>There was an error loading the application document. Please try downloading it instead.</p></div>`;
        });
    }

    document.addEventListener('DOMContentLoaded', function () {
        // Show details tab by default
        showTab('details');

        // Handle download button loading state
        const downloadButtons = document.querySelectorAll('.primary-button');
        if (downloadButtons) {
            downloadButtons.forEach(button => {
                button.addEventListener('click', function () {
                    this.classList.add('opacity-75', 'cursor-wait');
                    const icon = this.querySelector('i');
                    icon.classList.remove('fa-download');
                    icon.classList.add('fa-spinner', 'fa-spin');

                    // Reset button state after download starts
                    setTimeout(() => {
                        this.classList.remove('opacity-75', 'cursor-wait');
                        icon.classList.remove('fa-spinner', 'fa-spin');
                        icon.classList.add('fa-download');
                    }, 1000);
                });
            });
        }
    });
</script>


