@model TenderApplicationViewModel

<link href="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.2.1/flowbite.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.min.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

<style>
    :root {
        --navy: #0B1F3A;
        --navy-mid: #122848;
        --gold: #C8960C;
        --gold-lt: #E8B84B;
        --ivory: #F7F3EC;
        --slate: #8A9BB5;
        --white: #ffffff;
        --muted: #5a6a80;
    }

    .page-container *, .page-container *::before, .page-container *::after {
        box-sizing: border-box;
    }

    .page-container {
        padding-bottom: 4rem;
        animation: fadeIn .5s ease-out;
    }
    @@keyframes fadeIn {
        from

    {
        opacity: 0;
        transform: translateY(8px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    /* ── HERO ── */
    .tender-header {
        background: var(--navy);
        border-radius: 16px 16px 0 0;
        padding: 2.5rem 2rem 2rem;
        position: relative;
        overflow: hidden;
    }

        .tender-header::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(200,150,12,.05) 1px,transparent 1px), linear-gradient(90deg,rgba(200,150,12,.05) 1px,transparent 1px);
            background-size: 40px 40px;
            pointer-events: none;
        }

        .tender-header::after {
            content: '';
            position: absolute;
            top: -40%;
            right: -5%;
            width: 420px;
            height: 420px;
            background: radial-gradient(circle,rgba(200,150,12,.13) 0%,transparent 65%);
            pointer-events: none;
        }

        .tender-header > * {
            position: relative;
            z-index: 2;
        }

    .back-button {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        color: var(--slate);
        font-size: .82rem;
        font-weight: 600;
        background: none;
        border: none;
        cursor: pointer;
        text-decoration: none;
        font-family: 'DM Sans',sans-serif;
        transition: color .2s,transform .2s;
        padding: 0;
    }

        .back-button:hover {
            color: var(--gold-lt);
            transform: translateX(-3px);
            text-decoration: none;
        }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .35rem 1rem;
        border-radius: 999px;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .05em;
        text-transform: uppercase;
        transition: transform .2s,box-shadow .2s;
    }

        .status-badge:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(0,0,0,.15);
        }

    .status-won {
        background: linear-gradient(135deg,#10b981,#059669);
        color: white;
    }

    .status-lost {
        background: linear-gradient(135deg,#ef4444,#dc2626);
        color: white;
    }

    .status-pending {
        background: linear-gradient(135deg,#f59e0b,#d97706);
        color: white;
    }

    .tender-header h1 {
        font-family: 'Playfair Display',serif;
        font-size: clamp(1.4rem,3vw,2rem);
        font-weight: 900;
        color: var(--white);
        margin: .9rem 0 .6rem;
        line-height: 1.2;
    }

    .th-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 1.2rem;
        font-size: .8rem;
        color: rgba(255,255,255,.7);
    }

        .th-meta span {
            display: flex;
            align-items: center;
            gap: .4rem;
        }

        .th-meta i {
            color: var(--gold);
        }

    .contract-button {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        padding: .7rem 1.5rem;
        border-radius: 9px;
        background: var(--gold);
        color: var(--navy);
        font-weight: 700;
        font-size: .85rem;
        text-decoration: none;
        transition: background .2s,transform .2s,box-shadow .2s;
        box-shadow: 0 4px 14px rgba(200,150,12,.3);
        font-family: 'DM Sans',sans-serif;
    }

        .contract-button:hover {
            background: var(--gold-lt);
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(200,150,12,.4);
            text-decoration: none;
            color: var(--navy);
        }

    /* ── TABS ── */
    .tabs-container {
        background: var(--white);
        padding: 0 1.5rem;
        border-bottom: 1px solid rgba(11,31,58,.07);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .tabs-wrapper {
        display: flex;
        gap: .5rem;
    }

    .tab-button {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: 1.1rem 1.3rem;
        color: var(--muted);
        font-weight: 600;
        font-size: .83rem;
        background: none;
        border: none;
        cursor: pointer;
        border-bottom: 2px solid transparent;
        position: relative;
        top: 1px;
        transition: color .2s,border-color .2s;
        font-family: 'DM Sans',sans-serif;
    }

        .tab-button:hover {
            color: var(--navy);
        }

        .tab-button.active {
            color: var(--navy);
            border-bottom-color: var(--gold);
        }

    .tab-icon {
        width: 26px;
        height: 26px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .72rem;
    }

    .tab-icon-blue {
        background: rgba(59,130,246,.1);
        color: #3b82f6;
    }

    .tab-icon-green {
        background: rgba(16,185,129,.1);
        color: #10b981;
    }

    .tab-icon-red {
        background: rgba(239,68,68,.08);
        color: #ef4444;
    }

    .tab-icon-gold {
        background: rgba(200,150,12,.12);
        color: var(--gold);
    }

    /* ── CONTENT ── */
    .content-area {
        background: var(--white);
        border-radius: 0 0 16px 16px;
        box-shadow: 0 10px 40px rgba(11,31,58,.1);
    }

    .tab-content {
        animation: fadeIn .4s ease-out;
    }

    .hidden {
        display: none !important;
    }

    .content-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(300px,1fr));
        gap: 1.4rem;
        padding: 1.6rem;
    }

    /* ── INFO CARDS ── */
    .info-card {
        background: var(--white);
        border-radius: 12px;
        padding: 1.5rem;
        border: 1px solid rgba(11,31,58,.06);
        box-shadow: 0 4px 16px rgba(11,31,58,.06);
        transition: transform .25s,box-shadow .25s;
    }

        .info-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 28px rgba(11,31,58,.1);
        }

    .card-title {
        font-family: 'Playfair Display',serif;
        font-size: 1rem;
        font-weight: 900;
        color: var(--navy);
        margin-bottom: 1.2rem;
        display: flex;
        align-items: center;
        gap: .5rem;
    }

        .card-title i {
            color: var(--gold);
            font-size: .9rem;
        }

    /* publisher card */
    .publisher-card {
        text-align: center;
    }

    .publisher-photo {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        margin: 0 auto 1rem;
        border: 3px solid rgba(200,150,12,.25);
        object-fit: cover;
        box-shadow: 0 4px 14px rgba(11,31,58,.12);
    }

    .publisher-photo-placeholder {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        margin: 0 auto 1rem;
        background: rgba(200,150,12,.1);
        border: 3px solid rgba(200,150,12,.2);
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .publisher-photo-placeholder i {
            font-size: 2.2rem;
            color: var(--gold);
            opacity: .5;
        }

    .pub-name {
        font-family: 'Playfair Display',serif;
        font-size: 1.05rem;
        font-weight: 900;
        color: var(--navy);
        margin-bottom: .3rem;
    }

    .pub-role {
        display: inline-block;
        background: rgba(200,150,12,.1);
        color: var(--gold);
        border: 1px solid rgba(200,150,12,.2);
        padding: .2rem .8rem;
        border-radius: 999px;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
        margin-bottom: 1.1rem;
    }

    .contact-item {
        display: flex;
        align-items: center;
        gap: .65rem;
        padding: .45rem 0;
        font-size: .83rem;
        color: var(--muted);
        text-align: left;
    }

    .contact-icon {
        width: 28px;
        height: 28px;
        border-radius: 7px;
        background: rgba(200,150,12,.1);
        color: var(--gold);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .75rem;
        flex-shrink: 0;
    }

    .message-button {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: .65rem 1.4rem;
        border-radius: 9px;
        background: var(--navy);
        color: var(--white);
        font-size: .82rem;
        font-weight: 700;
        text-decoration: none;
        margin-top: 1rem;
        transition: background .2s,transform .2s,box-shadow .2s;
        box-shadow: 0 4px 14px rgba(11,31,58,.18);
        font-family: 'DM Sans',sans-serif;
    }

        .message-button:hover {
            background: var(--navy-mid);
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(11,31,58,.25);
            color: var(--white);
            text-decoration: none;
        }

        .message-button i {
            color: var(--gold-lt);
        }

    .info-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: .65rem 0;
        border-bottom: 1px solid rgba(11,31,58,.05);
        font-size: .84rem;
    }

        .info-item:last-child {
            border-bottom: none;
        }

    .info-label {
        color: var(--slate);
        font-weight: 500;
    }

    .info-value {
        font-weight: 700;
        color: var(--navy);
    }

        .info-value.green {
            color: #059669;
            font-family: 'Playfair Display',serif;
        }

    .ts-pill {
        display: inline-flex;
        align-items: center;
        gap: .25rem;
        padding: .18rem .7rem;
        border-radius: 999px;
        font-size: .68rem;
        font-weight: 700;
        letter-spacing: .05em;
        text-transform: uppercase;
    }

    .ts-open {
        background: #dcfce7;
        color: #166534;
    }

    .ts-closed {
        background: #fee2e2;
        color: #991b1b;
    }

    .ts-other {
        background: #fef3c7;
        color: #92400e;
    }

    .description-box {
        background: var(--ivory);
        border-radius: 10px;
        padding: 1.2rem;
        border-left: 3px solid var(--gold);
        margin-top: 1.1rem;
    }

        .description-box h4 {
            font-family: 'Playfair Display',serif;
            font-size: .95rem;
            font-weight: 900;
            color: var(--navy);
            margin-bottom: .6rem;
            display: flex;
            align-items: center;
            gap: .4rem;
        }

            .description-box h4 i {
                color: var(--gold);
            }

        .description-box p {
            font-size: .85rem;
            color: var(--muted);
            line-height: 1.7;
        }

    /* ── TIMELINE ── */
    .timeline-wrap {
        margin: 0 1.6rem 1.6rem;
    }

    .timeline-container {
        display: flex;
        justify-content: space-between;
        position: relative;
        padding: 1.5rem 0;
    }

        .timeline-container::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 2rem;
            right: 2rem;
            height: 2px;
            background: linear-gradient(90deg,var(--gold) 0%,rgba(200,150,12,.2) 100%);
            z-index: 0;
        }

    .timeline-item {
        flex: 1;
        text-align: center;
        position: relative;
        z-index: 1;
    }

    .timeline-point {
        width: 38px;
        height: 38px;
        background: var(--navy);
        border: 2px solid var(--gold);
        border-radius: 50%;
        margin: 0 auto .7rem;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        z-index: 1;
        transition: transform .25s,box-shadow .25s;
    }

    .timeline-item:hover .timeline-point {
        transform: scale(1.12);
        box-shadow: 0 4px 14px rgba(200,150,12,.3);
    }

    .timeline-point i {
        color: var(--gold);
        font-size: .78rem;
    }

    .tl-label {
        font-size: .72rem;
        font-weight: 700;
        color: var(--navy);
        letter-spacing: .04em;
        text-transform: uppercase;
    }

    .tl-date {
        font-size: .75rem;
        color: var(--slate);
        margin-top: .15rem;
    }

    /* ── APPLICATION TAB ── */
    .app-status-pill {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .35rem 1rem;
        border-radius: 999px;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .05em;
        text-transform: uppercase;
    }

    .app-status-won {
        background: #dcfce7;
        color: #166534;
    }

    .app-status-lost {
        background: #fee2e2;
        color: #991b1b;
    }

    .app-status-pending {
        background: #fef3c7;
        color: #92400e;
    }

    .congrats-box {
        background: linear-gradient(135deg,rgba(200,150,12,.06),rgba(200,150,12,.02));
        border: 1px solid rgba(200,150,12,.2);
        border-radius: 12px;
        padding: 1.4rem;
        margin-top: 1.2rem;
    }

        .congrats-box h3 {
            font-family: 'Playfair Display',serif;
            font-size: .95rem;
            color: var(--navy);
            font-weight: 900;
            margin-bottom: .5rem;
            display: flex;
            align-items: center;
            gap: .4rem;
        }

        .congrats-box p {
            font-size: .83rem;
            color: var(--muted);
            margin-bottom: 1rem;
        }

    .app-detail-card {
        background: var(--white);
        border-radius: 14px;
        border: 1px solid rgba(11,31,58,.07);
        box-shadow: 0 4px 20px rgba(11,31,58,.08);
        overflow: hidden;
        margin-bottom: 1.4rem;
    }

    .app-card-hd {
        background: var(--navy);
        padding: 1.1rem 1.5rem;
        display: flex;
        align-items: center;
        gap: .9rem;
    }

    .app-card-hd-icon {
        width: 38px;
        height: 38px;
        border-radius: 9px;
        background: rgba(200,150,12,.15);
        color: var(--gold);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        flex-shrink: 0;
    }

    .app-card-hd-title {
        font-family: 'Playfair Display',serif;
        font-size: .98rem;
        font-weight: 700;
        color: var(--white);
    }

    .app-card-hd-sub {
        font-size: .72rem;
        color: var(--slate);
        margin-top: .1rem;
    }

    .app-card-body {
        padding: .5rem 1.5rem 1rem;
    }

    .app-row {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        padding: .9rem 0;
        border-bottom: 1px solid rgba(11,31,58,.05);
    }

    .app-row-icon-wrap {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        background: rgba(200,150,12,.08);
        color: var(--gold);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .8rem;
        flex-shrink: 0;
        margin-top: .1rem;
    }

    .app-row-info {
        flex: 1;
        min-width: 0;
    }

    .app-row-label {
        font-size: .7rem;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--slate);
        margin-bottom: .2rem;
    }

    .app-row-value {
        font-size: .92rem;
        font-weight: 700;
        color: var(--navy);
    }

    /* ── WINNER COMPANY CARD (matches publisher style) ── */
    .winner-section {
        margin: 0 1.6rem 1.6rem;
    }

    .winner-card {
        background: var(--white);
        border-radius: 14px;
        border: 1px solid rgba(200,150,12,.2);
        box-shadow: 0 4px 20px rgba(11,31,58,.08);
        overflow: hidden;
    }

    .winner-card-hd {
        background: var(--navy);
        padding: 1.1rem 1.5rem;
        display: flex;
        align-items: center;
        gap: .9rem;
    }

    .winner-card-hd-icon {
        width: 38px;
        height: 38px;
        border-radius: 9px;
        background: rgba(200,150,12,.15);
        color: var(--gold);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        flex-shrink: 0;
    }

    .winner-card-hd-title {
        font-family: 'Playfair Display',serif;
        font-size: .98rem;
        font-weight: 700;
        color: var(--white);
    }

    .winner-card-hd-sub {
        font-size: .72rem;
        color: var(--slate);
        margin-top: .1rem;
    }

    .winner-card-body {
        padding: 1.4rem 1.5rem;
    }

    /* grid inside winner card — matches .tdp-grid */
    .winner-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(200px,1fr));
        gap: .75rem;
    }

    .winner-item {
        display: flex;
        align-items: flex-start;
        gap: .75rem;
        padding: .8rem 1rem;
        background: var(--ivory);
        border-radius: 8px;
        border: 1px solid rgba(11,31,58,.05);
        transition: background .2s,transform .2s;
        min-width: 0;
        overflow: hidden;
    }

        .winner-item:hover {
            background: rgba(200,150,12,.05);
            transform: translateX(4px);
        }

    .winner-item-icon {
        width: 32px;
        height: 32px;
        border-radius: 7px;
        background: rgba(200,150,12,.12);
        color: var(--gold);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .8rem;
        flex-shrink: 0;
        margin-top: .05rem;
    }

    .winner-item > div:last-child {
        min-width: 0;
        flex: 1;
    }

    .winner-item-label {
        font-size: .68rem;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--slate);
        margin-bottom: .2rem;
    }

    .winner-item-value {
        font-size: .88rem;
        font-weight: 600;
        color: var(--navy);
        line-height: 1.4;
        word-break: break-word;
        overflow-wrap: anywhere;
        min-width: 0;
    }

        .winner-item-value a {
            color: var(--gold);
            text-decoration: none;
            word-break: break-all;
            overflow-wrap: anywhere;
            display: inline-block;
            max-width: 100%;
        }

            .winner-item-value a:hover {
                text-decoration: underline;
            }

    .winner-trophy-banner {
        display: flex;
        align-items: center;
        gap: .75rem;
        padding: .9rem 1.2rem;
        margin-bottom: 1.2rem;
        background: linear-gradient(135deg,rgba(200,150,12,.1),rgba(200,150,12,.04));
        border: 1px solid rgba(200,150,12,.25);
        border-radius: 10px;
    }

    .winner-trophy-icon {
        font-size: 1.6rem;
        color: var(--gold);
        flex-shrink: 0;
    }

    .winner-trophy-text h4 {
        font-family: 'Playfair Display',serif;
        font-size: .92rem;
        font-weight: 900;
        color: var(--navy);
        margin: 0 0 .15rem;
    }

    .winner-trophy-text p {
        font-size: .78rem;
        color: var(--muted);
        margin: 0;
    }

    .winner-profile-btn {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .5rem 1.1rem;
        border-radius: 7px;
        background: var(--navy);
        color: var(--white);
        font-size: .8rem;
        font-weight: 600;
        text-decoration: none;
        margin-top: 1rem;
        transition: background .2s,transform .2s;
    }

        .winner-profile-btn:hover {
            background: var(--navy-mid);
            transform: translateY(-1px);
            color: var(--white);
            text-decoration: none;
        }

    /* ── DOCUMENTS TAB ── */
    .document-card {
        background: var(--white);
        border-radius: 12px;
        padding: 1.4rem;
        border: 1px solid rgba(11,31,58,.06);
        box-shadow: 0 4px 16px rgba(11,31,58,.06);
        margin-bottom: 1.4rem;
        transition: transform .25s,box-shadow .25s;
    }

        .document-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 28px rgba(11,31,58,.1);
        }

    .document-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid rgba(11,31,58,.06);
    }

    .document-title {
        display: flex;
        align-items: center;
        gap: .75rem;
    }

    .document-icon {
        width: 38px;
        height: 38px;
        border-radius: 9px;
        background: rgba(200,150,12,.1);
        color: var(--gold);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
    }

    .document-title h3 {
        font-weight: 700;
        color: var(--navy);
        font-size: .92rem;
        margin: 0 0 .15rem;
    }

    .document-title p {
        font-size: .73rem;
        color: var(--slate);
        margin: 0;
    }

    .action-button {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .55rem 1.1rem;
        border-radius: 8px;
        font-size: .78rem;
        font-weight: 700;
        cursor: pointer;
        transition: background .2s,transform .2s,box-shadow .2s;
        font-family: 'DM Sans',sans-serif;
        text-decoration: none;
    }

    .primary-button {
        background: var(--navy);
        color: var(--white);
        box-shadow: 0 3px 12px rgba(11,31,58,.18);
    }

        .primary-button i {
            color: var(--gold-lt);
        }

        .primary-button:hover {
            background: var(--navy-mid);
            transform: translateY(-1px);
            box-shadow: 0 5px 16px rgba(11,31,58,.25);
            color: var(--white);
            text-decoration: none;
        }

    .pdf-viewer {
        background: var(--ivory);
        border-radius: 10px;
        padding: 1.2rem;
        height: 800px;
        overflow-y: auto;
        border: 1px solid rgba(11,31,58,.07);
        scrollbar-width: thin;
        scrollbar-color: var(--gold) transparent;
    }

        .pdf-viewer::-webkit-scrollbar {
            width: 5px;
        }

        .pdf-viewer::-webkit-scrollbar-thumb {
            background: var(--gold);
            border-radius: 99px;
        }

    .pdf-container {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        align-items: center;
    }

        .pdf-container canvas {
            max-width: 100%;
            height: auto;
            box-shadow: 0 4px 14px rgba(11,31,58,.1);
            border-radius: 8px;
        }

    .pdf-spinner {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: 3px solid rgba(200,150,12,.15);
        border-top-color: var(--gold);
        animation: spin .8s linear infinite;
        margin: 0 auto .8rem;
    }
    @@keyframes spin {
        to

    {
        transform: rotate(360deg);
    }

    }

    .pdf-error {
        text-align: center;
        padding: 2rem;
    }

        .pdf-error i {
            font-size: 2.5rem;
            color: #ef4444;
            margin-bottom: .7rem;
            display: block;
        }

        .pdf-error h3 {
            font-family: 'Playfair Display',serif;
            color: var(--navy);
            margin-bottom: .4rem;
            font-size: .95rem;
        }

        .pdf-error p {
            font-size: .82rem;
            color: var(--slate);
        }

    .pdf-page-label {
        position: absolute;
        top: 8px;
        right: 8px;
        background: var(--navy);
        color: var(--gold-lt);
        font-size: .65rem;
        font-weight: 700;
        padding: .2rem .55rem;
        border-radius: 5px;
    }

    @@media (max-width:768px) {
        .tender-header

    {
        padding: 1.8rem 1.2rem 1.5rem;
    }

    .content-grid {
        padding: 1rem;
    }

    .document-header {
        flex-direction: column;
        align-items: flex-start;
        gap: .75rem;
    }

    .winner-grid {
        grid-template-columns: 1fr;
    }

    .winner-section {
        margin: 0 .75rem 1.4rem;
    }

    }
</style>

<div class="page-container">

    <!-- HERO -->
    <div class="tender-header">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:.8rem;">
            <a asp-action="TenderBidTab" asp-controller="BidTender" asp-route-activeTab="UpcomingTender" class="back-button">
                <i class="fas fa-arrow-left"></i><span>Back</span>
            </a>
            <span class="status-badge status-@Model.Application.ApplicationStatus.ToLower()">
                <i class="fas @(Model.Application.ApplicationStatus.ToLower() == "won"  ? "fa-trophy" :
                                                   Model.Application.ApplicationStatus.ToLower() == "lost" ? "fa-times-circle" : "fa-hourglass-half")"></i>
                @Model.Application.ApplicationStatus
            </span>
        </div>
        <h1>@Model.Tender.Title</h1>
        <div class="th-meta">
            <span><i class="fas fa-hashtag"></i> Tender ID: @Model.Tender.TenderId</span>
            <span><i class="fas fa-file-alt"></i> Application ID: @Model.Application.ApplicationId</span>
        </div>
    </div>

    <!-- TABS -->
    <div class="tabs-container">
        <div class="tabs-wrapper">
            <button onclick="showTab('details')" class="tab-button active" id="details-tab-btn">
                <span class="tab-icon tab-icon-blue"><i class="fas fa-info-circle"></i></span> Details
            </button>
            <button onclick="showTab('application')" class="tab-button" id="application-tab-btn">
                <span class="tab-icon tab-icon-green"><i class="fas fa-file-alt"></i></span> Application
            </button>
            <button onclick="showTab('documents')" class="tab-button" id="documents-tab-btn">
                <span class="tab-icon tab-icon-red"><i class="fas fa-file-pdf"></i></span> Documents
            </button>
            @if (Model.Tender.AwardedCompany != null)
            {
                <button onclick="showTab('winner')" class="tab-button" id="winner-tab-btn">
                    <span class="tab-icon tab-icon-gold"><i class="fas fa-trophy"></i></span> Winner
                </button>
            }
        </div>
    </div>

    <!-- CONTENT -->
    <div class="content-area">

        <!-- ── DETAILS TAB ── -->
        <div id="details-tab" class="tab-content">
            <div class="content-grid">

                <!-- Publisher Card -->
                <div class="info-card publisher-card">
                    @if (!string.IsNullOrEmpty(Model.User.UserPhoto))
                    {
                        <img src="@Url.Content("~/UserImage/" + Model.User.UserPhoto)" alt="Publisher" class="publisher-photo" />
                    }
                    else
                    {
                        <div class="publisher-photo-placeholder"><i class="fas fa-user"></i></div>
                    }
                    <div class="pub-name">@Model.User.FirstName @Model.User.MiddleName @Model.User.LastName</div>
                    <span class="pub-role">@Model.User.UserRole</span>
                    <div>
                        <div class="contact-item"><div class="contact-icon"><i class="fas fa-envelope"></i></div><span>@Model.User.EmailAddress</span></div>
                        <div class="contact-item"><div class="contact-icon"><i class="fas fa-phone"></i></div><span>@Model.User.Phone</span></div>
                        <div class="contact-item"><div class="contact-icon"><i class="fas fa-map-marker-alt"></i></div><span>@Model.User.City, @Model.User.District</span></div>
                    </div>
                    <a asp-action="UserMessage" asp-controller="Chat" asp-route-receiverId="@Model.User.UserId" class="message-button">
                        <i class="fas fa-paper-plane"></i> Send Message
                    </a>
                </div>

                <!-- Tender Info -->
                <div class="info-card">
                    <div class="card-title"><i class="fas fa-info-circle"></i> Tender Information</div>
                    <div class="info-item"><span class="info-label">Type</span><span class="info-value">@Model.Tender.TenderType</span></div>
                    <div class="info-item"><span class="info-label">Duration</span><span class="info-value">@Model.Tender.ProjectDuration</span></div>
                    <div class="info-item"><span class="info-label">Budget</span><span class="info-value green">Rs. @Model.Tender.BudgetEstimation.ToString("N2")</span></div>
                    <div class="info-item">
                        <span class="info-label">Status</span>
                        <span class="ts-pill @(Model.Tender.TenderStatus.ToLower() == "open" ? "ts-open" : Model.Tender.TenderStatus.ToLower() == "closed" ? "ts-closed" : "ts-other")">@Model.Tender.TenderStatus</span>
                    </div>
                    <div class="description-box">
                        <h4><i class="fas fa-align-left"></i> Project Description</h4>
                        <p>@Model.Tender.TenderDescription</p>
                    </div>
                </div>
            </div>

            <!-- Timeline -->
            <div class="timeline-wrap">
                <div class="info-card">
                    <div class="card-title"><i class="fas fa-clock"></i> Timeline</div>
                    <div class="timeline-container">
                        <div class="timeline-item">
                            <div class="timeline-point"><i class="fas fa-flag"></i></div>
                            <div class="tl-label">Issue Date</div>
                            <div class="tl-date">@Model.Tender.IssuedDate.ToString("MMM dd, yyyy")</div>
                        </div>
                        <div class="timeline-item">
                            <div class="timeline-point"><i class="fas fa-door-open"></i></div>
                            <div class="tl-label">Opening Date</div>
                            <div class="tl-date">@Model.Tender.OpeningDate.ToString("MMM dd, yyyy")</div>
                        </div>
                        <div class="timeline-item">
                            <div class="timeline-point"><i class="fas fa-lock"></i></div>
                            <div class="tl-label">Closing Date</div>
                            <div class="tl-date">@Model.Tender.ClosingDate.ToString("MMM dd, yyyy")</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── APPLICATION TAB ── -->
        <div id="application-tab" class="tab-content hidden">
            <div style="padding:1.6rem;">
                <div class="app-detail-card">
                    <div class="app-card-hd">
                        <div class="app-card-hd-icon"><i class="fas fa-file-alt"></i></div>
                        <div>
                            <div class="app-card-hd-title">Application Details</div>
                            <div class="app-card-hd-sub">Your submitted proposal summary</div>
                        </div>
                    </div>
                    <div class="app-card-body">
                        <div class="app-row">
                            <div class="app-row-icon-wrap"><i class="fas fa-hashtag"></i></div>
                            <div class="app-row-info"><div class="app-row-label">Application ID</div><div class="app-row-value">#@Model.Application.ApplicationId</div></div>
                        </div>
                        <div class="app-row">
                            <div class="app-row-icon-wrap"><i class="fas fa-hourglass-half"></i></div>
                            <div class="app-row-info"><div class="app-row-label">Proposed Duration</div><div class="app-row-value">@Model.Application.ProposedDuration</div></div>
                        </div>
                        <div class="app-row">
                            <div class="app-row-icon-wrap"><i class="fas fa-rupee-sign"></i></div>
                            <div class="app-row-info">
                                <div class="app-row-label">Proposed Budget</div>
                                <div class="app-row-value" style="color:var(--gold);font-family:'Playfair Display',serif;">Rs. @Model.Application.ProposedBudget.ToString("N2")</div>
                            </div>
                        </div>
                        <div class="app-row" style="border-bottom:none;">
                            <div class="app-row-icon-wrap"><i class="fas fa-info-circle"></i></div>
                            <div class="app-row-info">
                                <div class="app-row-label">Status</div>
                                <div style="margin-top:.4rem;">
                                    <span class="app-status-pill app-status-@Model.Application.ApplicationStatus.ToLower()">
                                        <i class="fas @(Model.Application.ApplicationStatus.ToLower() == "won"  ? "fa-trophy" :
                                                                                                   Model.Application.ApplicationStatus.ToLower() == "lost" ? "fa-times-circle" : "fa-hourglass-half")"></i>
                                        @Model.Application.ApplicationStatus
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @if (Model.Application.ApplicationStatus.ToLower() == "won")
                {
                    <div class="congrats-box">
                        <h3><i class="fas fa-trophy" style="color:var(--gold);"></i> Congratulations!</h3>
                        <p>Your application has been accepted. You can now generate a contract for this tender.</p>
                        <a asp-action="Index" asp-controller="TenderContract" asp-route-id="@Model.Application.EncId" class="contract-button">
                            <i class="fas fa-file-contract"></i> Generate Contract
                        </a>
                    </div>
                }
            </div>
        </div>

        <!-- ── DOCUMENTS TAB ── -->
        <div id="documents-tab" class="tab-content hidden">
            <div style="padding:1.6rem;">

                <div class="document-card">
                    <div class="document-header">
                        <div class="document-title">
                            <div class="document-icon"><i class="fas fa-file-pdf"></i></div>
                            <div><h3>Tender Document</h3><p>Original tender document published by the issuer</p></div>
                        </div>
                        <a href="@Url.Content("~/TenderDocument/" + Model.Tender.TenderDocument)" class="action-button primary-button" download>
                            <i class="fas fa-download"></i> Download
                        </a>
                    </div>
                    <div class="pdf-viewer">
                        <div id="tenderPdfContainer" class="pdf-container">
                            <div style="text-align:center;padding:2rem;"><div class="pdf-spinner"></div><p style="font-size:.82rem;color:var(--slate);">Loading document...</p></div>
                        </div>
                    </div>
                </div>

                <div class="document-card">
                    <div class="document-header">
                        <div class="document-title">
                            <div class="document-icon"><i class="fas fa-file-alt"></i></div>
                            <div><h3>Application Document</h3><p>Your submitted proposal document</p></div>
                        </div>
                        <a href="@Url.Content("~/ProposalTender/" + Model.Application.ApplicationDocument)" class="action-button primary-button" download>
                            <i class="fas fa-download"></i> Download
                        </a>
                    </div>
                    <div class="pdf-viewer">
                        <div id="applicationPdfContainer" class="pdf-container">
                            <div style="text-align:center;padding:2rem;"><div class="pdf-spinner"></div><p style="font-size:.82rem;color:var(--slate);">Loading document...</p></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── WINNER TAB ── -->
        @if (Model.Tender.AwardedCompany != null)
        {
            <div id="winner-tab" class="tab-content hidden">
                <div class="winner-section" style="padding-top:1.6rem;">

                    <div class="winner-card">
                        <div class="winner-card-hd">
                            <div class="winner-card-hd-icon"><i class="fas fa-trophy"></i></div>
                            <div>
                                <div class="winner-card-hd-title">Awarded Company</div>
                                <div class="winner-card-hd-sub">Details of the company that won this tender</div>
                            </div>
                        </div>
                        <div class="winner-card-body">

                            <!-- Trophy banner -->
                            <div class="winner-trophy-banner">
                                <i class="fas fa-trophy winner-trophy-icon"></i>
                                <div class="winner-trophy-text">
                                    <h4>@Model.Tender.AwardedCompany.CompanyName</h4>
                                    <p>This company has been selected as the winner of this tender.</p>
                                </div>
                            </div>

                            <!-- Info grid matching publisher style -->
                            <div class="winner-grid">
                                <div class="winner-item">
                                    <div class="winner-item-icon"><i class="fas fa-building"></i></div>
                                    <div><div class="winner-item-label">Company Name</div><div class="winner-item-value">@Model.Tender.AwardedCompany.CompanyName</div></div>
                                </div>
                                <div class="winner-item">
                                    <div class="winner-item-icon"><i class="fas fa-briefcase"></i></div>
                                    <div><div class="winner-item-label">Company Type</div><div class="winner-item-value">@Model.Tender.AwardedCompany.CompanyType</div></div>
                                </div>
                                <div class="winner-item">
                                    <div class="winner-item-icon"><i class="fas fa-map-marker-alt"></i></div>
                                    <div><div class="winner-item-label">Address</div><div class="winner-item-value">@Model.Tender.AwardedCompany.FullAddress</div></div>
                                </div>
                                <div class="winner-item">
                                    <div class="winner-item-icon"><i class="fas fa-envelope"></i></div>
                                    <div><div class="winner-item-label">Email</div><div class="winner-item-value">@Model.Tender.AwardedCompany.OfficeEmail</div></div>
                                </div>
                                <div class="winner-item">
                                    <div class="winner-item-icon"><i class="fas fa-globe"></i></div>
                                    <div>
                                        <div class="winner-item-label">Website</div>
                                        <div class="winner-item-value">
                                            @if (!string.IsNullOrEmpty(Model.Tender.AwardedCompany.CompanyWebsiteUrl))
                                            {
                                                <a href="@Model.Tender.AwardedCompany.CompanyWebsiteUrl" target="_blank">@Model.Tender.AwardedCompany.CompanyWebsiteUrl</a>
                                            }
                                            else
                                            {

                                                <span style="color:var(--slate);">Not provided</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="winner-item">
                                    <div class="winner-item-icon"><i class="fas fa-star"></i></div>
                                    <div><div class="winner-item-label">Rating</div><div class="winner-item-value">@(Model.Tender.AwardedCompany.Rating?.ToString("N1") ?? "Not rated") / 5.0</div></div>
                                </div>
                            </div>

                            
                        </div>
                    </div>

                </div>
            </div>
        }

    </div><!-- /content-area -->
</div><!-- /page-container -->

<script>
    pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.worker.min.js';

    function showTab(tabName) {
        document.querySelectorAll('.tab-content').forEach(t => t.classList.add('hidden'));
        document.querySelectorAll('.tab-button').forEach(b => b.classList.remove('active'));
        document.getElementById(`${tabName}-tab`).classList.remove('hidden');
        document.getElementById(`${tabName}-tab-btn`).classList.add('active');
        if (tabName === 'documents') { loadTenderPDF(); loadApplicationPDF(); }
    }

    function renderPDF(url, containerId) {
        const container = document.getElementById(containerId);
        if (container.querySelector('canvas')) return;
        container.innerHTML = `<div style="text-align:center;padding:2rem;"><div class="pdf-spinner"></div><p style="font-size:.82rem;color:var(--slate);">Loading document...</p></div>`;
        pdfjsLib.getDocument(url).promise.then(pdf => {
            container.innerHTML = '';
            for (let p = 1; p <= pdf.numPages; p++) {
                const wrap   = document.createElement('div'); wrap.className = 'mb-6 relative';
                const label  = document.createElement('div'); label.className = 'pdf-page-label'; label.textContent = `Page ${p} of ${pdf.numPages}`;
                const canvas = document.createElement('canvas'); canvas.className = 'mx-auto shadow-md rounded-lg';
                wrap.appendChild(canvas); wrap.appendChild(label); container.appendChild(wrap);
                pdf.getPage(p).then(page => {
                    const vp = page.getViewport({ scale: 1.5 });
                    canvas.height = vp.height; canvas.width = vp.width;
                    page.render({ canvasContext: canvas.getContext('2d'), viewport: vp });
                });
            }
        }).catch(() => {
            container.innerHTML = `<div class="pdf-error"><i class="fas fa-exclamation-circle"></i><h3>Error Loading PDF</h3><p>Please try downloading instead.</p></div>`;
        });
    }

    function loadTenderPDF()      { renderPDF("@Url.Content("~/TenderDocument/" + Model.Tender.TenderDocument)",        'tenderPdfContainer'); }
    function loadApplicationPDF() { renderPDF("@Url.Content("~/ProposalTender/" + Model.Application.ApplicationDocument)", 'applicationPdfContainer'); }

    document.addEventListener('DOMContentLoaded', () => showTab('details'));
</script>
