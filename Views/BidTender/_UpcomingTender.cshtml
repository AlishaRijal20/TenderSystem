@model IEnumerable<TenderEdit>

@{
    ViewData["Title"] = "Upcoming Tenders";
}

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

<style>
    :root {
        --navy: #0B1F3A;
        --navy-mid: #122848;
        --gold: #C8960C;
        --gold-lt: #E8B84B;
        --ivory: #F7F3EC;
        --slate: #8A9BB5;
        --white: #ffffff;
        --muted: #5a6a80;
    }

    .ut-wrap {
        padding: 2rem;
        font-family: 'DM Sans', sans-serif;
        background: var(--ivory);
    }

    /* section header */
    .ut-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 1.8rem;
    }

    .ut-header-left {
        display: flex;
        align-items: center;
        gap: .75rem;
    }

    .ut-section-icon {
        width: 38px;
        height: 38px;
        border-radius: 9px;
        background: rgba(200,150,12,.12);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--gold);
        font-size: .95rem;
    }

    .ut-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.15rem;
        font-weight: 900;
        color: var(--navy);
        margin: 0;
    }

    .ut-count {
        font-size: .75rem;
        font-weight: 600;
        color: var(--slate);
        letter-spacing: .06em;
        text-transform: uppercase;
    }

    .ut-back {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .5rem 1rem;
        border-radius: 7px;
        background: var(--navy);
        color: var(--white);
        font-size: .8rem;
        font-weight: 600;
        text-decoration: none;
        transition: background .2s, transform .2s;
    }

        .ut-back:hover {
            background: var(--navy-mid);
            transform: translateY(-1px);
            color: var(--white);
            text-decoration: none;
        }

    /* GRID */
    .ut-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 1.4rem;
    }

    /* CARD */
    .ut-card {
        background: var(--white);
        border-radius: 14px;
        border: 1px solid rgba(11,31,58,.07);
        box-shadow: 0 4px 18px rgba(11,31,58,.07);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: transform .25s, box-shadow .25s;
    }

        .ut-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 14px 36px rgba(11,31,58,.13);
        }

    /* navy top strip */
    .ut-card-top {
        background: var(--navy);
        padding: .7rem 1.2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .ut-card-id {
        font-family: 'Playfair Display', serif;
        font-size: .82rem;
        font-weight: 700;
        color: var(--gold-lt);
    }

    .ut-card-badge {
        display: inline-flex;
        align-items: center;
        gap: .25rem;
        padding: .2rem .65rem;
        border-radius: 999px;
        background: rgba(200,150,12,.18);
        font-size: .62rem;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
        color: var(--gold-lt);
    }

    /* body */
    .ut-card-body {
        padding: 1.2rem;
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .ut-card-title {
        font-family: 'Playfair Display', serif;
        font-size: 1rem;
        font-weight: 700;
        color: var(--navy);
        margin: 0 0 .5rem;
        line-height: 1.35;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .ut-card-desc {
        font-size: .82rem;
        color: var(--muted);
        line-height: 1.6;
        margin-bottom: .75rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .ut-card-issuer {
        display: flex;
        align-items: center;
        gap: .35rem;
        font-size: .8rem;
        color: var(--muted);
        margin-bottom: 1rem;
    }

        .ut-card-issuer i {
            color: var(--gold);
            font-size: .78rem;
        }

    /* dates row */
    .ut-dates {
        display: flex;
        gap: .75rem;
        flex-wrap: wrap;
        margin-top: auto;
        padding-top: .9rem;
        border-top: 1px solid rgba(11,31,58,.06);
        margin-bottom: .9rem;
    }

    .ut-date-pill {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        padding: .28rem .7rem;
        border-radius: 6px;
        font-size: .73rem;
        font-weight: 600;
        flex: 1;
        min-width: 0;
        justify-content: center;
    }

    .ut-date-open {
        background: rgba(16,185,129,.08);
        color: #059669;
    }

    .ut-date-close {
        background: rgba(239,68,68,.08);
        color: #dc2626;
    }

    /* footer */
    .ut-card-footer {
        padding: .9rem 1.2rem;
        border-top: 1px solid rgba(11,31,58,.05);
        display: flex;
        gap: .75rem;
    }

    .ut-btn {
        flex: 1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .4rem;
        padding: .65rem 1rem;
        border-radius: 8px;
        font-size: .82rem;
        font-weight: 700;
        text-decoration: none;
        transition: background .2s, transform .2s, box-shadow .2s;
    }

    .ut-btn-view {
        background: var(--navy);
        color: var(--white);
        box-shadow: 0 3px 10px rgba(11,31,58,.15);
    }

        .ut-btn-view:hover {
            background: var(--navy-mid);
            transform: translateY(-1px);
            box-shadow: 0 6px 18px rgba(11,31,58,.22);
            color: var(--white);
            text-decoration: none;
        }

    /* empty */
    .ut-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 4rem 2rem;
        text-align: center;
    }

        .ut-empty i {
            font-size: 2.5rem;
            color: var(--gold);
            opacity: .35;
            margin-bottom: 1rem;
        }

        .ut-empty p {
            font-family: 'Playfair Display', serif;
            font-size: 1rem;
            color: var(--navy);
            margin-bottom: .3rem;
        }

        .ut-empty span {
            font-size: .85rem;
            color: var(--slate);
        }

    @@media (max-width: 768px) {
        .ut-wrap {
            padding: 1.2rem 1rem;
        }

        .ut-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="ut-wrap">

    <div class="ut-header">
        <div class="ut-header-left">
            <div class="ut-section-icon"><i class="fas fa-calendar-alt"></i></div>
            <div>
                <h2 class="ut-title">Upcoming Tenders</h2>
                <span class="ut-count">@Model.Count() tender@(Model.Count() != 1 ? "s" : "") listed</span>
            </div>
        </div>
        <a asp-action="Index" asp-controller="BidTender" class="ut-back">
            <i class="fas fa-arrow-left"></i> Back
        </a>
    </div>

    @if (Model.Any())
    {
        <div class="ut-grid">
            @foreach (var tender in Model)
            {
                <div class="ut-card">
                    <div class="ut-card-top">
                        <span class="ut-card-id">#@tender.TenderId</span>
                        <span class="ut-card-badge"><i class="fas fa-tag"></i> @tender.TenderType</span>
                    </div>
                    <div class="ut-card-body">
                        <h5 class="ut-card-title">@tender.Title</h5>
                        <p class="ut-card-desc">@tender.TenderDescription</p>
                        <p class="ut-card-issuer">
                            <i class="fas fa-building"></i>
                            @tender.IssuedBy
                        </p>
                        <div class="ut-dates">
                            <span class="ut-date-pill ut-date-open">
                                <i class="fas fa-calendar-check"></i>
                                @tender.OpeningDate.ToString("MM/dd/yyyy")
                            </span>
                            <span class="ut-date-pill ut-date-close">
                                <i class="fas fa-calendar-times"></i>
                                @tender.ClosingDate.ToString("MM/dd/yyyy")
                            </span>
                        </div>
                    </div>
                    <div class="ut-card-footer">
                        <a asp-action="BidderTenderDetails" asp-controller="BidTender" asp-route-id="@tender.EncId"
                           class="ut-btn ut-btn-view">
                            <i class="fas fa-eye"></i> View Details
                        </a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="ut-empty">
            <i class="fas fa-calendar-alt"></i>
            <p>No upcoming tenders</p>
            <span>There are no upcoming tenders available at the moment. Check back soon.</span>
        </div>
    }

</div>
