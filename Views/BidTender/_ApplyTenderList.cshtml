@model IEnumerable<TenderEdit>

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

<style>
    :root {
        --navy: #0B1F3A;
        --navy-mid: #122848;
        --gold: #C8960C;
        --gold-lt: #E8B84B;
        --ivory: #F7F3EC;
        --slate: #8A9BB5;
        --white: #ffffff;
        --muted: #5a6a80;
    }

    .at-wrap {
        padding: 2rem;
        font-family: 'DM Sans', sans-serif;
        background: var(--ivory);
    }

    /* header */
    .at-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .at-header-left {
        display: flex;
        align-items: center;
        gap: .75rem;
    }

    .at-section-icon {
        width: 38px;
        height: 38px;
        border-radius: 9px;
        background: rgba(239,68,68,.1);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ef4444;
        font-size: .95rem;
    }

    .at-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.15rem;
        font-weight: 900;
        color: var(--navy);
        margin: 0;
    }

    .at-count {
        font-size: .75rem;
        font-weight: 600;
        color: var(--slate);
        letter-spacing: .06em;
        text-transform: uppercase;
    }

    .at-back {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .5rem 1rem;
        border-radius: 7px;
        background: var(--navy);
        color: var(--white);
        font-size: .8rem;
        font-weight: 600;
        text-decoration: none;
        transition: background .2s, transform .2s;
    }

        .at-back:hover {
            background: var(--navy-mid);
            transform: translateY(-1px);
            color: var(--white);
            text-decoration: none;
        }

    /* toolbar */
    .at-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: .75rem;
        margin-bottom: 1.2rem;
    }

    .at-filters {
        display: flex;
        gap: .75rem;
        flex-wrap: wrap;
    }

    .at-select,
    .at-search {
        padding: .55rem 1rem;
        border: 1.5px solid rgba(11,31,58,.12);
        border-radius: 8px;
        font-size: .82rem;
        color: var(--navy);
        background: var(--white);
        font-family: 'DM Sans', sans-serif;
        outline: none;
        transition: border-color .2s, box-shadow .2s;
        min-width: 160px;
    }

        .at-select:focus,
        .at-search:focus {
            border-color: var(--gold);
            box-shadow: 0 0 0 3px rgba(200,150,12,.1);
        }

    .at-result-count {
        font-size: .8rem;
        font-weight: 600;
        color: var(--slate);
        white-space: nowrap;
    }

    /* table card */
    .at-table-card {
        background: var(--white);
        border-radius: 14px;
        border: 1px solid rgba(11,31,58,.07);
        box-shadow: 0 4px 24px rgba(11,31,58,.06);
        overflow: hidden;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    /* table head */
    thead tr {
        background: var(--navy);
    }

    thead th {
        padding: 1rem 1.2rem;
        font-size: .7rem;
        font-weight: 700;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: var(--white);
        text-align: center;
        white-space: nowrap;
    }

        thead th i {
            color: var(--gold);
            margin-right: .35rem;
        }

    /* table body */
    tbody tr {
        border-bottom: 1px solid rgba(11,31,58,.05);
        transition: background .15s;
    }

        tbody tr:last-child {
            border-bottom: none;
        }

        tbody tr:hover {
            background: rgba(200,150,12,.03);
        }

    tbody td {
        padding: 1rem 1.2rem;
        font-size: .84rem;
        color: var(--navy);
        text-align: center;
        vertical-align: middle;
    }

    .at-td-id {
        font-family: 'Playfair Display', serif;
        font-weight: 700;
        color: var(--navy);
    }

    .at-td-title {
        max-width: 200px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        font-weight: 500;
    }

    .at-td-muted {
        color: var(--muted);
    }

    /* status badges */
    .at-status {
        display: inline-block;
        padding: .28rem .85rem;
        border-radius: 999px;
        font-size: .7rem;
        font-weight: 700;
        letter-spacing: .05em;
        text-transform: uppercase;
        min-width: 90px;
        text-align: center;
    }

    .at-status-won {
        background: #dcfce7;
        color: #166534;
    }

    .at-status-pending {
        background: #fef3c7;
        color: #92400e;
    }

    .at-status-lost {
        background: #fee2e2;
        color: #991b1b;
    }

    .at-status-na {
        background: #f3f4f6;
        color: #6b7280;
    }

    /* action button */
    .at-view-btn {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .45rem .95rem;
        border-radius: 7px;
        background: var(--navy);
        color: var(--white);
        font-size: .78rem;
        font-weight: 700;
        text-decoration: none;
        transition: background .2s, transform .2s, box-shadow .2s;
        box-shadow: 0 2px 8px rgba(11,31,58,.15);
    }

        .at-view-btn:hover {
            background: var(--navy-mid);
            transform: translateY(-1px);
            box-shadow: 0 5px 14px rgba(11,31,58,.22);
            color: var(--white);
            text-decoration: none;
        }

        .at-view-btn i {
            color: var(--gold-lt);
            font-size: .75rem;
        }

    /* no results row */
    #noResults td {
        padding: 3rem;
        color: var(--slate);
        font-family: 'Playfair Display', serif;
    }

    /* empty full state */
    .at-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 4rem;
        text-align: center;
    }

        .at-empty i {
            font-size: 2.5rem;
            color: #ef4444;
            opacity: .3;
            margin-bottom: 1rem;
        }

        .at-empty p {
            font-family: 'Playfair Display', serif;
            font-size: 1rem;
            color: var(--navy);
            margin-bottom: .3rem;
        }

        .at-empty span {
            font-size: .85rem;
            color: var(--slate);
        }

    @@media (max-width: 900px) {
        .at-wrap {
            padding: 1.2rem .75rem;
        }

        thead th:nth-child(3),
        thead th:nth-child(4),
        tbody td:nth-child(3),
        tbody td:nth-child(4) {
            display: none;
        }
    }
</style>

<div class="at-wrap">

    <div class="at-header">
        <div class="at-header-left">
            <div class="at-section-icon"><i class="fas fa-file-signature"></i></div>
            <div>
                <h2 class="at-title">Applied Tenders</h2>
                <span class="at-count">@Model.Count() application@(Model.Count() != 1 ? "s" : "")</span>
            </div>
        </div>
        <a asp-action="Index" asp-controller="BidTender" class="at-back">
            <i class="fas fa-arrow-left"></i> Back
        </a>
    </div>

    @if (Model.Any())
    {
        <div class="at-toolbar">
            <div class="at-filters">
                <select id="typeFilter" class="at-select" onchange="filterByType()">
                    <option value="">All Statuses</option>
                    <option value="Won">Won</option>
                    <option value="Lost">Lost</option>
                    <option value="Pending">Pending</option>
                </select>
                <input type="text" id="searchInput" placeholder="Search tenders…"
                       class="at-search" onkeyup="searchTable()" />
            </div>
            <div class="at-result-count" id="resultCount"></div>
        </div>

        <div class="at-table-card">
            <div style="overflow-x:auto;">
                <table id="tenderTable">
                    <thead>
                        <tr>
                            <th><i class="fas fa-hashtag"></i>Tender ID</th>
                            <th><i class="fas fa-file-alt"></i>Title</th>
                            <th><i class="fas fa-rupee-sign"></i>Proposed Budget</th>
                            <th><i class="fas fa-clock"></i>Proposed Duration</th>
                            <th><i class="fas fa-chart-pie"></i>Status</th>
                            <th><i class="fas fa-cogs"></i>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tender in Model)
                        {
                            <tr class="tender-card"
                                data-type="@tender.Application.ApplicationStatus.ToLower()"
                                data-title="@tender.Title.ToLower()">
                                <td class="at-td-id">#@tender.TenderId</td>
                                <td>
                                    <span class="at-td-title" title="@tender.Title">@tender.Title</span>
                                </td>
                                <td class="at-td-muted">&#8377;@tender.Application.ProposedBudget.ToString("N2")</td>
                                <td class="at-td-muted">@tender.Application.ProposedDuration</td>
                                <td>
                                    <span class="at-status
                                                @(tender.Application.ApplicationStatus == "Won" ? "at-status-won" :
                                                                                    tender.Application.ApplicationStatus == "Pending" ? "at-status-pending" :
                                                                                    !string.IsNullOrEmpty(tender.Application.ApplicationStatus) ? "at-status-lost" : "at-status-na")">
                                @(string.IsNullOrEmpty(tender.Application.ApplicationStatus) ? "Not Available" : tender.Application.ApplicationStatus)
                            </span>
                        </td>
                        <td>
                            <a asp-action="ApplyTenderDetails" asp-controller="BidTender"
                               asp-route-id="@tender.EncId" class="at-view-btn">
                                <i class="fas fa-eye"></i> View Details
                            </a>
                        </td>
                    </tr>
                                        }
                        <tr id="noResults" class="hidden">
                            <td colspan="6" class="text-center">
                                <i class="fas fa-search" style="color:var(--gold);opacity:.35;font-size:1.5rem;display:block;margin-bottom:.5rem;"></i>
                                No results found
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="at-empty">
            <i class="fas fa-file-signature"></i>
            <p>No applications yet</p>
            <span>You haven't applied to any tenders. Browse open tenders to get started.</span>
        </div>
    }

</div>

<script>
    // Function to search the table by tender title
    function searchTable() {
        const searchValue = document.getElementById("searchInput").value.toLowerCase();
        const rows = document.querySelectorAll("#tenderTable tbody tr:not(#noResults)");

        rows.forEach(row => {
            const title = row.cells[1].textContent.toLowerCase();
            if (title.includes(searchValue)) {
                row.style.display = "";
            } else {
                row.style.display = "none";
            }
        });
    }

    function filterByType() {
        const selectedType = document.getElementById("typeFilter").value;
        const rows = document.querySelectorAll("#tenderTable tbody tr:not(#noResults)");
        const noResults = document.getElementById("noResults");
        let visibleCount = 0;

        rows.forEach(row => {
            const type = row.getAttribute("data-type");
            if (!selectedType || type === selectedType.toLowerCase()) {
                row.style.display = "";
                visibleCount++;
            } else {
                row.style.display = "none";
            }
        });

        // Show/hide no results message
        noResults.classList.toggle("hidden", visibleCount > 0);

        // Update result count if the element exists
        const resultCount = document.getElementById("resultCount");
        if (resultCount) {
            resultCount.textContent = `Showing ${visibleCount} result${visibleCount !== 1 ? 's' : ''}`;
        }
    }
</script>
