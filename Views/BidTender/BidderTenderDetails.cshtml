@model TenderDetailsViewModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tender Details - @Model.Tender.Title</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.2.1/flowbite.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.min.js"></script>

    <style>
        :root {
            --navy: #0B1F3A;
            --navy-mid: #122848;
            --navy-light: #1a3357;
            --gold: #C8960C;
            --gold-lt: #E8B84B;
            --ivory: #F7F3EC;
            --slate: #8A9BB5;
            --white: #ffffff;
            --muted: #5a6a80;
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--ivory);
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* ── PAGE WRAPPER ── */
        .btd-page {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 0 4rem;
        }

        /* ── HERO ── */
        .btd-hero {
            background: var(--navy);
            position: relative;
            overflow: hidden;
            padding: 2.8rem 2.5rem 4.8rem;
            border-radius: 0 0 0 0;
        }

            .btd-hero::before {
                content: '';
                position: absolute;
                inset: 0;
                background-image: linear-gradient(rgba(200,150,12,.05) 1px, transparent 1px), linear-gradient(90deg, rgba(200,150,12,.05) 1px, transparent 1px);
                background-size: 40px 40px;
                pointer-events: none;
            }

            .btd-hero::after {
                content: '';
                position: absolute;
                top: -40%;
                right: -5%;
                width: 480px;
                height: 480px;
                background: radial-gradient(circle, rgba(200,150,12,.15) 0%, transparent 65%);
                pointer-events: none;
            }

        .btd-hero-inner {
            position: relative;
            z-index: 2;
            max-width: 1280px;
            margin: 0 auto;
        }

        /* topbar */
        .btd-topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: .75rem;
            margin-bottom: 1.6rem;
        }

        .btd-back {
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            color: var(--slate);
            font-size: .85rem;
            font-weight: 500;
            background: none;
            border: none;
            cursor: pointer;
            font-family: 'DM Sans', sans-serif;
            transition: color .2s, transform .2s;
            text-decoration: none;
        }

            .btd-back:hover {
                color: var(--gold-lt);
                transform: translateX(-2px);
            }

        .btd-badges {
            display: flex;
            gap: .6rem;
        }

        .btd-badge {
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            padding: .32rem .9rem;
            border-radius: 6px;
            font-size: .7rem;
            font-weight: 700;
            letter-spacing: .06em;
            text-transform: uppercase;
        }

        .badge-open {
            background: linear-gradient(135deg,#10b981,#059669);
            color: #fff;
        }

        .badge-closed {
            background: linear-gradient(135deg,#ef4444,#dc2626);
            color: #fff;
        }

        .badge-pending {
            background: linear-gradient(135deg,#f59e0b,#d97706);
            color: #fff;
        }

        /* title block */
        .btd-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            font-size: .65rem;
            font-weight: 500;
            letter-spacing: .2em;
            text-transform: uppercase;
            color: var(--gold);
            margin-bottom: .5rem;
        }

            .btd-eyebrow span {
                display: inline-block;
                width: 18px;
                height: 1px;
                background: var(--gold);
            }

        .btd-hero h1 {
            font-family: 'Playfair Display', serif;
            font-size: clamp(1.4rem, 3vw, 2rem);
            font-weight: 900;
            color: var(--white);
            margin: 0 0 1rem;
            line-height: 1.2;
            max-width: 760px;
        }

        .btd-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 1.4rem;
        }

        .btd-meta-item {
            display: flex;
            align-items: center;
            gap: .4rem;
            font-size: .82rem;
            color: var(--slate);
        }

            .btd-meta-item i {
                color: var(--gold);
                font-size: .78rem;
            }

            .btd-meta-item strong {
                color: var(--white);
                font-weight: 600;
            }

        /* ── CARD CONTAINER ── */
        .btd-container {
            max-width: 1280px;
            margin: -2rem auto 0;
            padding: 0 1.5rem;
            position: relative;
            z-index: 2;
        }

        .btd-card {
            background: var(--white);
            border-radius: 16px;
            box-shadow: 0 12px 48px rgba(11,31,58,.12);
            overflow: hidden;
        }

        /* ── TAB BAR ── */
        .btd-tab-bar {
            display: flex;
            align-items: stretch;
            justify-content: space-between;
            border-bottom: 1px solid rgba(11,31,58,.08);
            padding: 0 1.5rem;
            background: var(--white);
        }

        .btd-tab-nav {
            display: flex;
            gap: .1rem;
        }

        .tab-button {
            display: inline-flex;
            align-items: center;
            gap: .45rem;
            padding: 1.05rem 1.3rem;
            font-size: .83rem;
            font-weight: 600;
            color: var(--muted);
            background: none;
            border: none;
            border-bottom: 2px solid transparent;
            cursor: pointer;
            position: relative;
            top: 1px;
            transition: color .2s, border-color .2s;
            font-family: 'DM Sans', sans-serif;
        }

            .tab-button:hover {
                color: var(--navy);
            }

            .tab-button.active {
                color: var(--navy);
                border-bottom-color: var(--gold);
            }

        .btd-apply-btn {
            display: inline-flex;
            align-items: center;
            gap: .45rem;
            padding: .55rem 1.3rem;
            border-radius: 7px;
            background: var(--gold);
            color: var(--navy);
            font-size: .82rem;
            font-weight: 700;
            text-decoration: none;
            align-self: center;
            transition: background .2s, transform .2s, box-shadow .2s;
            box-shadow: 0 3px 12px rgba(200,150,12,.3);
        }

            .btd-apply-btn:hover {
                background: var(--gold-lt);
                transform: translateY(-1px);
                box-shadow: 0 5px 16px rgba(200,150,12,.4);
                text-decoration: none;
                color: var(--navy);
            }

            .btd-apply-btn i {
                transition: transform .2s;
            }

            .btd-apply-btn:hover i {
                transform: translateX(3px);
            }

        /* ── TAB CONTENT ── */
        .tab-content {
            display: none;
        }

            .tab-content.active-tab {
                display: block;
            }

        /* ── DETAILS TAB ── */
        .btd-details-grid {
            display: grid;
            grid-template-columns: 300px 1fr;
            gap: 1.5rem;
            padding: 2rem;
        }

        /* publisher card */
        .btd-publisher {
            background: var(--ivory);
            border-radius: 14px;
            border: 1px solid rgba(11,31,58,.07);
            padding: 1.8rem 1.5rem;
            text-align: center;
            box-shadow: 0 2px 12px rgba(11,31,58,.05);
        }

        .btd-pub-photo {
            width: 88px;
            height: 88px;
            border-radius: 50%;
            margin: 0 auto 1rem;
            border: 3px solid rgba(200,150,12,.3);
            object-fit: cover;
            box-shadow: 0 4px 14px rgba(11,31,58,.12);
        }

        .btd-pub-photo-placeholder {
            width: 88px;
            height: 88px;
            border-radius: 50%;
            margin: 0 auto 1rem;
            background: rgba(200,150,12,.1);
            display: flex;
            align-items: center;
            justify-content: center;
            border: 3px solid rgba(200,150,12,.25);
        }

            .btd-pub-photo-placeholder i {
                color: var(--gold);
                font-size: 2rem;
            }

        .btd-pub-name {
            font-family: 'Playfair Display', serif;
            font-size: 1rem;
            font-weight: 700;
            color: var(--navy);
            margin-bottom: .35rem;
        }

        .btd-pub-role {
            display: inline-block;
            padding: .22rem .75rem;
            border-radius: 999px;
            background: rgba(200,150,12,.1);
            color: var(--gold);
            font-size: .7rem;
            font-weight: 700;
            letter-spacing: .06em;
            text-transform: uppercase;
            margin-bottom: 1.2rem;
        }

        .btd-contact-list {
            text-align: left;
            margin-bottom: 1.2rem;
        }

        .btd-contact-item {
            display: flex;
            align-items: center;
            gap: .7rem;
            padding: .55rem 0;
            border-bottom: 1px solid rgba(11,31,58,.05);
        }

            .btd-contact-item:last-child {
                border-bottom: none;
            }

        .btd-contact-icon {
            width: 30px;
            height: 30px;
            border-radius: 7px;
            background: rgba(200,150,12,.1);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--gold);
            font-size: .78rem;
            flex-shrink: 0;
        }

        .btd-contact-text {
            font-size: .82rem;
            color: var(--muted);
            word-break: break-word;
        }

        .btd-msg-btn {
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            padding: .65rem 1.2rem;
            border-radius: 8px;
            background: var(--navy);
            color: var(--white);
            font-size: .82rem;
            font-weight: 700;
            text-decoration: none;
            width: 100%;
            justify-content: center;
            margin-top: .5rem;
            transition: background .2s, transform .2s;
            box-shadow: 0 3px 12px rgba(11,31,58,.18);
        }

            .btd-msg-btn:hover {
                background: var(--navy-mid);
                transform: translateY(-1px);
                color: var(--white);
                text-decoration: none;
            }

        /* tender info card */
        .btd-info-card {
            background: var(--white);
            border-radius: 14px;
            border: 1px solid rgba(11,31,58,.07);
            overflow: hidden;
            box-shadow: 0 2px 12px rgba(11,31,58,.05);
        }

        .btd-info-hd {
            padding: 1rem 1.5rem;
            background: var(--navy);
            display: flex;
            align-items: center;
            gap: .65rem;
        }

            .btd-info-hd i {
                color: var(--gold);
                font-size: .9rem;
            }

            .btd-info-hd h3 {
                font-family: 'Playfair Display', serif;
                font-size: .95rem;
                font-weight: 700;
                color: var(--white);
                margin: 0;
            }

        .btd-info-body {
            padding: 1.3rem 1.5rem;
        }

        .btd-info-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: .7rem 0;
            border-bottom: 1px solid rgba(11,31,58,.05);
        }

            .btd-info-row:last-child {
                border-bottom: none;
            }

        .btd-info-label {
            font-size: .78rem;
            font-weight: 600;
            letter-spacing: .06em;
            text-transform: uppercase;
            color: var(--slate);
        }

        .btd-info-value {
            font-size: .88rem;
            font-weight: 600;
            color: var(--navy);
            text-align: right;
        }

        .btd-budget {
            color: var(--gold);
        }

        /* status mini badge */
        .btd-status-pill {
            display: inline-flex;
            align-items: center;
            padding: .2rem .7rem;
            border-radius: 999px;
            font-size: .7rem;
            font-weight: 700;
            letter-spacing: .05em;
            text-transform: uppercase;
        }

        .sp-open {
            background: #dcfce7;
            color: #166534;
        }

        .sp-closed {
            background: #fee2e2;
            color: #991b1b;
        }

        .sp-pending {
            background: #fef3c7;
            color: #92400e;
        }

        /* description box */
        .btd-desc-box {
            background: var(--ivory);
            border-radius: 10px;
            border-left: 3px solid var(--gold);
            padding: 1.2rem 1.4rem;
            margin-top: 1rem;
        }

            .btd-desc-box h4 {
                font-family: 'Playfair Display', serif;
                font-size: .9rem;
                font-weight: 700;
                color: var(--navy);
                margin-bottom: .6rem;
                display: flex;
                align-items: center;
                gap: .4rem;
            }

                .btd-desc-box h4 i {
                    color: var(--gold);
                    font-size: .85rem;
                }

            .btd-desc-box p {
                font-size: .85rem;
                color: var(--muted);
                line-height: 1.7;
            }

        /* ── TIMELINE ── */
        .btd-timeline-wrap {
            margin: 0 2rem 2rem;
        }

        .btd-timeline-card {
            background: var(--white);
            border-radius: 14px;
            border: 1px solid rgba(11,31,58,.07);
            overflow: hidden;
            box-shadow: 0 2px 12px rgba(11,31,58,.05);
        }

        .btd-tl-body {
            padding: 1.5rem 2rem;
            position: relative;
        }

        .btd-tl-row {
            display: flex;
            justify-content: space-between;
            position: relative;
        }

            .btd-tl-row::before {
                content: '';
                position: absolute;
                top: 20px;
                left: 20px;
                right: 20px;
                height: 2px;
                background: rgba(200,150,12,.15);
                z-index: 0;
            }

        .btd-tl-item {
            flex: 1;
            text-align: center;
            position: relative;
            z-index: 1;
        }

        .btd-tl-dot {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            margin: 0 auto .8rem;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .85rem;
            color: var(--white);
            box-shadow: 0 3px 10px rgba(11,31,58,.15);
            transition: transform .25s, box-shadow .25s;
        }

        .btd-tl-item:hover .btd-tl-dot {
            transform: scale(1.12);
            box-shadow: 0 6px 18px rgba(11,31,58,.2);
        }

        .dot-navy {
            background: var(--navy);
        }

        .dot-green {
            background: #10b981;
        }

        .dot-red {
            background: #ef4444;
        }

        .btd-tl-label {
            font-size: .7rem;
            font-weight: 700;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: var(--slate);
            margin-bottom: .25rem;
        }

        .btd-tl-date {
            font-family: 'Playfair Display', serif;
            font-size: .9rem;
            font-weight: 700;
            color: var(--navy);
        }

        /* ── DOCUMENTS TAB ── */
        .btd-docs-wrap {
            padding: 2rem;
        }

        .btd-docs-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: .75rem;
            margin-bottom: 1.4rem;
        }

        .btd-docs-title {
            font-family: 'Playfair Display', serif;
            font-size: 1rem;
            font-weight: 700;
            color: var(--navy);
            display: flex;
            align-items: center;
            gap: .5rem;
        }

            .btd-docs-title i {
                color: var(--gold);
            }

        .btd-dl-btn {
            display: inline-flex;
            align-items: center;
            gap: .45rem;
            padding: .6rem 1.2rem;
            border-radius: 7px;
            background: var(--navy);
            color: var(--white);
            font-size: .82rem;
            font-weight: 700;
            text-decoration: none;
            transition: background .2s, transform .2s, box-shadow .2s;
            box-shadow: 0 3px 12px rgba(11,31,58,.2);
        }

            .btd-dl-btn:hover {
                background: var(--navy-mid);
                transform: translateY(-1px);
                box-shadow: 0 5px 18px rgba(11,31,58,.25);
                color: var(--white);
                text-decoration: none;
            }

            .btd-dl-btn i {
                color: var(--gold-lt);
            }

        .btd-doc-meta {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 1rem 1.2rem;
            background: var(--ivory);
            border-radius: 10px;
            border: 1px solid rgba(11,31,58,.07);
            margin-bottom: 1.2rem;
        }

            .btd-doc-meta i {
                color: #ef4444;
                font-size: 1.5rem;
            }

        .btd-doc-name {
            font-weight: 600;
            color: var(--navy);
            font-size: .88rem;
        }

        .btd-doc-hint {
            font-size: .78rem;
            color: var(--slate);
            margin-top: .15rem;
        }

        .pdf-viewer {
            height: 800px;
            border-radius: 10px;
            overflow-y: auto;
            background: #f8fafc;
            border: 1px solid rgba(11,31,58,.08);
            box-shadow: inset 0 2px 4px rgba(0,0,0,.04);
        }

            .pdf-viewer::-webkit-scrollbar {
                width: 6px;
            }

            .pdf-viewer::-webkit-scrollbar-track {
                background: #f1f1f1;
                border-radius: 3px;
            }

            .pdf-viewer::-webkit-scrollbar-thumb {
                background: rgba(200,150,12,.3);
                border-radius: 3px;
            }

                .pdf-viewer::-webkit-scrollbar-thumb:hover {
                    background: var(--gold);
                }

        #pdf-container {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            align-items: center;
            padding: 1rem;
        }

            #pdf-container canvas {
                max-width: 100%;
                height: auto;
                box-shadow: 0 4px 12px rgba(11,31,58,.1);
                border-radius: 6px;
            }

        /* loading */
        .btd-loading {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 4rem;
            gap: 1rem;
        }

        .btd-spinner {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            border: 3px solid rgba(200,150,12,.2);
            border-top-color: var(--gold);
            animation: btdSpin .8s linear infinite;
        }

        @@keyframes btdSpin {
            to

        {
            transform: rotate(360deg);
        }

        }

        .btd-loading-text {
            font-size: .85rem;
            color: var(--slate);
            font-weight: 500;
        }

        @@media (max-width: 900px) {
            .btd-details-grid

        {
            grid-template-columns: 1fr;
        }

        .btd-timeline-wrap {
            margin: 0 1rem 1.5rem;
        }

        .btd-tl-row::before {
            top: 16px;
            left: 10px;
            right: 10px;
        }

        .btd-docs-wrap {
            padding: 1.2rem;
        }

        .btd-hero {
            padding: 2rem 1.2rem 4rem;
        }

        .btd-container {
            padding: 0 .75rem;
        }

        .btd-tab-bar {
            padding: 0 .75rem;
        }

        }
    </style>
</head>
<body>

    <div class="btd-page">

        <!-- HERO -->
        <div class="btd-hero">
            <div class="btd-hero-inner">
                <div class="btd-topbar">
                    <button onclick="history.back()" class="btd-back">
                        <i class="fas fa-arrow-left"></i> Back
                    </button>
                    <div class="btd-badges">
                        <span class="btd-badge badge-@Model.Tender.TenderStatus.ToLower()">
                            <i class="fas @(Model.Tender.TenderStatus.ToLower() == "open"   ? "fa-door-open" :
                                                                       Model.Tender.TenderStatus.ToLower() == "closed" ? "fa-lock" : "fa-clock")"></i>
                            @Model.Tender.TenderStatus
                        </span>
                    </div>
                </div>

                <p class="btd-eyebrow"><span></span> Tender Details</p>
                <h1>@Model.Tender.Title</h1>

                <div class="btd-meta">
                    <div class="btd-meta-item">
                        <i class="fas fa-hashtag"></i>
                        <span>ID: <strong>#@Model.Tender.TenderId</strong></span>
                    </div>
                    <div class="btd-meta-item">
                        <i class="fas fa-calendar-alt"></i>
                        <span>Posted: <strong>@Model.Tender.IssuedDate.ToString("MMM dd, yyyy")</strong></span>
                    </div>
                    <div class="btd-meta-item">
                        <i class="fas fa-building"></i>
                        <span>Issued by: <strong>@Model.Tender.IssuedBy</strong></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- CARD -->
        <div class="btd-container">
            <div class="btd-card">

                <!-- TAB BAR -->
                <div class="btd-tab-bar">
                    <div class="btd-tab-nav">
                        <button onclick="showTab('details')" class="tab-button active" id="details-tab-btn">
                            <i class="fas fa-info-circle"></i> Details
                        </button>
                        <button onclick="showTab('documents')" class="tab-button" id="documents-tab-btn">
                            <i class="fas fa-file-alt"></i> Documents
                        </button>
                    </div>
                    @if (ViewBag.CanApply == true)
                    {
                        @if (Model.Tender.TenderStatus.ToLower() == "open")
                        {
                            <a asp-action="AppliedTender" asp-controller="BidTender" asp-route-id="@Model.Tender.TenderId"
                               class="btd-apply-btn">
                                <i class="fas fa-paper-plane"></i> Apply Now
                            </a>
                        }
                    }
                </div>

                <!-- ── DETAILS TAB ── -->
                <div id="details-tab" class="tab-content active-tab">

                    <div class="btd-details-grid">

                        <!-- Publisher card -->
                        <div class="btd-publisher">
                            @if (!string.IsNullOrEmpty(Model.User.UserPhoto))
                            {
                                <img src="@Url.Content("~/UserImage/" + Model.User.UserPhoto)"
                                     alt="Publisher" class="btd-pub-photo" />
                            }
                            else
                            {
                                <div class="btd-pub-photo-placeholder">
                                    <i class="fas fa-user"></i>
                                </div>
                            }

                            <div class="btd-pub-name">
                                @Model.User.FirstName @Model.User.MiddleName @Model.User.LastName
                            </div>
                            <span class="btd-pub-role">@Model.User.UserRole</span>

                            <div class="btd-contact-list">
                                <div class="btd-contact-item">
                                    <div class="btd-contact-icon"><i class="fas fa-envelope"></i></div>
                                    <span class="btd-contact-text">@Model.User.EmailAddress</span>
                                </div>
                                <div class="btd-contact-item">
                                    <div class="btd-contact-icon"><i class="fas fa-phone"></i></div>
                                    <span class="btd-contact-text">@Model.User.Phone</span>
                                </div>
                                <div class="btd-contact-item">
                                    <div class="btd-contact-icon"><i class="fas fa-map-marker-alt"></i></div>
                                    <span class="btd-contact-text">@Model.User.City, @Model.User.District</span>
                                </div>
                            </div>

                            <a asp-action="UserMessage" asp-controller="Chat"
                               asp-route-receiverId="@Model.User.UserId" class="btd-msg-btn">
                                <i class="fas fa-paper-plane"></i> Send Message
                            </a>
                        </div>

                        <!-- Tender info -->
                        <div class="btd-info-card">
                            <div class="btd-info-hd">
                                <i class="fas fa-info-circle"></i>
                                <h3>Tender Information</h3>
                            </div>
                            <div class="btd-info-body">
                                <div class="btd-info-row">
                                    <span class="btd-info-label">Type</span>
                                    <span class="btd-info-value">@Model.Tender.TenderType</span>
                                </div>
                                <div class="btd-info-row">
                                    <span class="btd-info-label">Duration</span>
                                    <span class="btd-info-value">@Model.Tender.ProjectDuration</span>
                                </div>
                                <div class="btd-info-row">
                                    <span class="btd-info-label">Budget</span>
                                    <span class="btd-info-value btd-budget">&#8377; @Model.Tender.BudgetEstimation.ToString("N2")</span>
                                </div>
                                <div class="btd-info-row">
                                    <span class="btd-info-label">Status</span>
                                    <span class="btd-status-pill
                                    @(Model.Tender.TenderStatus.ToLower() == "open" ? "sp-open" :
                                                                                Model.Tender.TenderStatus.ToLower() == "closed" ? "sp-closed" : "sp-pending")">
                                        @Model.Tender.TenderStatus
                                    </span>
                                </div>

                                <div class="btd-desc-box">
                                    <h4><i class="fas fa-align-left"></i> Project Description</h4>
                                    <p>@Model.Tender.TenderDescription</p>
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- Timeline -->
                    <div class="btd-timeline-wrap">
                        <div class="btd-timeline-card">
                            <div class="btd-info-hd">
                                <i class="fas fa-clock"></i>
                                <h3>Timeline</h3>
                            </div>
                            <div class="btd-tl-body">
                                <div class="btd-tl-row">
                                    <div class="btd-tl-item">
                                        <div class="btd-tl-dot dot-navy">
                                            <i class="fas fa-flag"></i>
                                        </div>
                                        <div class="btd-tl-label">Issue Date</div>
                                        <div class="btd-tl-date">@Model.Tender.IssuedDate.ToString("MMM dd, yyyy")</div>
                                    </div>
                                    <div class="btd-tl-item">
                                        <div class="btd-tl-dot dot-green">
                                            <i class="fas fa-door-open"></i>
                                        </div>
                                        <div class="btd-tl-label">Opening Date</div>
                                        <div class="btd-tl-date">@Model.Tender.OpeningDate.ToString("MMM dd, yyyy")</div>
                                    </div>
                                    <div class="btd-tl-item">
                                        <div class="btd-tl-dot dot-red">
                                            <i class="fas fa-lock"></i>
                                        </div>
                                        <div class="btd-tl-label">Closing Date</div>
                                        <div class="btd-tl-date">@Model.Tender.ClosingDate.ToString("MMM dd, yyyy")</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div><!-- /details-tab -->
                <!-- ── DOCUMENTS TAB ── -->
                <div id="documents-tab" class="tab-content">
                    <div class="btd-docs-wrap">

                        <div class="btd-docs-header">
                            <h3 class="btd-docs-title">
                                <i class="fas fa-file-alt"></i> Tender Documents
                            </h3>
                            <a href="@Url.Content("~/TenderDocument/" + Model.Tender.TenderDocument)"
                               class="btd-dl-btn" download>
                                <i class="fas fa-download"></i> Download PDF
                            </a>
                        </div>

                        <div class="btd-doc-meta">
                            <i class="fas fa-file-pdf"></i>
                            <div>
                                <div class="btd-doc-name">@(Model.Tender.TenderDocument ?? "Tender Document.pdf")</div>
                                <div class="btd-doc-hint">Click the download button to save or scroll through the preview below</div>
                            </div>
                        </div>

                        <div class="pdf-viewer">
                            <div id="pdf-container">
                                <div class="btd-loading">
                                    <div class="btd-spinner"></div>
                                    <span class="btd-loading-text">Loading document...</span>
                                </div>
                            </div>
                        </div>

                    </div>
                </div><!-- /documents-tab -->

            </div><!-- /btd-card -->
        </div><!-- /btd-container -->

    </div><!-- /btd-page -->

    <script src="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.2.1/flowbite.min.js"></script>
    <script>
        function showTab(tabName) {
            const tabs = document.querySelectorAll('.tab-content');
            const buttons = document.querySelectorAll('.tab-button');

            tabs.forEach(tab => {
                tab.classList.remove('active-tab');
            });

            buttons.forEach(btn => {
                btn.classList.remove('active');
            });

            document.getElementById(`${tabName}-tab`).classList.add('active-tab');
            document.getElementById(`${tabName}-tab-btn`).classList.add('active');

            // Load PDF when documents tab is clicked
            if (tabName === 'documents') {
                loadPDF();
            }
        }

        // Function to load PDF
        function loadPDF() {
            const url = "@Url.Content("~/TenderDocument/" + Model.Tender.TenderDocument)";
            const pdfContainer = document.getElementById('pdf-container');

            // Check if PDF is already loaded
            if (pdfContainer.querySelector('canvas')) {
                return;
            }

            // Show loading indicator
            pdfContainer.innerHTML = `
                <div class="btd-loading">
                    <div class="btd-spinner"></div>
                    <span class="btd-loading-text">Loading document...</span>
                </div>
            `;

            pdfjsLib.getDocument(url).promise.then(pdf => {
                // Clear loading indicator
                pdfContainer.innerHTML = '';

                const scale = 1.5;
                const numPages = pdf.numPages;

                // Render all pages
                for (let pageNum = 1; pageNum <= numPages; pageNum++) {
                    const pageContainer = document.createElement('div');
                    pageContainer.className = 'mb-6 relative';

                    const pageLabel = document.createElement('div');
                    pageLabel.className = 'absolute top-2 right-2 bg-blue-600 text-white text-xs font-bold px-2 py-1 rounded-md opacity-75';
                    pageLabel.textContent = `Page ${pageNum} of ${numPages}`;

                    const canvas = document.createElement('canvas');
                    canvas.className = 'mx-auto shadow-md rounded-lg';

                    pageContainer.appendChild(canvas);
                    pageContainer.appendChild(pageLabel);
                    pdfContainer.appendChild(pageContainer);

                    pdf.getPage(pageNum).then(page => {
                        const viewport = page.getViewport({ scale });
                        canvas.height = viewport.height;
                        canvas.width = viewport.width;
                        const ctx = canvas.getContext('2d');

                        page.render({
                            canvasContext: ctx,
                            viewport: viewport
                        }).promise.then(() => {
                            console.log(`Page ${pageNum} rendered successfully`);
                        }).catch(error => {
                            console.error(`Error rendering page ${pageNum}:`, error);
                        });
                    });
                }
            }).catch(error => {
                console.error('Error loading PDF:', error);
                pdfContainer.innerHTML = `
                    <div class="text-center p-8">
                        <i class="fas fa-exclamation-circle text-4xl text-red-500 mb-4"></i>
                        <h3 class="text-xl font-semibold text-gray-800 mb-2">Error Loading PDF</h3>
                        <p class="text-gray-600">There was an error loading the PDF document. Please try downloading it instead.</p>
                    </div>
                `;
            });
        }

        // Add event listener for document ready
        document.addEventListener('DOMContentLoaded', function () {
            // Show details tab by default
            showTab('details');

            // Handle download button loading state
            const downloadButton = document.querySelector('.btd-dl-btn');
            if (downloadButton) {
                downloadButton.addEventListener('click', function () {
                    this.classList.add('opacity-75', 'cursor-wait');
                    const icon = this.querySelector('i');
                    icon.classList.remove('fa-download');
                    icon.classList.add('fa-spinner', 'fa-spin');

                    // Reset button state after download starts
                    setTimeout(() => {
                        this.classList.remove('opacity-75', 'cursor-wait');
                        icon.classList.remove('fa-spinner', 'fa-spin');
                        icon.classList.add('fa-download');
                    }, 1000);
                });
            }
        });
    </script>

</body>
</html>
