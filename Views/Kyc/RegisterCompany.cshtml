@model UserListEdit
@{
    Layout = "_Layout";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
<script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

<style>
    :root {
        --navy: #0B1F3A;
        --navy-mid: #122848;
        --gold: #C8960C;
        --gold-lt: #E8B84B;
        --ivory: #F7F3EC;
        --slate: #8A9BB5;
        --white: #ffffff;
        --muted: #5a6a80;
    }

    .kyc-bleed {
        position: relative;
        left: 50%;
        width: 100vw;
        margin-left: -50vw;
        margin-top: -1.5rem;
        background: var(--ivory);
        min-height: 100vh;
        overflow-x: hidden;
        font-family: 'DM Sans', sans-serif;
    }

    /* ── HERO ── */
    .kyc-hero {
        background: var(--navy);
        position: relative;
        overflow: hidden;
        padding: 2.8rem 2.5rem 5rem;
    }

        .kyc-hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(200,150,12,.05) 1px, transparent 1px), linear-gradient(90deg, rgba(200,150,12,.05) 1px, transparent 1px);
            background-size: 40px 40px;
            pointer-events: none;
        }

        .kyc-hero::after {
            content: '';
            position: absolute;
            top: -40%;
            right: -5%;
            width: 420px;
            height: 420px;
            background: radial-gradient(circle, rgba(200,150,12,.15) 0%, transparent 65%);
            pointer-events: none;
        }

    .kyc-hero-inner {
        position: relative;
        z-index: 2;
        max-width: 900px;
        margin: 0 auto;
    }

    .kyc-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        font-size: .65rem;
        font-weight: 500;
        letter-spacing: .2em;
        text-transform: uppercase;
        color: var(--gold);
        margin-bottom: .5rem;
    }

        .kyc-eyebrow span {
            display: inline-block;
            width: 18px;
            height: 1px;
            background: var(--gold);
        }

    .kyc-hero h1 {
        font-family: 'Playfair Display', serif;
        font-size: clamp(1.5rem, 3vw, 2rem);
        font-weight: 900;
        color: var(--white);
        margin: 0 0 .4rem;
        line-height: 1.2;
    }

        .kyc-hero h1 em {
            font-style: normal;
            color: var(--gold-lt);
        }

    .kyc-hero-sub {
        font-size: .88rem;
        color: var(--slate);
        margin: 0;
    }

    .kyc-steps {
        display: flex;
        gap: 1.5rem;
        flex-wrap: wrap;
        margin-top: 1.5rem;
    }

    .kyc-step {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        font-size: .75rem;
        font-weight: 600;
        color: var(--slate);
    }

    .kyc-step-dot {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        background: rgba(200,150,12,.15);
        border: 1.5px solid rgba(200,150,12,.3);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .65rem;
        color: var(--gold);
        font-weight: 700;
    }

    /* ── FORM CARD ── */
    .kyc-body {
        max-width: 900px;
        margin: -2rem auto 3rem;
        padding: 0 1.5rem;
        position: relative;
        z-index: 2;
    }

    .kyc-card {
        background: var(--white);
        border-radius: 16px;
        box-shadow: 0 12px 48px rgba(11,31,58,.12);
        overflow: hidden;
    }

    .kyc-val-summary {
        padding: 1rem 1.5rem;
        background: #fee2e2;
        border-left: 3px solid #ef4444;
        font-size: .84rem;
        color: #991b1b;
    }

    /* ── SECTIONS ── */
    .kyc-section {
        border-bottom: 1px solid rgba(11,31,58,.06);
    }

        .kyc-section:last-child {
            border-bottom: none;
        }

    .kyc-section-hd {
        padding: 1.1rem 2rem;
        background: var(--navy);
        display: flex;
        align-items: center;
        gap: .7rem;
    }

    .kyc-section-icon {
        width: 32px;
        height: 32px;
        border-radius: 7px;
        background: rgba(200,150,12,.15);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--gold);
        font-size: .85rem;
        flex-shrink: 0;
    }

    .kyc-section-title {
        font-family: 'Playfair Display', serif;
        font-size: .95rem;
        font-weight: 700;
        color: var(--white);
        margin: 0;
    }

    .kyc-section-body {
        padding: 1.8rem 2rem;
    }

    /* ── GRIDS ── */
    .kyc-grid-3 {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.4rem;
    }

    .kyc-grid-2 {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.4rem;
    }

    /* ── FLOATING LABEL ── */
    .kyc-field {
        position: relative;
        margin-bottom: .25rem;
    }

    .form-input {
        width: 100%;
        padding: .85rem 1rem;
        border: 1.5px solid rgba(11,31,58,.15);
        border-radius: 8px;
        font-size: .88rem;
        font-family: 'DM Sans', sans-serif;
        color: var(--navy);
        background: var(--white);
        transition: border-color .2s, box-shadow .2s;
        outline: none;
    }

        .form-input::placeholder {
            color: transparent;
        }

        .form-input:focus {
            border-color: var(--gold);
            box-shadow: 0 0 0 3px rgba(200,150,12,.1);
        }

    .form-label {
        position: absolute;
        top: 50%;
        left: 1rem;
        transform: translateY(-50%);
        font-size: .84rem;
        color: var(--slate);
        background: var(--white);
        padding: 0 .25rem;
        pointer-events: none;
        transition: all .2s;
    }

    .form-input:focus ~ .form-label,
    .form-input:not(:placeholder-shown) ~ .form-label {
        top: 0;
        font-size: .7rem;
        color: var(--gold);
        font-weight: 600;
        letter-spacing: .04em;
    }

    .validation-error {
        font-size: .72rem;
        color: #ef4444;
        margin-top: .3rem;
        display: block;
    }

    /* ── FILE UPLOAD ── */
    .kyc-upload-label-text {
        font-size: .78rem;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
        color: var(--slate);
        margin-bottom: .5rem;
        display: block;
    }

    .file-input-container {
        position: relative;
        margin-bottom: .5rem;
    }

    .file-input-label {
        display: flex;
        align-items: center;
        gap: .6rem;
        padding: .85rem 1.1rem;
        background: var(--ivory);
        border: 1.5px dashed rgba(11,31,58,.18);
        border-radius: 8px;
        cursor: pointer;
        font-size: .84rem;
        color: var(--muted);
        transition: border-color .2s, background .2s;
    }

        .file-input-label:hover {
            border-color: var(--gold);
            background: rgba(200,150,12,.04);
            color: var(--navy);
        }

        .file-input-label i {
            color: var(--gold);
            font-size: .95rem;
        }

    .file-input {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0,0,0,0);
        white-space: nowrap;
        border-width: 0;
    }

    .preview-container {
        display: flex;
        align-items: center;
        margin-top: .6rem;
        gap: .75rem;
    }

    .preview-image {
        width: 72px;
        height: 72px;
        object-fit: cover;
        border-radius: 8px;
        border: 2px solid rgba(200,150,12,.2);
        box-shadow: 0 2px 8px rgba(11,31,58,.08);
    }

    .preview-remove {
        padding: .3rem .7rem;
        background: #ef4444;
        color: var(--white);
        border: none;
        border-radius: 5px;
        font-size: .72rem;
        font-weight: 700;
        cursor: pointer;
        transition: background .2s, transform .2s;
    }

        .preview-remove:hover {
            background: #dc2626;
            transform: translateY(-1px);
        }

    /* ── CHECKBOX ── */
    .kyc-terms {
        display: flex;
        align-items: flex-start;
        gap: .65rem;
        margin-bottom: 1.5rem;
    }

    .checkbox-input {
        width: 16px;
        height: 16px;
        margin-top: .15rem;
        border-radius: 4px;
        border: 1.5px solid rgba(11,31,58,.2);
        accent-color: var(--navy);
        flex-shrink: 0;
        cursor: pointer;
    }

    .checkbox-label {
        font-size: .84rem;
        color: var(--muted);
        line-height: 1.5;
    }

        .checkbox-label a {
            color: var(--gold);
            font-weight: 600;
            text-decoration: none;
        }

            .checkbox-label a:hover {
                color: var(--gold-lt);
                text-decoration: underline;
            }

    /* ── SUBMIT ── */
    .kyc-submit-wrap {
        display: flex;
        justify-content: center;
    }

    .submit-button {
        display: inline-flex;
        align-items: center;
        gap: .55rem;
        padding: .9rem 2.2rem;
        border-radius: 9px;
        background: var(--navy);
        color: var(--white);
        font-size: .92rem;
        font-weight: 700;
        border: none;
        cursor: pointer;
        font-family: 'DM Sans', sans-serif;
        transition: background .2s, transform .2s, box-shadow .2s;
        box-shadow: 0 5px 20px rgba(11,31,58,.2);
        position: relative;
        overflow: hidden;
    }

        .submit-button::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(200,150,12,.15), transparent);
            opacity: 0;
            transition: opacity .3s;
        }

        .submit-button:hover {
            background: var(--navy-mid);
            transform: translateY(-2px);
            box-shadow: 0 8px 28px rgba(11,31,58,.28);
        }

            .submit-button:hover::before {
                opacity: 1;
            }

        .submit-button .btn-gold {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 26px;
            height: 26px;
            border-radius: 6px;
            background: var(--gold);
            color: var(--navy);
            font-size: .8rem;
            transition: transform .2s;
        }

        .submit-button:hover .btn-gold {
            transform: scale(1.1);
        }

    /* ── REGISTRATION OVERLAY ── */
    .reg-overlay {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(11,31,58,.88);
        backdrop-filter: blur(8px);
        opacity: 0;
        pointer-events: none;
        transition: opacity .35s ease;
    }

        .reg-overlay.active {
            opacity: 1;
            pointer-events: all;
        }

    .reg-overlay-card {
        background: var(--white);
        border-radius: 22px;
        padding: 2.8rem 2.5rem;
        width: min(440px, 92vw);
        text-align: center;
        box-shadow: 0 40px 90px rgba(11,31,58,.4);
        transform: translateY(28px) scale(.95);
        transition: transform .45s cubic-bezier(.34,1.56,.64,1);
        position: relative;
        overflow: hidden;
    }

    .reg-overlay.active .reg-overlay-card {
        transform: translateY(0) scale(1);
    }

    .reg-overlay-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: linear-gradient(90deg, var(--gold), var(--gold-lt), var(--gold));
        background-size: 200% 100%;
        animation: reg-shimmer 1.8s linear infinite;
    }
    @@keyframes reg-shimmer {
        0%

    {
        background-position: 200% center;
    }

    100% {
        background-position: -200% center;
    }

    }

    /* particles */
    .reg-particles {
        position: absolute;
        inset: 0;
        pointer-events: none;
        overflow: hidden;
        border-radius: 22px;
    }

    .reg-particle {
        position: absolute;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--gold-lt);
        opacity: 0;
        animation: reg-float 3s ease-in-out infinite;
    }

        .reg-particle:nth-child(1) {
            left: 12%;
            animation-delay: 0s;
            width: 5px;
            height: 5px;
        }

        .reg-particle:nth-child(2) {
            left: 30%;
            animation-delay: .5s;
            width: 4px;
            height: 4px;
            background: var(--gold);
        }

        .reg-particle:nth-child(3) {
            left: 52%;
            animation-delay: 1.0s;
            width: 6px;
            height: 6px;
        }

        .reg-particle:nth-child(4) {
            left: 72%;
            animation-delay: 1.6s;
            width: 4px;
            height: 4px;
            background: var(--gold);
        }

        .reg-particle:nth-child(5) {
            left: 88%;
            animation-delay: 0.3s;
            width: 5px;
            height: 5px;
        }
    @@keyframes reg-float {
        0%

    {
        transform: translateY(110px) scale(0);
        opacity: 0;
    }

    20% {
        opacity: .7;
    }

    80% {
        opacity: .4;
    }

    100% {
        transform: translateY(-20px) scale(1);
        opacity: 0;
    }

    }

    /* icon ring */
    .reg-anim-ring {
        width: 88px;
        height: 88px;
        border-radius: 50%;
        background: linear-gradient(135deg, rgba(200,150,12,.14), rgba(200,150,12,.04));
        border: 2px solid rgba(200,150,12,.28);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.5rem;
        animation: reg-pulse 2s ease-in-out infinite;
    }
    @@keyframes reg-pulse {
        0%,100%

    {
        box-shadow: 0 0 0 0 rgba(200,150,12,.3);
    }

    50% {
        box-shadow: 0 0 0 16px rgba(200,150,12,.0);
    }

    }

    .reg-anim-ring i {
        font-size: 1.9rem;
        color: var(--gold);
        animation: reg-bounce 1.6s ease-in-out infinite;
    }
    @@keyframes reg-bounce {
        0%,100%

    {
        transform: translateY(0) scale(1);
    }

    45% {
        transform: translateY(-6px) scale(1.08);
    }

    65% {
        transform: translateY(-3px) scale(1.04);
    }

    }

    /* dots */
    .reg-dots {
        display: flex;
        justify-content: center;
        gap: .5rem;
        margin: 1.2rem 0 .4rem;
    }

        .reg-dots span {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--gold);
            animation: reg-dot .9s ease-in-out infinite;
        }

            .reg-dots span:nth-child(2) {
                animation-delay: .15s;
                background: var(--gold-lt);
            }

            .reg-dots span:nth-child(3) {
                animation-delay: .30s;
            }
    @@keyframes reg-dot {
        0%,80%,100%

    {
        transform: translateY(0);
        opacity: .4;
    }

    40% {
        transform: translateY(-9px);
        opacity: 1;
    }

    }

    /* progress */
    .reg-progress-track {
        height: 5px;
        background: rgba(11,31,58,.08);
        border-radius: 99px;
        overflow: hidden;
        margin: .9rem 0 1.4rem;
    }

    .reg-progress-fill {
        height: 100%;
        width: 0%;
        background: linear-gradient(90deg, var(--gold), var(--gold-lt));
        border-radius: 99px;
        transition: width .5s ease;
    }

    /* text */
    .reg-overlay-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--navy);
        margin: 0 0 .35rem;
    }

    .reg-overlay-sub {
        font-size: .86rem;
        color: var(--muted);
        line-height: 1.6;
        margin: 0;
    }

    /* steps list */
    .reg-steps-list {
        list-style: none;
        padding: 0;
        margin: 1.3rem 0 0;
        text-align: left;
    }

        .reg-steps-list li {
            display: flex;
            align-items: center;
            gap: .7rem;
            font-size: .82rem;
            color: var(--muted);
            padding: .38rem 0;
            border-bottom: 1px solid rgba(11,31,58,.05);
            transition: color .3s;
        }

            .reg-steps-list li:last-child {
                border-bottom: none;
            }

            .reg-steps-list li .s-icon {
                width: 24px;
                height: 24px;
                border-radius: 50%;
                border: 1.5px solid rgba(11,31,58,.15);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: .65rem;
                color: var(--slate);
                flex-shrink: 0;
                transition: all .3s;
            }

            .reg-steps-list li.done .s-icon {
                background: #22c55e;
                border-color: #22c55e;
                color: white;
            }

            .reg-steps-list li.active {
                color: var(--navy);
                font-weight: 600;
            }

                .reg-steps-list li.active .s-icon {
                    border-color: var(--gold);
                    color: var(--gold);
                    animation: reg-spin 1.4s linear infinite;
                }
    @@keyframes reg-spin {
        to

    {
        transform: rotate(360deg);
    }

    }

    @@media (max-width: 900px) {
        .kyc-hero

    {
        padding: 2rem 1.2rem 4rem;
    }

    .kyc-body {
        padding: 0 .75rem;
    }

    .kyc-section-body {
        padding: 1.2rem 1rem;
    }

    .kyc-grid-3 {
        grid-template-columns: 1fr;
    }

    .kyc-grid-2 {
        grid-template-columns: 1fr;
    }

    }
    @@media (min-width: 640px) and (max-width: 900px) {
        .kyc-grid-3

    {
        grid-template-columns: repeat(2, 1fr);
    }

    }
</style>

<div class="kyc-bleed">

    <!-- HERO -->
    <div class="kyc-hero">
        <div class="kyc-hero-inner">
            <p class="kyc-eyebrow"><span></span> Bidder KYC</p>
            <h1>Company <em>Verification</em></h1>
            <p class="kyc-hero-sub">Complete your KYC to unlock full bidding capabilities and participate in all tenders.</p>
            <div class="kyc-steps">
                <div class="kyc-step"><div class="kyc-step-dot">1</div> Company Details</div>
                <div class="kyc-step"><div class="kyc-step-dot">2</div> Document Upload</div>
                <div class="kyc-step"><div class="kyc-step-dot">3</div> Bank Details</div>
            </div>
        </div>
    </div>

    <!-- FORM CARD -->
    <div class="kyc-body">
        <div class="kyc-card">

            <form asp-action="RegisterCompany" asp-controller="Kyc" method="post" enctype="multipart/form-data" id="kycRegForm">
                <div asp-validation-summary="ModelOnly" class="kyc-val-summary"></div>

                <!-- COMPANY DETAILS -->
                <div class="kyc-section">
                    <div class="kyc-section-hd">
                        <div class="kyc-section-icon"><i class="fas fa-building"></i></div>
                        <h2 class="kyc-section-title">Company Details</h2>
                    </div>
                    <div class="kyc-section-body">
                        <div class="kyc-grid-3">
                            <div class="kyc-field">
                                <input asp-for="CompanyName" type="text" class="form-input" placeholder=" " required />
                                <label asp-for="CompanyName" class="form-label">Company Name</label>
                                <span asp-validation-for="CompanyName" class="validation-error"></span>
                            </div>
                            <div class="kyc-field">
                                <input asp-for="FullAddress" type="text" class="form-input" placeholder=" " required />
                                <label asp-for="FullAddress" class="form-label">Full Address</label>
                                <span asp-validation-for="FullAddress" class="validation-error"></span>
                            </div>
                            <div class="kyc-field">
                                <input asp-for="CompanyWebsiteUrl" type="text" class="form-input" placeholder=" " required />
                                <label asp-for="CompanyWebsiteUrl" class="form-label">Company URL</label>
                                <span asp-validation-for="CompanyWebsiteUrl" class="validation-error"></span>
                            </div>
                            <div class="kyc-field">
                                <input asp-for="RegistrationNumber" type="text" class="form-input" placeholder=" " required />
                                <label asp-for="RegistrationNumber" class="form-label">Registration Number</label>
                                <span asp-validation-for="RegistrationNumber" class="validation-error"></span>
                            </div>
                            <div class="kyc-field">
                                <input asp-for="PanNumber" type="text" class="form-input" placeholder=" " required />
                                <label asp-for="PanNumber" class="form-label">PAN Number</label>
                                <span asp-validation-for="PanNumber" class="validation-error"></span>
                            </div>
                            <div class="kyc-field">
                                <input asp-for="CompanyType" type="text" class="form-input" placeholder=" " required />
                                <label asp-for="CompanyType" class="form-label">Company Type</label>
                                <span asp-validation-for="CompanyType" class="validation-error"></span>
                            </div>
                            <div class="kyc-field">
                                <input asp-for="OfficeEmail" type="email" class="form-input" placeholder=" " required />
                                <label asp-for="OfficeEmail" class="form-label">Company Email</label>
                                <span asp-validation-for="OfficeEmail" class="validation-error"></span>
                            </div>
                            <div class="kyc-field">
                                <input asp-for="Position" type="text" class="form-input" placeholder=" " required />
                                <label asp-for="Position" class="form-label">Your Position in Company</label>
                                <span asp-validation-for="Position" class="validation-error"></span>
                            </div>
                        </div>

                        <!-- Registration Document -->
                        <div style="margin-top:1.6rem;">
                            <span class="kyc-upload-label-text">
                                <i class="fas fa-file-contract" style="color:var(--gold);margin-right:.4rem;"></i>
                                Registration Document
                            </span>
                            <div class="file-input-container">
                                <label for="RegisterFile" class="file-input-label">
                                    <i class="fas fa-file-upload"></i>
                                    <span>Choose file or drag &amp; drop</span>
                                </label>
                                <input asp-for="RegisterFile" id="RegisterFile" type="file" class="file-input"
                                       onchange="previewImage(event, 'RegDocPreview')" required />
                                <span asp-validation-for="RegisterFile" class="validation-error"></span>
                                <div class="preview-container hidden" id="RegDocPreviewContainer">
                                    <img id="RegDocPreview" src="#" alt="Registration Document Preview" class="preview-image" />
                                    <button type="button" class="preview-remove"
                                            onclick="removeImage('RegDocPreview', 'RegDocPreviewContainer')">
                                        <i class="fas fa-times"></i> Remove
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- PAN Document -->
                        <div style="margin-top:1.2rem;">
                            <span class="kyc-upload-label-text">
                                <i class="fas fa-id-card" style="color:var(--gold);margin-right:.4rem;"></i>
                                PAN Document
                            </span>
                            <div class="file-input-container">
                                <label for="PanFile" class="file-input-label">
                                    <i class="fas fa-file-upload"></i>
                                    <span>Choose file or drag &amp; drop</span>
                                </label>
                                <input asp-for="PanFile" id="PanFile" type="file" class="file-input"
                                       onchange="previewImage(event, 'PanDocPreview')" required />
                                <span asp-validation-for="PanFile" class="validation-error"></span>
                                <div class="preview-container hidden" id="PanDocPreviewContainer">
                                    <img id="PanDocPreview" src="#" alt="PAN Document Preview" class="preview-image" />
                                    <button type="button" class="preview-remove"
                                            onclick="removeImage('PanDocPreview', 'PanDocPreviewContainer')">
                                        <i class="fas fa-times"></i> Remove
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- BANK DETAILS -->
                <div class="kyc-section">
                    <div class="kyc-section-hd">
                        <div class="kyc-section-icon"><i class="fas fa-university"></i></div>
                        <h2 class="kyc-section-title">Bank Details</h2>
                    </div>
                    <div class="kyc-section-body">
                        <div class="kyc-grid-2">
                            <div class="kyc-field">
                                <input asp-for="BankName" type="text" class="form-input" placeholder=" " required />
                                <label asp-for="BankName" class="form-label">Bank Name</label>
                                <span asp-validation-for="BankName" class="validation-error"></span>
                            </div>
                            <div class="kyc-field">
                                <input asp-for="AccountNumber" type="text" class="form-input" placeholder=" " required />
                                <label asp-for="AccountNumber" class="form-label">Account Number</label>
                                <span asp-validation-for="AccountNumber" class="validation-error"></span>
                            </div>
                            <div class="kyc-field">
                                <input asp-for="AccountType" type="text" class="form-input" placeholder=" " required />
                                <label asp-for="AccountType" class="form-label">Account Type</label>
                                <span asp-validation-for="AccountType" class="validation-error"></span>
                            </div>
                            <div class="kyc-field">
                                <input asp-for="AccountHolderName" type="text" class="form-input" placeholder=" " required />
                                <label asp-for="AccountHolderName" class="form-label">Account Holder Name</label>
                                <span asp-validation-for="AccountHolderName" class="validation-error"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- TERMS & SUBMIT -->
                <div class="kyc-section">
                    <div class="kyc-section-body">
                        <div class="kyc-terms">
                            <input type="checkbox" id="agreeTerms" name="agreeTerms" class="checkbox-input" required />
                            <label for="agreeTerms" class="checkbox-label">
                                I agree to the <a href="#" target="_blank">terms and conditions</a> and confirm that all information provided is accurate and complete.
                            </label>
                        </div>
                        <div class="kyc-submit-wrap">
                            <button type="submit" class="submit-button" id="kycRegSubmitBtn">
                                <span class="btn-gold"><i class="fas fa-check"></i></span>
                                Complete Registration
                            </button>
                        </div>
                    </div>
                </div>

            </form>
        </div>
    </div>

    <!-- ── REGISTRATION OVERLAY ── -->
    <div class="reg-overlay" id="regOverlay">
        <div class="reg-overlay-card">

            <div class="reg-particles">
                <div class="reg-particle"></div>
                <div class="reg-particle"></div>
                <div class="reg-particle"></div>
                <div class="reg-particle"></div>
                <div class="reg-particle"></div>
            </div>

            <div class="reg-anim-ring">
                <i class="fas fa-user-shield"></i>
            </div>

            <h3 class="reg-overlay-title">Registering KYC…</h3>
            <p class="reg-overlay-sub">Please wait while we send your details to the admin for verification</p>

            <div class="reg-dots">
                <span></span><span></span><span></span>
            </div>

            <div class="reg-progress-track">
                <div class="reg-progress-fill" id="regProgressFill"></div>
            </div>

            <ul class="reg-steps-list">
                <li id="regStep1">
                    <div class="s-icon"><i class="fas fa-check"></i></div>
                    Validating company details
                </li>
                <li id="regStep2">
                    <div class="s-icon"><i class="fas fa-circle-notch"></i></div>
                    Uploading KYC documents
                </li>
                <li id="regStep3">
                    <div class="s-icon"><i class="fas fa-circle-notch"></i></div>
                    Sending verification email to admin
                </li>
                <li id="regStep4">
                    <div class="s-icon"><i class="fas fa-circle-notch"></i></div>
                    Completing registration
                </li>
            </ul>
        </div>
    </div>

</div>

<script>
    function previewImage(event, previewId) {
        const file = event.target.files[0];
        const reader = new FileReader();
        const previewElement = document.getElementById(previewId);
        const previewContainer = document.getElementById(previewId + 'Container');
        if (file) {
            reader.onload = function (e) {
                previewElement.src = e.target.result;
                previewContainer.classList.remove('hidden');
            };
            reader.readAsDataURL(file);
        }
    }

    function removeImage(previewId, containerId) {
        const previewElement = document.getElementById(previewId);
        const previewContainer = document.getElementById(containerId);
        const fileInput = document.getElementById(previewId === 'RegDocPreview' ? 'RegisterFile' : 'PanFile');
        previewElement.src = '#';
        previewContainer.classList.add('hidden');
        fileInput.value = '';
    }

    /* ── Overlay ── */
    const regOverlay  = document.getElementById('regOverlay');
    const regProgress = document.getElementById('regProgressFill');
    const regSteps    = [
        document.getElementById('regStep1'),
        document.getElementById('regStep2'),
        document.getElementById('regStep3'),
        document.getElementById('regStep4'),
    ];

    function setRegStep(index) {
        regSteps.forEach((el, i) => {
            el.classList.remove('done', 'active');
            if (i < index)  el.classList.add('done');
            if (i === index) el.classList.add('active');
        });
    }

    function showRegOverlay() {
        regOverlay.classList.add('active');
        const timeline = [
            { delay: 200,  pct: 20  },
            { delay: 950,  pct: 50  },
            { delay: 1800, pct: 78  },
            { delay: 2700, pct: 100 },
        ];
        timeline.forEach(({ delay, pct }, i) => {
            setTimeout(() => {
                setRegStep(i);
                regProgress.style.width = pct + '%';
            }, delay);
        });
    }

    document.getElementById('kycRegForm').addEventListener('submit', function (e) {
        if (!this.checkValidity()) return;
        showRegOverlay();
    });

    @if (TempData["ErrorMessage"] != null)
    {
            <text>
            Toastify({
                text: '@TempData["ErrorMessage"]',
                duration: 5000, close: true,
                gravity: "top", position: "right",
                backgroundColor: "linear-gradient(to right, #ff5f6d, #ffc371)",
                stopOnFocus: true
            }).showToast();
            </text>
    }
</script>