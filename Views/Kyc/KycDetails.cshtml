@model TenderSystem.Models.UserListEdit

@{
    ViewData["Title"] = "KYC Details";
    Layout = "_Layout";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
<script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

<style>
    :root {
        --navy: #0B1F3A;
        --navy-mid: #122848;
        --gold: #C8960C;
        --gold-lt: #E8B84B;
        --ivory: #F7F3EC;
        --slate: #8A9BB5;
        --white: #ffffff;
        --muted: #5a6a80;
    }

    /* ── BLEED ── */
    .kd-bleed {
        position: relative;
        left: 50%;
        width: 100vw;
        margin-left: -50vw;
        margin-top: -1.5rem;
        background: var(--ivory);
        min-height: 100vh;
        overflow-x: hidden;
        font-family: 'DM Sans', sans-serif;
    }

    /* ── HERO ── */
    .kd-hero {
        background: var(--navy);
        position: relative;
        overflow: hidden;
        padding: 2.8rem 2.5rem 5rem;
    }

        .kd-hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(200,150,12,.05) 1px, transparent 1px), linear-gradient(90deg, rgba(200,150,12,.05) 1px, transparent 1px);
            background-size: 40px 40px;
            pointer-events: none;
        }

        .kd-hero::after {
            content: '';
            position: absolute;
            top: -40%;
            right: -5%;
            width: 420px;
            height: 420px;
            background: radial-gradient(circle, rgba(200,150,12,.15) 0%, transparent 65%);
            pointer-events: none;
        }

    .kd-hero-inner {
        position: relative;
        z-index: 2;
        max-width: 1000px;
        margin: 0 auto;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .kd-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        font-size: .65rem;
        font-weight: 500;
        letter-spacing: .2em;
        text-transform: uppercase;
        color: var(--gold);
        margin-bottom: .5rem;
    }

        .kd-eyebrow span {
            display: inline-block;
            width: 18px;
            height: 1px;
            background: var(--gold);
        }

    .kd-hero h1 {
        font-family: 'Playfair Display', serif;
        font-size: clamp(1.5rem, 3vw, 2rem);
        font-weight: 900;
        color: var(--white);
        margin: 0 0 .3rem;
        line-height: 1.2;
    }

        .kd-hero h1 em {
            font-style: normal;
            color: var(--gold-lt);
        }

    .kd-hero-sub {
        font-size: .88rem;
        color: var(--slate);
        margin: 0;
    }

    .kd-hero-right {
        display: flex;
        align-items: center;
        gap: .75rem;
        flex-wrap: wrap;
    }

    /* status badge */
    .kd-status {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .35rem .9rem;
        border-radius: 6px;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
    }

    .kd-verified {
        background: linear-gradient(135deg,#10b981,#059669);
        color: #fff;
    }

    .kd-pending {
        background: linear-gradient(135deg,#f59e0b,#d97706);
        color: #fff;
    }

    /* back btn */
    .kd-back {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: .5rem 1.1rem;
        border-radius: 7px;
        background: rgba(200,150,12,.15);
        border: 1px solid rgba(200,150,12,.3);
        color: var(--gold-lt);
        font-size: .8rem;
        font-weight: 600;
        text-decoration: none;
        transition: background .2s, transform .2s;
    }

        .kd-back:hover {
            background: rgba(200,150,12,.25);
            transform: translateX(-2px);
            color: var(--gold-lt);
            text-decoration: none;
        }

    /* update kyc btn */
    .kd-update-btn {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: .5rem 1.1rem;
        border-radius: 7px;
        background: var(--gold);
        color: var(--navy);
        font-size: .8rem;
        font-weight: 700;
        text-decoration: none;
        transition: background .2s, transform .2s, box-shadow .2s;
        box-shadow: 0 3px 12px rgba(200,150,12,.3);
    }

        .kd-update-btn:hover {
            background: var(--gold-lt);
            transform: translateY(-1px);
            box-shadow: 0 5px 16px rgba(200,150,12,.4);
            color: var(--navy);
            text-decoration: none;
        }

    /* ── BODY ── */
    .kd-body {
        max-width: 1000px;
        margin: -2rem auto 3rem;
        padding: 0 1.5rem;
        position: relative;
        z-index: 2;
    }

    /* ── INFO CARD ── */
    .kd-card {
        background: var(--white);
        border-radius: 16px;
        border: 1px solid rgba(11,31,58,.07);
        box-shadow: 0 4px 24px rgba(11,31,58,.06);
        overflow: hidden;
        margin-bottom: 1.5rem;
        transition: box-shadow .3s;
    }

        .kd-card:hover {
            box-shadow: 0 8px 36px rgba(11,31,58,.1);
        }

    .kd-card-hd {
        padding: 1.1rem 1.6rem;
        background: var(--navy);
        display: flex;
        align-items: center;
        gap: .7rem;
    }

    .kd-card-icon {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        background: rgba(200,150,12,.15);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--gold);
        font-size: .9rem;
        flex-shrink: 0;
    }

    .kd-card-title {
        font-family: 'Playfair Display', serif;
        font-size: .95rem;
        font-weight: 700;
        color: var(--white);
        margin: 0;
        flex: 1;
    }

    .kd-card-body {
        padding: 1.6rem;
    }

    /* info grid */
    .kd-info-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.2rem;
    }

    .kd-info-item {
        display: flex;
        flex-direction: column;
        gap: .25rem;
    }

    .kd-info-label {
        font-size: .68rem;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--slate);
    }

    .kd-info-value {
        font-size: .9rem;
        font-weight: 600;
        color: var(--navy);
    }

        .kd-info-value.empty {
            color: var(--slate);
            font-style: italic;
            font-weight: 400;
        }

    .kd-info-link {
        color: var(--gold);
        text-decoration: none;
        font-weight: 600;
    }

        .kd-info-link:hover {
            color: var(--gold-lt);
            text-decoration: underline;
        }

    .kd-full-address {
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 1px solid rgba(11,31,58,.06);
    }

    /* ── DOCUMENTS ── */
    .kd-docs-divider {
        margin-top: 1.4rem;
        padding-top: 1.4rem;
        border-top: 1px solid rgba(11,31,58,.06);
    }

    .kd-docs-title {
        font-family: 'Playfair Display', serif;
        font-size: .95rem;
        font-weight: 700;
        color: var(--navy);
        margin-bottom: 1.1rem;
        display: flex;
        align-items: center;
        gap: .5rem;
    }

        .kd-docs-title i {
            color: var(--gold);
        }

    .kd-docs-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.2rem;
    }

    .kd-doc-card {
        background: var(--ivory);
        border-radius: 10px;
        border: 1px solid rgba(11,31,58,.07);
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

    .kd-doc-label {
        padding: .65rem 1rem;
        background: var(--navy);
        display: flex;
        align-items: center;
        gap: .4rem;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
        color: var(--gold-lt);
    }

        .kd-doc-label i {
            color: var(--gold);
            font-size: .8rem;
        }

    .kd-doc-img-wrap {
        overflow: hidden;
        position: relative;
    }

    .document-image {
        width: 100%;
        height: auto;
        display: block;
        transition: transform .3s ease;
        cursor: pointer;
    }

        .document-image:hover {
            transform: scale(1.03);
        }

    .kd-doc-placeholder {
        height: 160px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        gap: .5rem;
        color: var(--slate);
        font-size: .82rem;
        background: rgba(11,31,58,.03);
    }

        .kd-doc-placeholder i {
            font-size: 1.5rem;
            opacity: .4;
            color: var(--gold);
        }

    .kd-doc-actions {
        padding: .75rem 1rem;
        display: flex;
        justify-content: flex-end;
        border-top: 1px solid rgba(11,31,58,.05);
    }

    .kd-open-btn {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .4rem .9rem;
        border-radius: 6px;
        background: var(--navy);
        color: var(--white);
        font-size: .75rem;
        font-weight: 700;
        text-decoration: none;
        transition: background .2s, transform .2s;
    }

        .kd-open-btn:hover {
            background: var(--navy-mid);
            transform: translateY(-1px);
            color: var(--white);
            text-decoration: none;
        }

        .kd-open-btn i {
            color: var(--gold-lt);
            font-size: .72rem;
        }

    /* masked account */
    .kd-masked {
        font-family: monospace;
        letter-spacing: .08em;
        font-size: .9rem;
    }

    /* ── ZOOM OVERLAY ── */
    .zoom-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0,0,0,.92);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        opacity: 0;
        pointer-events: none;
        transition: opacity .3s ease;
    }

        .zoom-overlay.active {
            opacity: 1;
            pointer-events: auto;
        }

    .zoom-image {
        max-width: 90%;
        max-height: 90%;
        object-fit: contain;
        border-radius: 8px;
        box-shadow: 0 20px 60px rgba(0,0,0,.5);
    }

    .zoom-close {
        position: absolute;
        top: 1.2rem;
        right: 1.5rem;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: rgba(200,150,12,.2);
        border: 1.5px solid rgba(200,150,12,.4);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--gold-lt);
        font-size: 1.1rem;
        cursor: pointer;
        transition: background .2s;
    }

        .zoom-close:hover {
            background: rgba(200,150,12,.35);
        }

    @@media (max-width: 768px) {
        .kd-hero {
            padding: 2rem 1.2rem 4rem;
        }

        .kd-body {
            padding: 0 .75rem;
        }

        .kd-info-grid {
            grid-template-columns: 1fr;
        }

        .kd-docs-grid {
            grid-template-columns: 1fr;
        }

        .kd-card-body {
            padding: 1.2rem 1rem;
        }
    }
</style>

<div class="kd-bleed">

    <!-- HERO -->
    <div class="kd-hero">
        <div class="kd-hero-inner">
            <div>
                <p class="kd-eyebrow"><span></span> Bidder KYC</p>
                <h1>KYC <em>Details</em></h1>
                <p class="kd-hero-sub">Review your company and bank verification information</p>
            </div>
            <div class="kd-hero-right">
                <a asp-action="Index" asp-controller="BidTender" class="kd-back">
                    <i class="fas fa-arrow-left"></i> Back to Dashboard
                </a>
                <a asp-action="UpdateKyc" asp-controller="Kyc" class="kd-update-btn">
                    <i class="fas fa-pen"></i> Update KYC
                </a>
                @if (Model.IsVerified)
                {
                    <span class="kd-status kd-verified">
                        <i class="fas fa-shield-alt"></i> Verified
                    </span>
                }
                else
                {
                    <span class="kd-status kd-pending">
                        <i class="fas fa-clock"></i> Pending
                    </span>
                }
            </div>
        </div>
    </div>

    <!-- CONTENT -->
    <div class="kd-body">

        <!-- Company Information -->
        <div class="kd-card">
            <div class="kd-card-hd">
                <div class="kd-card-icon"><i class="fas fa-building"></i></div>
                <h2 class="kd-card-title">Company Information</h2>
            </div>
            <div class="kd-card-body">
                <div class="kd-info-grid">
                    <div class="kd-info-item">
                        <span class="kd-info-label">Company Name</span>
                        <span class="kd-info-value">@Model.CompanyName</span>
                    </div>
                    <div class="kd-info-item">
                        <span class="kd-info-label">Company Type</span>
                        <span class="kd-info-value">@Model.CompanyType</span>
                    </div>
                    <div class="kd-info-item">
                        <span class="kd-info-label">Position</span>
                        <span class="kd-info-value">@Model.Position</span>
                    </div>
                    <div class="kd-info-item">
                        <span class="kd-info-label">Registration Number</span>
                        <span class="kd-info-value">@Model.RegistrationNumber</span>
                    </div>
                    <div class="kd-info-item">
                        <span class="kd-info-label">PAN Number</span>
                        <span class="kd-info-value">@Model.PanNumber</span>
                    </div>
                    <div class="kd-info-item">
                        <span class="kd-info-label">Office Email</span>
                        <span class="kd-info-value">@Model.OfficeEmail</span>
                    </div>
                    <div class="kd-info-item">
                        <span class="kd-info-label">Website</span>
                        <span class="kd-info-value">
                            @if (!string.IsNullOrEmpty(Model.CompanyWebsiteUrl))
                            {
                                <a href="@Model.CompanyWebsiteUrl" target="_blank" class="kd-info-link">
                                    @Model.CompanyWebsiteUrl
                                </a>
                            }
                            else
                            {
                                <span class="empty">Not provided</span>
                            }
                        </span>
                    </div>
                </div>

                <div class="kd-full-address">
                    <div class="kd-info-item">
                        <span class="kd-info-label">Full Address</span>
                        <span class="kd-info-value">@Model.FullAddress</span>
                    </div>
                </div>

                <!-- Documents -->
                <div class="kd-docs-divider">
                    <h3 class="kd-docs-title">
                        <i class="fas fa-file-alt"></i> Verification Documents
                    </h3>
                    <div class="kd-docs-grid">

                        <!-- Registration Document -->
                        <div class="kd-doc-card">
                            <div class="kd-doc-label">
                                <i class="fas fa-file-contract"></i> Registration Document
                            </div>
                            @if (!string.IsNullOrEmpty(Model.RegistrationDocument))
                            {
                                <div class="kd-doc-img-wrap">
                                    <img src="~/RegisterImage/@Model.RegistrationDocument"
                                         alt="Registration Document"
                                         class="document-image"
                                         onclick="openZoomView(this.src)" />
                                </div>
                                <div class="kd-doc-actions">
                                    <a href="~/RegisterImage/@Model.RegistrationDocument"
                                       target="_blank" class="kd-open-btn">
                                        <i class="fas fa-external-link-alt"></i> Open in New Tab
                                    </a>
                                </div>
                            }
                            else
                            {
                                <div class="kd-doc-placeholder">
                                    <i class="fas fa-file-upload"></i>
                                    <span>Document not uploaded</span>
                                </div>
                            }
                        </div>

                        <!-- PAN Document -->
                        <div class="kd-doc-card">
                            <div class="kd-doc-label">
                                <i class="fas fa-id-card"></i> PAN Document
                            </div>
                            @if (!string.IsNullOrEmpty(Model.PanDocument))
                            {
                                <div class="kd-doc-img-wrap">
                                    <img src="~/PanImage/@Model.PanDocument"
                                         alt="PAN Document"
                                         class="document-image"
                                         onclick="openZoomView(this.src)" />
                                </div>
                                <div class="kd-doc-actions">
                                    <a href="~/PanImage/@Model.PanDocument"
                                       target="_blank" class="kd-open-btn">
                                        <i class="fas fa-external-link-alt"></i> Open in New Tab
                                    </a>
                                </div>
                            }
                            else
                            {
                                <div class="kd-doc-placeholder">
                                    <i class="fas fa-file-upload"></i>
                                    <span>Document not uploaded</span>
                                </div>
                            }
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <!-- Bank Information -->
        <div class="kd-card">
            <div class="kd-card-hd">
                <div class="kd-card-icon"><i class="fas fa-university"></i></div>
                <h2 class="kd-card-title">Bank Information</h2>
            </div>
            <div class="kd-card-body">
                <div class="kd-info-grid">
                    <div class="kd-info-item">
                        <span class="kd-info-label">Bank Name</span>
                        <span class="kd-info-value">@Model.BankName</span>
                    </div>
                    <div class="kd-info-item">
                        <span class="kd-info-label">Account Number</span>
                        <span class="kd-info-value">
                            @if (!string.IsNullOrEmpty(Model.AccountNumber))
                            {
                                <span class="kd-masked">
                                    @(new string('*', Model.AccountNumber.Length - 4) + Model.AccountNumber.Substring(Model.AccountNumber.Length - 4))
                                </span>
                            }
                            else
                            {
                                <span class="empty">Not provided</span>
                            }
                        </span>
                    </div>
                    <div class="kd-info-item">
                        <span class="kd-info-label">Account Holder Name</span>
                        <span class="kd-info-value">@Model.AccountHolderName</span>
                    </div>
                    <div class="kd-info-item">
                        <span class="kd-info-label">Account Type</span>
                        <span class="kd-info-value">@Model.AccountType</span>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- Image Zoom Overlay -->
<div id="zoomOverlay" class="zoom-overlay" onclick="closeZoomView()">
    <img id="zoomImage" class="zoom-image" src="/placeholder.svg" alt="Zoomed Document" />
    <div class="zoom-close" onclick="closeZoomView()">
        <i class="fas fa-times"></i>
    </div>
</div>

<script>
    // Function to open the zoom view
    function openZoomView(imageSrc) {
        document.getElementById('zoomImage').src = imageSrc;
        document.getElementById('zoomOverlay').classList.add('active');
        document.body.style.overflow = 'hidden'; // Prevent scrolling when zoom is active
    }

    // Function to close the zoom view
    function closeZoomView() {
        document.getElementById('zoomOverlay').classList.remove('active');
        document.body.style.overflow = ''; // Restore scrolling
    }

    // Close zoom view when pressing Escape key
    document.addEventListener('keydown', function(event) {
        if (event.key === 'Escape') {
            closeZoomView();
        }
    });

    @if (TempData["ErrorMessage"] != null)
    {
            <text>
                Toastify({
                    text: '@TempData["ErrorMessage"]',
                    duration: 5000,
                    close: true,
                    gravity: "top",
                    position: "right",
                    backgroundColor: "linear-gradient(to right, #ff5f6d, #ffc371)",
                    stopOnFocus: true
                }).showToast();
            </text>
    }

    @if (TempData["SuccessMessage"] != null)
    {
            <text>
                Toastify({
                    text: '@TempData["SuccessMessage"]',
                    duration: 5000,
                    close: true,
                    gravity: "top",
                    position: "right",
                    backgroundColor: "linear-gradient(to right, #ff5f6d, #ffc371)",
                    stopOnFocus: true
                }).showToast();
            </text>
    }
</script>
