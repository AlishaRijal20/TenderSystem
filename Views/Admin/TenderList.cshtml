@model IEnumerable<TenderEdit>
@{
    ViewData["Title"] = "Tender List";
    Layout = "_Layout";
}

<style>
    :root {
        --navy: #0B1F3A;
        --navy-mid: #122848;
        --gold: #C8960C;
        --gold-lt: #E8B84B;
        --ivory: #F7F3EC;
        --slate: #8A9BB5;
        --white: #ffffff;
        --muted: #5a6a80;
    }

    .tl-wrap {
        background: var(--ivory);
        min-height: 100vh;
        padding: 2rem;
        font-family: 'DM Sans', sans-serif;
    }

    .back-btn {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        color: var(--muted);
        font-size: .88rem;
        font-weight: 500;
        background: none;
        border: none;
        cursor: pointer;
        padding: 0;
        margin-bottom: 1.5rem;
        transition: color .2s, transform .2s;
    }

        .back-btn:hover {
            color: var(--navy);
            transform: translateX(-4px);
        }

    .tl-header {
        background: var(--navy);
        border-radius: 12px;
        padding: 2.2rem 2.5rem;
        margin-bottom: 1.8rem;
        position: relative;
        overflow: hidden;
    }

        .tl-header::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(200,150,12,.05) 1px, transparent 1px), linear-gradient(90deg, rgba(200,150,12,.05) 1px, transparent 1px);
            background-size: 40px 40px;
            pointer-events: none;
        }

        .tl-header::after {
            content: '';
            position: absolute;
            top: -40%;
            right: -5%;
            width: 280px;
            height: 280px;
            background: radial-gradient(circle, rgba(200,150,12,.14) 0%, transparent 70%);
            pointer-events: none;
        }

    .tl-header-content {
        position: relative;
        z-index: 1;
    }

    .tl-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        font-size: .68rem;
        font-weight: 500;
        letter-spacing: .2em;
        text-transform: uppercase;
        color: var(--gold);
        margin-bottom: .6rem;
    }

        .tl-eyebrow span {
            display: inline-block;
            width: 20px;
            height: 1px;
            background: var(--gold);
        }

    .tl-header h1 {
        font-family: 'Playfair Display', serif;
        font-size: clamp(1.5rem, 2.8vw, 2.2rem);
        font-weight: 900;
        color: var(--white);
        margin: 0 0 .3rem;
    }

        .tl-header h1 em {
            font-style: normal;
            color: var(--gold-lt);
        }

    .tl-header p {
        color: var(--slate);
        font-size: .88rem;
        font-weight: 300;
        margin: 0;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1.1rem;
        margin-bottom: 1.8rem;
    }

    .stats-card {
        background: var(--white);
        border-radius: 10px;
        padding: 1.4rem 1.6rem;
        border: 1px solid rgba(11,31,58,.07);
        position: relative;
        overflow: hidden;
        transition: transform .3s, box-shadow .3s;
        cursor: pointer;
    }

        .stats-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 3px;
            height: 100%;
            opacity: 0;
            transition: opacity .3s;
        }

        .stats-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 14px 36px rgba(11,31,58,.09);
        }

            .stats-card:hover::before {
                opacity: 1;
            }

    .stats-card--blue::before {
        background: #3b82f6;
    }

    .stats-card--green::before {
        background: #10b981;
    }

    .stats-card--yellow::before {
        background: #f59e0b;
    }

    .stats-card--red::before {
        background: #ef4444;
    }

    .stats-inner {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .stats-icon {
        width: 48px;
        height: 48px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        flex-shrink: 0;
    }

    .stats-icon--blue {
        background: rgba(59,130,246,.1);
        color: #3b82f6;
    }

    .stats-icon--green {
        background: rgba(16,185,129,.1);
        color: #10b981;
    }

    .stats-icon--yellow {
        background: rgba(245,158,11,.1);
        color: #f59e0b;
    }

    .stats-icon--red {
        background: rgba(239,68,68,.1);
        color: #ef4444;
    }

    .stats-label {
        font-size: .72rem;
        font-weight: 500;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--slate);
        margin-bottom: .3rem;
    }

    .stats-value {
        font-family: 'Playfair Display', serif;
        font-size: 1.9rem;
        font-weight: 700;
        color: var(--navy);
        line-height: 1;
    }

    .table-section {
        background: var(--white);
        border-radius: 10px;
        border: 1px solid rgba(11,31,58,.07);
        overflow: hidden;
    }

    .table-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
        padding: 1.5rem 1.8rem;
        border-bottom: 1px solid rgba(11,31,58,.06);
    }

    .table-toolbar-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--navy);
        display: flex;
        align-items: center;
        gap: .5rem;
    }

        .table-toolbar-title i {
            color: var(--gold);
        }

    .table-controls {
        display: flex;
        gap: .75rem;
        flex-wrap: wrap;
    }

        .table-controls select,
        .table-controls input {
            background: var(--ivory);
            border: 1px solid rgba(11,31,58,.12);
            color: var(--navy);
            font-size: .85rem;
            font-family: 'DM Sans', sans-serif;
            border-radius: 6px;
            padding: .55rem 1rem;
            outline: none;
            transition: border-color .2s;
            min-width: 170px;
        }

            .table-controls select:focus,
            .table-controls input:focus {
                border-color: var(--gold);
                box-shadow: 0 0 0 3px rgba(200,150,12,.08);
            }

            .table-controls input::placeholder {
                color: var(--slate);
            }

    .tender-table {
        width: 100%;
        border-collapse: collapse;
        font-size: .875rem;
    }

        .tender-table thead tr {
            background: var(--navy);
        }

        .tender-table thead th {
            padding: .9rem 1.4rem;
            font-size: .65rem;
            font-weight: 600;
            letter-spacing: .14em;
            text-transform: uppercase;
            color: var(--slate);
            text-align: left;
            position: sticky;
            top: 0;
            z-index: 10;
        }

    .tender-row {
        border-bottom: 1px solid rgba(11,31,58,.05);
        transition: background .2s;
    }

        .tender-row:last-child {
            border-bottom: none;
        }

        .tender-row:hover {
            background: rgba(200,150,12,.04) !important;
        }

    .tender-table td {
        padding: 1rem 1.4rem;
        color: var(--muted);
        vertical-align: middle;
    }

    .tender-title {
        color: var(--navy);
        font-weight: 600;
        font-size: .9rem;
    }

    .tender-type-tag {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        padding: .2rem .7rem;
        border-radius: 4px;
        background: rgba(200,150,12,.1);
        color: var(--gold);
        font-size: .68rem;
        font-weight: 600;
        letter-spacing: .04em;
        margin-top: .3rem;
    }

    .status-badge {
        padding: .3rem .85rem;
        border-radius: 999px;
        font-size: .68rem;
        font-weight: 600;
        letter-spacing: .05em;
        text-transform: uppercase;
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        transition: transform .2s;
    }

        .status-badge:hover {
            transform: translateY(-1px);
        }

    .status-verified {
        background: rgba(16,185,129,.1);
        color: #059669;
    }

    .status-pending {
        background: rgba(245,158,11,.1);
        color: #b45309;
    }

    .status-notverified {
        background: rgba(239,68,68,.1);
        color: #dc2626;
    }

    .issuer-wrap {
        display: flex;
        align-items: center;
        gap: .6rem;
    }

    .issuer-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: rgba(200,150,12,.1);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--gold);
        font-size: .8rem;
        flex-shrink: 0;
    }

    .date-wrap {
        display: flex;
        align-items: center;
        gap: .4rem;
        font-size: .85rem;
    }

    .action-btn {
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        text-decoration: none;
        font-size: .82rem;
        transition: background .2s, transform .2s;
    }

        .action-btn:hover {
            transform: scale(1.1);
        }

    .empty-state {
        padding: 3.5rem;
        text-align: center;
    }

    .empty-icon {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: rgba(200,150,12,.1);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1rem;
        color: var(--gold);
        font-size: 1.5rem;
    }

    .verify-form-hidden {
        display: none !important;
    }

    /* Loading Overlay */
    .loading-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(11, 31, 58, 0.55);
        backdrop-filter: blur(4px);
        z-index: 9999;
        justify-content: center;
        align-items: center;
    }

        .loading-overlay.active {
            display: flex;
        }

    .loading-box {
        background: var(--white);
        border-radius: 16px;
        padding: 2.5rem 3rem;
        text-align: center;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
        animation: fadeInUp 0.3s ease;
        max-width: 360px;
        width: 90%;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .loading-spinner {
        width: 48px;
        height: 48px;
        border: 4px solid rgba(200, 150, 12, 0.2);
        border-top-color: var(--gold);
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        margin: 0 auto 1.2rem;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    .loading-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--navy);
        margin-bottom: 0.4rem;
    }

    .loading-text {
        font-size: 0.85rem;
        color: var(--slate);
        line-height: 1.5;
    }

    .loading-subtext {
        font-size: 0.72rem;
        color: var(--muted);
        margin-top: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
    }

        .loading-subtext i {
            color: var(--gold);
            animation: pulse 1.5s ease-in-out infinite;
        }

    @@keyframes pulse {
        0%, 100% {
            opacity: 0.4;
        }

        50% {
            opacity: 1;
        }
    }
</style>

<div class="tl-wrap">

    <!-- Loading Overlay -->
    <div class="loading-overlay" id="loadingOverlay">
        <div class="loading-box">
            <div class="loading-spinner"></div>
            <div class="loading-title" id="loadingTitle">Processing...</div>
            <div class="loading-text" id="loadingText">Updating tender status and sending email notifications.</div>
            <div class="loading-subtext">
                <i class="fas fa-envelope"></i> This may take a few seconds
            </div>
        </div>
    </div>

    <button onclick="history.back()" class="back-btn">
        <i class="fas fa-arrow-left"></i>
        <span>Back</span>
    </button>

    <div class="tl-header">
        <div class="tl-header-content">
            <p class="tl-eyebrow"><span></span> Admin Panel</p>
            <h1>Tender <em>Management</em></h1>
            <p>Monitor and manage all tender listings in one place</p>
        </div>
    </div>

    <div class="stats-grid">
        <div class="stats-card stats-card--blue" id="filter-all">
            <div class="stats-inner">
                <div class="stats-icon stats-icon--blue"><i class="fas fa-file-signature"></i></div>
                <div>
                    <p class="stats-label">Total Tenders</p>
                    <h3 class="stats-value">@ViewBag.TotalTenders</h3>
                </div>
            </div>
        </div>
        <div class="stats-card stats-card--green" id="filter-verified">
            <div class="stats-inner">
                <div class="stats-icon stats-icon--green"><i class="fas fa-check-circle"></i></div>
                <div>
                    <p class="stats-label">Verified</p>
                    <h3 class="stats-value">@ViewBag.VerifiedTenders</h3>
                </div>
            </div>
        </div>
        <div class="stats-card stats-card--yellow" id="filter-pending">
            <div class="stats-inner">
                <div class="stats-icon stats-icon--yellow"><i class="fas fa-clock"></i></div>
                <div>
                    <p class="stats-label">Pending</p>
                    <h3 class="stats-value">@ViewBag.PendingTenders</h3>
                </div>
            </div>
        </div>
        <div class="stats-card stats-card--red" id="filter-notverified">
            <div class="stats-inner">
                <div class="stats-icon stats-icon--red"><i class="fas fa-times-circle"></i></div>
                <div>
                    <p class="stats-label">Not Verified</p>
                    <h3 class="stats-value">@ViewBag.NotVerifiedTenders</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="table-section">
        <div class="table-toolbar">
            <h2 class="table-toolbar-title">
                <i class="fas fa-list"></i> Tender List
            </h2>
            <div class="table-controls">
                <select id="statusFilter">
                    <option value="">All Status</option>
                    <option value="verified">Verified</option>
                    <option value="not verified">Not Verified</option>
                    <option value="pending">Pending</option>
                </select>
                <input type="text" id="searchInput" placeholder="Search tenders..." />
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="tender-table">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Budget</th>
                        <th>Issued By</th>
                        <th>Opening Date</th>
                        <th>Closing Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var tender in Model)
                        {
                            <tr class="tender-row" data-status="@tender.IsVerified.ToLower()">
                                <td>
                                    <div class="tender-title">@tender.Title</div>
                                    <div class="tender-type-tag">
                                        <i class="fas fa-tag"></i> @tender.TenderType
                                    </div>
                                </td>
                                <td>
                                    <div class="date-wrap" style="color:var(--navy);font-weight:500;">
                                        <i class="fas fa-rupee-sign" style="color:var(--gold);"></i>
                                        @tender.BudgetEstimation.ToString("N0")
                                    </div>
                                </td>
                                <td>
                                    <div class="issuer-wrap">
                                        <div class="issuer-avatar"><i class="fas fa-user"></i></div>
                                        @tender.IssuedBy
                                    </div>
                                </td>
                                <td>
                                    <div class="date-wrap">
                                        <i class="fas fa-calendar-day" style="color:#10b981;"></i>
                                        @tender.OpeningDate.ToString("MMM dd, yyyy")
                                    </div>
                                </td>
                                <td>
                                    <div class="date-wrap">
                                        <i class="fas fa-calendar-times" style="color:#ef4444;"></i>
                                        @tender.ClosingDate.ToString("MMM dd, yyyy")
                                    </div>
                                </td>
                                <td>
                                    @if (tender.IsVerified == "Verified")
                                    {
                                        <span class="status-badge status-verified">
                                            <i class="fas fa-check-circle"></i> Verified
                                        </span>
                                    }
                                    else if (tender.IsVerified == "Pending")
                                    {
                                        <span class="status-badge status-pending">
                                            <i class="fas fa-clock"></i> Pending
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-notverified">
                                            <i class="fas fa-times-circle"></i> Not Verified
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="flex gap-2">
                                        <a asp-action="AdminTenderDetails" asp-controller="Admin" asp-route-id="@tender.EncId"
                                           class="action-btn bg-blue-50 text-blue-600 hover:bg-blue-100"
                                           data-tooltip-target="tooltip-view-@tender.TenderId">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <div id="tooltip-view-@tender.TenderId" role="tooltip" class="absolute z-10 invisible inline-block px-3 py-2 text-sm font-medium text-white transition-opacity duration-300 bg-gray-900 rounded-lg shadow-sm opacity-0 tooltip">
                                            View Details
                                            <div class="tooltip-arrow" data-popper-arrow></div>
                                        </div>
                                        @if (tender.IsVerified == "Pending")
                                        {
                                            <a href="javascript:void(0);"
                                               class="action-btn bg-green-50 text-green-600 hover:bg-green-100 verify-btn"
                                               data-id="@tender.TenderId" data-status="Verified"
                                               data-tooltip-target="tooltip-verify-@tender.TenderId">
                                                <i class="fas fa-check-circle"></i>
                                            </a>
                                            <div id="tooltip-verify-@tender.TenderId" role="tooltip" class="absolute z-10 invisible inline-block px-3 py-2 text-sm font-medium text-white transition-opacity duration-300 bg-gray-900 rounded-lg shadow-sm opacity-0 tooltip">
                                                Verify Tender
                                                <div class="tooltip-arrow" data-popper-arrow></div>
                                            </div>
                                            <a href="javascript:void(0);"
                                               class="action-btn bg-red-50 text-red-600 hover:bg-red-100 verify-btn"
                                               data-id="@tender.TenderId" data-status="Not Verified"
                                               data-tooltip-target="tooltip-reject-@tender.TenderId">
                                                <i class="fas fa-times-circle"></i>
                                            </a>
                                            <div id="tooltip-reject-@tender.TenderId" role="tooltip" class="absolute z-10 invisible inline-block px-3 py-2 text-sm font-medium text-white transition-opacity duration-300 bg-gray-900 rounded-lg shadow-sm opacity-0 tooltip">
                                                Reject Tender
                                                <div class="tooltip-arrow" data-popper-arrow></div>
                                            </div>
                                        }
                                        <form id="verifyForm_@tender.TenderId" class="verify-form-hidden" method="POST" asp-action="UpdateVerifiedStatus" asp-controller="Admin">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="TenderId" value="@tender.TenderId" />
                                            <input type="hidden" name="IsVerified" id="status_@tender.TenderId" />
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7">
                                <div class="empty-state">
                                    <div class="empty-icon"><i class="fas fa-file-alt"></i></div>
                                    <h3 style="font-family:'Playfair Display',serif;font-size:1.1rem;color:var(--navy);margin-bottom:.4rem;">No tenders found</h3>
                                    <p style="color:var(--slate);font-size:.88rem;">There are no tenders matching your criteria.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.2.1/flowbite.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Initialize tooltips
        const tooltipTriggerList = document.querySelectorAll('[data-tooltip-target]');
        tooltipTriggerList.forEach(tooltipTriggerEl => {
            const targetId = tooltipTriggerEl.getAttribute('data-tooltip-target');
            const targetElement = document.getElementById(targetId);
            if (targetElement) {
                tooltipTriggerEl.addEventListener('mouseenter', () => {
                    targetElement.classList.remove('invisible', 'opacity-0');
                    targetElement.classList.add('opacity-100');
                    const rect = tooltipTriggerEl.getBoundingClientRect();
                    targetElement.style.top = `${rect.bottom + 10}px`;
                    targetElement.style.left = `${rect.left + (rect.width / 2) - (targetElement.offsetWidth / 2)}px`;
                });
                tooltipTriggerEl.addEventListener('mouseleave', () => {
                    targetElement.classList.add('invisible', 'opacity-0');
                    targetElement.classList.remove('opacity-100');
                });
            }
        });

        // Loading overlay helpers
        const loadingOverlay = document.getElementById('loadingOverlay');
        const loadingTitle = document.getElementById('loadingTitle');
        const loadingText = document.getElementById('loadingText');

        function showLoading(status) {
            if (status === 'Verified') {
                loadingTitle.textContent = 'Verifying Tender...';
                loadingText.textContent = 'Updating status and notifying the publisher & all bidders via email.';
            } else {
                loadingTitle.textContent = 'Rejecting Tender...';
                loadingText.textContent = 'Updating status and notifying the publisher via email.';
            }
            loadingOverlay.classList.add('active');
        }

        function hideLoading() {
            loadingOverlay.classList.remove('active');
        }

        // Verify/Reject buttons
        document.querySelectorAll('.verify-btn').forEach(button => {
            button.addEventListener('click', function () {
                let tenderId = this.getAttribute('data-id');
                let status = this.getAttribute('data-status');
                let form = document.getElementById(`verifyForm_${tenderId}`);
                form.querySelector('input[name="IsVerified"]').value = status;
                if (confirm(`Are you sure you want to mark this tender as ${status}?`)) {
                    showLoading(status);
                    fetch(form.action, {
                        method: form.method,
                        body: new FormData(form),
                        headers: {
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                        }
                    })
                        .then(response => response.json())
                        .then(data => {
                            hideLoading();
                            if (data.success) {
                                alert(`Tender ${status} successfully!`);
                                location.reload();
                            } else {
                                alert("Failed to update tender status.");
                            }
                        })
                        .catch(error => {
                            hideLoading();
                            console.error("Error:", error);
                            alert("Something went wrong. Please try again.");
                        });
                }
            });
        });

        const statusFilter = document.getElementById("statusFilter");
        const searchInput = document.getElementById("searchInput");
        const tenderRows = document.querySelectorAll(".tender-row");

        // Quick filter via stat cards — scoped by ID, safe from navbar interference
        document.getElementById('filter-all').addEventListener('click', function () {
            statusFilter.value = '';
            filterTenders();
        });
        document.getElementById('filter-verified').addEventListener('click', function () {
            statusFilter.value = 'verified';
            filterTenders();
        });
        document.getElementById('filter-pending').addEventListener('click', function () {
            statusFilter.value = 'pending';
            filterTenders();
        });
        document.getElementById('filter-notverified').addEventListener('click', function () {
            statusFilter.value = 'not verified';
            filterTenders();
        });

        function filterTenders() {
            const filterValue = statusFilter.value.toLowerCase();
            const searchText = searchInput.value.toLowerCase();
            tenderRows.forEach(row => {
                const tenderStatus = row.getAttribute("data-status");
                const title = row.querySelector("td:nth-child(1)").textContent.toLowerCase();
                const budget = row.querySelector("td:nth-child(2)").textContent.toLowerCase();
                const issuedBy = row.querySelector("td:nth-child(3)").textContent.toLowerCase();
                const statusMatch = filterValue === "" || tenderStatus === filterValue;
                const searchMatch = searchText === "" || title.includes(searchText) || budget.includes(searchText) || issuedBy.includes(searchText);
                if (statusMatch && searchMatch) {
                    row.style.display = "";
                } else {
                    row.style.display = "none";
                }
            });
        }

        statusFilter.addEventListener("change", filterTenders);
        searchInput.addEventListener("input", filterTenders);
        filterTenders();
    });
</script>
