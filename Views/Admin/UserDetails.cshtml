@model UserDetailsViewModel
@{
    ViewData["Title"] = "User Details";
    Layout = "_Layout";
}

<!-- Flowbite CSS -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.2.1/flowbite.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@300;400;500;700&display=swap" rel="stylesheet" />

<style>
    :root {
        --navy: #0B1F3A;
        --navy-mid: #122848;
        --gold: #C8960C;
        --gold-lt: #E8B84B;
        --ivory: #F7F3EC;
        --slate: #8A9BB5;
        --white: #ffffff;
        --muted: #5a6a80;
    }

    .ud-wrap {
        background: var(--ivory);
        min-height: 100vh;
        padding: 2rem;
        font-family: 'DM Sans', sans-serif;
    }

    /* ── BACK ── */
    .back-button {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        color: var(--muted);
        font-size: .88rem;
        font-weight: 500;
        background: none;
        border: none;
        cursor: pointer;
        padding: 0;
        margin-bottom: 1.5rem;
        transition: color .2s, transform .2s;
        text-decoration: none;
    }

        .back-button:hover {
            color: var(--navy);
            transform: translateX(-4px);
        }

    /* ── HERO HEADER ── */
    .user-header {
        background: var(--navy);
        border-radius: 12px 12px 0 0;
        padding: 2.4rem 2.5rem 2rem;
        position: relative;
        overflow: hidden;
    }

        .user-header::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(200,150,12,.05) 1px, transparent 1px), linear-gradient(90deg, rgba(200,150,12,.05) 1px, transparent 1px);
            background-size: 40px 40px;
            pointer-events: none;
        }

        .user-header::after {
            content: '';
            position: absolute;
            top: -50%;
            right: -10%;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(200,150,12,.12) 0%, transparent 65%);
            pointer-events: none;
        }

    .user-header-content {
        position: relative;
        z-index: 1;
    }

    .ud-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        font-size: .68rem;
        font-weight: 500;
        letter-spacing: .2em;
        text-transform: uppercase;
        color: var(--gold);
        margin-bottom: .7rem;
    }

        .ud-eyebrow span {
            display: inline-block;
            width: 20px;
            height: 1px;
            background: var(--gold);
        }

    .user-header h1 {
        font-family: 'Playfair Display', serif;
        font-size: clamp(1.5rem, 2.8vw, 2.2rem);
        font-weight: 900;
        color: var(--white);
        margin: 0 0 .8rem;
    }

        .user-header h1 em {
            font-style: normal;
            color: var(--gold-lt);
        }

    .header-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 1.2rem;
        color: rgba(138,155,181,.9);
        font-size: .88rem;
    }

        .header-meta span {
            display: flex;
            align-items: center;
            gap: .4rem;
        }

    /* ── INFO CARD ── */
    .info-card {
        background: var(--white);
        border-radius: 10px;
        border: 1px solid rgba(11,31,58,.07);
        overflow: hidden;
        margin-bottom: 1.4rem;
        transition: transform .3s, box-shadow .3s;
    }

        .info-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 16px 40px rgba(11,31,58,.09);
        }

    .card-header {
        background: var(--navy-mid);
        color: var(--white);
        padding: 1.1rem 1.6rem;
        font-weight: 600;
        font-size: .92rem;
        display: flex;
        align-items: center;
        gap: .7rem;
        border-bottom: 1px solid rgba(200,150,12,.15);
    }

        .card-header i {
            color: var(--gold);
        }

    .card-body {
        padding: 1.8rem;
    }

    /* ── PROFILE IMAGE ── */
    .profile-image-container {
        width: 160px;
        height: 160px;
        margin: 0 auto;
        position: relative;
    }

    .profile-image {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid var(--gold);
        box-shadow: 0 4px 20px rgba(200,150,12,.25);
        transition: transform .3s;
    }

        .profile-image:hover {
            transform: scale(1.05);
        }

    /* ── BADGE ── */
    .badge {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        padding: .3rem .9rem;
        border-radius: 999px;
        font-size: .72rem;
        font-weight: 600;
        letter-spacing: .05em;
        text-transform: uppercase;
    }

    .badge-gold {
        background: rgba(200,150,12,.12);
        color: var(--gold);
        border: 1px solid rgba(200,150,12,.2);
    }

    /* ── INFO ITEMS ── */
    .info-item {
        padding: .9rem 0;
        border-bottom: 1px solid rgba(11,31,58,.05);
        display: flex;
        flex-direction: column;
        gap: .35rem;
    }

        .info-item:last-child {
            border-bottom: none;
        }

    .info-label {
        color: var(--slate);
        font-size: .78rem;
        font-weight: 600;
        letter-spacing: .06em;
        text-transform: uppercase;
        display: flex;
        align-items: center;
        gap: .4rem;
    }

        .info-label i {
            color: var(--gold);
            width: 14px;
        }

    .info-value {
        color: var(--navy);
        font-weight: 500;
        font-size: .92rem;
    }

    /* ── DOCUMENT IMAGES ── */
    .document-container {
        position: relative;
    }

    .document-image {
        border: 1px solid rgba(11,31,58,.1);
        border-radius: 8px;
        overflow: hidden;
        max-width: 100%;
        box-shadow: 0 2px 8px rgba(11,31,58,.07);
        transition: transform .3s, box-shadow .3s;
    }

        .document-image:hover {
            transform: scale(1.02);
            box-shadow: 0 6px 20px rgba(11,31,58,.12);
        }

    .image-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(11,31,58,.6);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity .3s;
        border-radius: 8px;
    }

    .document-container:hover .image-overlay {
        opacity: 1;
    }

    .view-full-btn {
        background: rgba(255,255,255,.92);
        color: var(--navy);
        padding: .5rem 1rem;
        border-radius: 6px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: .5rem;
        transition: all .2s;
        font-size: .85rem;
    }

        .view-full-btn:hover {
            background: var(--white);
            transform: scale(1.04);
        }

    /* ── NO DOC PLACEHOLDER ── */
    .no-doc {
        padding: 2rem;
        background: var(--ivory);
        border-radius: 8px;
        border: 1px dashed rgba(11,31,58,.15);
        text-align: center;
        color: var(--slate);
    }

    /* ── RATING ── */
    .rating-stars {
        display: flex;
        align-items: center;
        gap: .2rem;
    }

    .star {
        color: var(--gold);
    }

    /* ── MESSAGE BUTTON ── */
    .message-button {
        display: inline-flex;
        align-items: center;
        gap: .55rem;
        padding: .8rem 1.8rem;
        background: var(--gold);
        color: var(--navy);
        border-radius: 6px;
        font-weight: 700;
        font-size: .9rem;
        margin-top: 1.2rem;
        transition: background .25s, transform .2s, box-shadow .2s;
        text-decoration: none;
        box-shadow: 0 4px 16px rgba(200,150,12,.3);
    }

        .message-button:hover {
            background: var(--gold-lt);
            transform: translateY(-2px);
            box-shadow: 0 6px 22px rgba(200,150,12,.35);
            text-decoration: none;
            color: var(--navy);
        }

    /* ── SECTION HEADING ── */
    .doc-section-title {
        font-family: 'Playfair Display', serif;
        font-size: 1rem;
        font-weight: 700;
        color: var(--navy);
        margin-bottom: 1.2rem;
        display: flex;
        align-items: center;
        gap: .5rem;
    }

        .doc-section-title i {
            color: var(--gold);
        }

    .doc-sub-title {
        font-size: .88rem;
        font-weight: 600;
        color: var(--muted);
        margin-bottom: .75rem;
        display: flex;
        align-items: center;
        gap: .4rem;
    }

        .doc-sub-title i {
            color: var(--gold);
        }
</style>

<div class="ud-wrap">

    <!-- Back Button -->
    <button onclick="history.back()" class="back-button">
        <i class="fas fa-arrow-left"></i>
        <span>Back</span>
    </button>

    <!-- User Header -->
    <div class="user-header">
        <div class="user-header-content">
            <p class="ud-eyebrow"><span></span> Admin Panel</p>
            <h1>User <em>Details</em></h1>
            <div class="header-meta">
                <span><i class="fas fa-user"></i> @Model.User.FirstName @Model.User.LastName</span>
                <span><i class="fas fa-user-tag"></i> @Model.User.UserRole</span>
            </div>
        </div>
    </div>

    <div style="background:var(--white);border-radius:0 0 12px 12px;border:1px solid rgba(11,31,58,.07);border-top:none;">

        <!-- Personal Information -->
        <div class="info-card" style="border-radius:0;margin-bottom:0;border-left:none;border-right:none;border-top:none;">
            <div class="card-header">
                <i class="fas fa-user-circle"></i>
                Personal Information
            </div>
            <div class="card-body">
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <!-- Profile Image -->
                    <div class="text-center">
                        <div class="profile-image-container mb-4">
                            @if (!string.IsNullOrEmpty(Model.User.UserPhoto))
                            {
                                <img src="~/UserImage/@Model.User.UserPhoto" alt="User Photo" class="profile-image">
                            }
                            else
                            {
                                <img src="~/images/default-user.png" alt="Default Photo" class="profile-image">
                            }
                        </div>
                        <div class="mt-2">
                            <span class="badge badge-gold">
                                <i class="fas fa-user-tag"></i>
                                @Model.User.UserRole
                            </span>
                        </div>
                    </div>

                    <!-- User Details -->
                    <div class="lg:col-span-2">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="info-item">
                                <span class="info-label"><i class="fas fa-user"></i> Full Name</span>
                                <span class="info-value">@Model.User.FirstName @Model.User.MiddleName @Model.User.LastName</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label"><i class="fas fa-envelope"></i> Email</span>
                                <span class="info-value">@Model.User.EmailAddress</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label"><i class="fas fa-phone"></i> Phone</span>
                                <span class="info-value">@Model.User.Phone</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label"><i class="fas fa-venus-mars"></i> Gender</span>
                                <span class="info-value">@Model.User.Gender</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label"><i class="fas fa-map-marker-alt"></i> Address</span>
                                <span class="info-value">@Model.User.City, @Model.User.District, @Model.User.Province</span>
                            </div>
                        </div>
                        <a asp-action="UserMessage" asp-controller="Chat" asp-route-receiverId="@Model.User.UserId"
                           class="message-button">
                            <i class="fas fa-paper-plane"></i>
                            Send Message
                        </a>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.User.UserRole == "Bidder" && Model.Company != null)
        {
            <!-- Company Information -->
            <div class="info-card" style="border-radius:0;margin-bottom:0;border-left:none;border-right:none;border-top:none;">
                <div class="card-header">
                    <i class="fas fa-building"></i>
                    Company Information
                </div>
                <div class="card-body">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="info-item">
                            <span class="info-label"><i class="fas fa-building"></i> Company Name</span>
                            <span class="info-value">@Model.Company.CompanyName</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label"><i class="fas fa-map-marked-alt"></i> Full Address</span>
                            <span class="info-value">@Model.Company.FullAddress</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label"><i class="fas fa-envelope"></i> Office Email</span>
                            <span class="info-value">@Model.Company.OfficeEmail</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label"><i class="fas fa-globe"></i> Website</span>
                            <span class="info-value">
                                @if (!string.IsNullOrEmpty(Model.Company.CompanyWebsiteUrl))
                                {
                                    <a href="@Model.Company.CompanyWebsiteUrl" target="_blank" style="color:var(--gold);text-decoration:underline;">
                                        @Model.Company.CompanyWebsiteUrl
                                    </a>
                                }
                                else
                                {
                                    <span>Not provided</span>
                                }
                            </span>
                        </div>
                        <div class="info-item">
                            <span class="info-label"><i class="fas fa-id-card"></i> Registration Number</span>
                            <span class="info-value">@Model.Company.RegistrationNumber</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label"><i class="fas fa-receipt"></i> PAN Number</span>
                            <span class="info-value">@Model.Company.PanNumber</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label"><i class="fas fa-building"></i> Company Type</span>
                            <span class="info-value">@Model.Company.CompanyType</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label"><i class="fas fa-user-tie"></i> Position</span>
                            <span class="info-value">@Model.Company.Position</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label"><i class="fas fa-star"></i> Rating</span>
                            <div class="rating-stars">
                                @{
                                    decimal rating = Model.Company.Rating.HasValue ? Model.Company.Rating.Value : 0;
                                    int fullStars = (int)Math.Floor(rating);
                                    bool hasHalfStar = (rating - fullStars) >= 0.5m;
                                    for (int i = 0; i < fullStars; i++)
                                    {
                                        <i class="fas fa-star star"></i>
                                    }
                                    if (hasHalfStar)
                                    {

                                        <i class="fas fa-star-half-alt star"></i>
                                    }
                                    int emptyStars = 5 - fullStars - (hasHalfStar ? 1 : 0);
                                    for (int i = 0; i < emptyStars; i++)
                                    {

                                        <i class="far fa-star" style="color:var(--slate);"></i>
                                    }
                                }
                                <span style="margin-left:.5rem;color:var(--muted);font-size:.85rem;">(@(Model.Company.Rating.HasValue? Model.Company.Rating.Value.ToString("0.0") : "0.0"))</span>
                            </div>
                        </div>
                    </div>

                    <!-- Documents -->
                    <h3 class="doc-section-title" style="margin-top:2rem;">
                        <i class="fas fa-folder-open"></i> Company Documents
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <p class="doc-sub-title"><i class="fas fa-file-alt"></i> Registration Document</p>
                            @if (!string.IsNullOrEmpty(Model.Company.RegistrationDocument))
                            {
                                <div class="document-container">
                                    <img src="~/RegisterImage/@Model.Company.RegistrationDocument" alt="Registration Document" class="document-image">
                                    <div class="image-overlay">
                                        <span class="view-full-btn"><i class="fas fa-expand-alt"></i> View Full</span>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="no-doc">
                                    <i class="fas fa-file-excel" style="font-size:2rem;opacity:.4;display:block;margin-bottom:.5rem;"></i>
                                    No document available
                                </div>
                            }
                        </div>
                        <div>
                            <p class="doc-sub-title"><i class="fas fa-receipt"></i> PAN Document</p>
                            @if (!string.IsNullOrEmpty(Model.Company.PanDocument))
                            {
                                <div class="document-container">
                                    <img src="~/PanImage/@Model.Company.PanDocument" alt="PAN Document" class="document-image">
                                    <div class="image-overlay">
                                        <span class="view-full-btn"><i class="fas fa-expand-alt"></i> View Full</span>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="no-doc">
                                    <i class="fas fa-file-excel" style="font-size:2rem;opacity:.4;display:block;margin-bottom:.5rem;"></i>
                                    No document available
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Bank Information -->
            @if (Model.Bank != null)
            {
                <div class="info-card" style="border-radius:0 0 12px 12px;margin-bottom:0;border-left:none;border-right:none;border-top:none;">
                    <div class="card-header">
                        <i class="fas fa-university"></i>
                        Bank Information
                    </div>
                    <div class="card-body">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="info-item">
                                <span class="info-label"><i class="fas fa-university"></i> Bank Name</span>
                                <span class="info-value">@Model.Bank.BankName</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label"><i class="fas fa-credit-card"></i> Account Number</span>
                                <span class="info-value">@Model.Bank.AccountNumber</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label"><i class="fas fa-money-check"></i> Account Type</span>
                                <span class="info-value">@Model.Bank.AccountType</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label"><i class="fas fa-user"></i> Account Holder</span>
                                <span class="info-value">@Model.Bank.AccountHolderName</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.2.1/flowbite.min.js"></script>
