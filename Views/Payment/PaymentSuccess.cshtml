@model PaymentEdit

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

<style>
    :root {
        --navy: #0B1F3A;
        --navy-mid: #122848;
        --gold: #C8960C;
        --gold-lt: #E8B84B;
        --ivory: #F7F3EC;
        --slate: #8A9BB5;
        --white: #ffffff;
        --muted: #5a6a80;
    }

    .ps-wrap {
        min-height: 100vh;
        background: var(--ivory);
        padding: 3rem 1.2rem;
        font-family: 'DM Sans', sans-serif;
    }

    .ps-card {
        background: var(--white);
        border-radius: 18px;
        box-shadow: 0 16px 56px rgba(11,31,58,.13);
        overflow: hidden;
        max-width: 780px;
        margin: 0 auto;
    }

    /* ?? HERO STRIP ?? */
    .ps-strip {
        background: var(--navy);
        position: relative;
        overflow: hidden;
        padding: 2.6rem 2rem 4rem;
        text-align: center;
    }

        .ps-strip::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(200,150,12,.05) 1px, transparent 1px), linear-gradient(90deg, rgba(200,150,12,.05) 1px, transparent 1px);
            background-size: 40px 40px;
        }

        .ps-strip::after {
            content: '';
            position: absolute;
            top: -40%;
            left: 50%;
            transform: translateX(-50%);
            width: 380px;
            height: 380px;
            background: radial-gradient(circle, rgba(200,150,12,.13) 0%, transparent 65%);
        }

    .ps-icon-ring {
        position: relative;
        z-index: 2;
        width: 72px;
        height: 72px;
        border-radius: 50%;
        background: rgba(16,185,129,.15);
        border: 2px solid rgba(16,185,129,.3);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.1rem;
    }

        .ps-icon-ring i {
            font-size: 2rem;
            color: #34d399;
        }

    .ps-strip h2 {
        position: relative;
        z-index: 2;
        font-family: 'Playfair Display', serif;
        font-size: 1.7rem;
        font-weight: 900;
        color: var(--white);
        margin: 0 0 .35rem;
    }

        .ps-strip h2 em {
            font-style: normal;
            color: var(--gold-lt);
        }

    .ps-strip p {
        position: relative;
        z-index: 2;
        font-size: .87rem;
        color: var(--slate);
        margin: 0;
    }

    /* ?? BODY ?? */
    .ps-body {
        padding: 0 1.8rem 2rem;
        margin-top: -1.6rem;
        position: relative;
        z-index: 2;
    }

    /* section label */
    .ps-section-hd {
        display: flex;
        align-items: center;
        gap: .6rem;
        margin-bottom: 1rem;
    }

    .ps-section-icon {
        width: 30px;
        height: 30px;
        border-radius: 7px;
        background: rgba(200,150,12,.12);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--gold);
        font-size: .78rem;
    }

    .ps-section-title {
        font-size: .75rem;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--slate);
    }

    /* details grid */
    .ps-details {
        background: var(--ivory);
        border-radius: 12px;
        border: 1px solid rgba(11,31,58,.06);
        overflow: hidden;
        margin-bottom: 1.8rem;
    }

    .ps-details-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0;
    }

    .ps-details-col {
        padding: 1.4rem 1.6rem;
    }

        .ps-details-col:first-child {
            border-right: 1px solid rgba(11,31,58,.07);
        }

    .ps-row {
        display: flex;
        flex-direction: column;
        gap: .04rem;
        margin-bottom: .95rem;
    }

        .ps-row:last-child {
            margin-bottom: 0;
        }

    .ps-label {
        font-size: .68rem;
        font-weight: 700;
        letter-spacing: .07em;
        text-transform: uppercase;
        color: var(--slate);
    }

    .ps-value {
        font-size: .88rem;
        font-weight: 600;
        color: var(--navy);
    }

        .ps-value.success {
            color: #059669;
        }

        .ps-value.amount {
            font-family: 'Playfair Display', serif;
            font-size: 1.05rem;
            color: var(--gold);
        }

    /* status badge */
    .ps-status {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        padding: .22rem .75rem;
        border-radius: 999px;
        background: #dcfce7;
        color: #166534;
        font-size: .68rem;
        font-weight: 700;
        letter-spacing: .05em;
        text-transform: uppercase;
    }

    /* divider */
    .ps-divider {
        height: 1px;
        background: rgba(11,31,58,.06);
        margin: 1.6rem 0;
    }

    /* action button */
    .ps-actions {
        display: flex;
        justify-content: center;
    }

    .ps-btn {
        display: inline-flex;
        align-items: center;
        gap: .55rem;
        padding: .9rem 2rem;
        border-radius: 9px;
        background: var(--navy);
        color: var(--white);
        font-size: .9rem;
        font-weight: 700;
        text-decoration: none;
        font-family: 'DM Sans', sans-serif;
        transition: background .2s, transform .2s, box-shadow .2s;
        box-shadow: 0 5px 20px rgba(11,31,58,.18);
    }

        .ps-btn:hover {
            background: var(--navy-mid);
            transform: translateY(-2px);
            box-shadow: 0 8px 28px rgba(11,31,58,.26);
            color: var(--white);
            text-decoration: none;
        }

        .ps-btn .btn-badge {
            width: 26px;
            height: 26px;
            border-radius: 6px;
            background: var(--gold);
            color: var(--navy);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .8rem;
        }

    @@media (max-width: 580px) {
        .ps-details-grid

    {
        grid-template-columns: 1fr;
    }

    .ps-details-col:first-child {
        border-right: none;
        border-bottom: 1px solid rgba(11,31,58,.07);
    }

    .ps-body {
        padding: 0 1rem 1.6rem;
    }

    }
</style>

<div class="ps-wrap">
    <div class="ps-card">

        <!-- HERO -->
        <div class="ps-strip">
            <div class="ps-icon-ring">
                <i class="fas fa-check-circle"></i>
            </div>
            <h2>Payment <em>Successful!</em></h2>
            <p>Your payment has been verified and processed successfully.</p>
        </div>

        <!-- BODY -->
        <div class="ps-body">

            <div class="ps-section-hd" style="margin-top:2rem;">
                <div class="ps-section-icon"><i class="fas fa-receipt"></i></div>
                <span class="ps-section-title">Payment Details</span>
            </div>

            <div class="ps-details">
                <div class="ps-details-grid">

                    <!-- Left col -->
                    <div class="ps-details-col">
                        <div class="ps-row">
                            <span class="ps-label">Tender ID</span>
                            <span class="ps-value">#@Model.TenderId</span>
                        </div>
                        <div class="ps-row">
                            <span class="ps-label">Date</span>
                            <span class="ps-value">@Model.PaymentDate.ToString("f")</span>
                        </div>
                        <div class="ps-row">
                            <span class="ps-label">Method</span>
                            <span class="ps-value">Esewa</span>
                        </div>
                        <div class="ps-row">
                            <span class="ps-label">Status</span>
                            <span class="ps-status"><i class="fas fa-check-circle"></i> Verified</span>
                        </div>
                    </div>

                    <!-- Right col -->
                    <div class="ps-details-col">
                        <div class="ps-row">
                            <span class="ps-label">Paid By</span>
                            <span class="ps-value">@Model.PayFromUser.FirstName</span>
                        </div>
                        <div class="ps-row">
                            <span class="ps-label">Company</span>
                            <span class="ps-value">@Model.PayFromCompany.CompanyName</span>
                        </div>
                        <div class="ps-row">
                            <span class="ps-label">Paid Amount</span>
                            <span class="ps-value amount">Rs. @Model.PaymentAmount.ToString("N2")</span>
                        </div>
                        <div class="ps-row">
                            <span class="ps-label">Paid To</span>
                            <span class="ps-value">@Model.PayToUser?.FirstName</span>
                        </div>
                        <div class="ps-row">
                            <span class="ps-label">Tender Title</span>
                            <span class="ps-value">@Model.TenderTitle</span>
                        </div>
                    </div>

                </div>
            </div>

            <div class="ps-actions">
                <a href="@Url.Action("TenderBidTab", "BidTender", new { activeTab = "UpcomingTender" })" class="ps-btn">
                    <span class="btn-badge"><i class="fas fa-list"></i></span>
                    View Tenders
                </a>
            </div>

        </div>
    </div>
</div>
