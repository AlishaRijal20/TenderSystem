@{
    ViewData["Title"] = "Payment Failed";
}

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

<style>
    :root {
        --navy: #0B1F3A;
        --navy-mid: #122848;
        --gold: #C8960C;
        --gold-lt: #E8B84B;
        --ivory: #F7F3EC;
        --slate: #8A9BB5;
        --white: #ffffff;
    }

    .pf-wrap {
        min-height: 100vh;
        background: var(--ivory);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 3rem 1.2rem;
        font-family: 'DM Sans', sans-serif;
    }

    .pf-card {
        background: var(--white);
        border-radius: 18px;
        box-shadow: 0 16px 56px rgba(11,31,58,.13);
        overflow: hidden;
        max-width: 440px;
        width: 100%;
    }

    /* top strip */
    .pf-strip {
        background: var(--navy);
        position: relative;
        overflow: hidden;
        padding: 2.5rem 2rem 3.5rem;
        text-align: center;
    }

        .pf-strip::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(200,150,12,.05) 1px, transparent 1px), linear-gradient(90deg, rgba(200,150,12,.05) 1px, transparent 1px);
            background-size: 40px 40px;
        }

        .pf-strip::after {
            content: '';
            position: absolute;
            top: -40%;
            left: 50%;
            transform: translateX(-50%);
            width: 320px;
            height: 320px;
            background: radial-gradient(circle, rgba(239,68,68,.12) 0%, transparent 65%);
        }

    .pf-icon-ring {
        position: relative;
        z-index: 2;
        width: 72px;
        height: 72px;
        border-radius: 50%;
        background: rgba(239,68,68,.15);
        border: 2px solid rgba(239,68,68,.3);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.1rem;
    }

        .pf-icon-ring i {
            font-size: 2rem;
            color: #f87171;
        }

    .pf-strip h2 {
        position: relative;
        z-index: 2;
        font-family: 'Playfair Display', serif;
        font-size: 1.55rem;
        font-weight: 900;
        color: var(--white);
        margin: 0 0 .35rem;
    }

        .pf-strip h2 em {
            font-style: normal;
            color: #f87171;
        }

    .pf-strip p {
        position: relative;
        z-index: 2;
        font-size: .85rem;
        color: var(--slate);
        margin: 0;
    }

    /* body */
    .pf-body {
        padding: 2rem;
        margin-top: -1.2rem;
        position: relative;
        z-index: 2;
    }

    .pf-notice {
        background: #fef2f2;
        border: 1px solid #fca5a5;
        border-radius: 10px;
        padding: .9rem 1.1rem;
        display: flex;
        align-items: center;
        gap: .7rem;
        margin-bottom: 1.6rem;
        font-size: .82rem;
        color: #b91c1c;
    }

        .pf-notice i {
            font-size: .95rem;
            flex-shrink: 0;
        }

    .pf-home-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .5rem;
        width: 100%;
        padding: .9rem;
        border-radius: 9px;
        background: var(--navy);
        color: var(--white);
        font-size: .9rem;
        font-weight: 700;
        text-decoration: none;
        font-family: 'DM Sans', sans-serif;
        border: none;
        transition: background .2s, transform .2s, box-shadow .2s;
        box-shadow: 0 5px 20px rgba(11,31,58,.18);
    }

        .pf-home-btn:hover {
            background: var(--navy-mid);
            transform: translateY(-2px);
            box-shadow: 0 8px 28px rgba(11,31,58,.26);
            color: var(--white);
            text-decoration: none;
        }

        .pf-home-btn .btn-badge {
            width: 24px;
            height: 24px;
            border-radius: 6px;
            background: var(--gold);
            color: var(--navy);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .76rem;
        }
</style>

<div class="pf-wrap">
    <div class="pf-card">

        <div class="pf-strip">
            <div class="pf-icon-ring">
                <i class="fas fa-times-circle"></i>
            </div>
            <h2>Payment <em>Failed</em></h2>
            <p>Your payment could not be processed. Please try again.</p>
        </div>

        <div class="pf-body">
            <div class="pf-notice">
                <i class="fas fa-exclamation-triangle"></i>
                The transaction was unsuccessful. No amount has been deducted from your account.
            </div>

            <a asp-controller="BidTender" asp-action="Index" class="pf-home-btn">
                <span class="btn-badge"><i class="fas fa-home"></i></span>
                Return to Home
            </a>
        </div>

    </div>
</div>
