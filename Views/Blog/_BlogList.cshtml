@model IEnumerable<TenderSystem.Models.BlogContentEdit>

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

<style>
    :root {
        --navy: #0B1F3A;
        --navy-mid: #122848;
        --gold: #C8960C;
        --gold-lt: #E8B84B;
        --ivory: #F7F3EC;
        --slate: #8A9BB5;
        --white: #ffffff;
        --muted: #5a6a80;
    }

    .pbl-wrap {
        max-width: 760px;
        margin: 0 auto;
        padding: 2rem 1.2rem;
        font-family: 'DM Sans', sans-serif;
    }

    .pbl-section-hd {
        display: flex;
        align-items: center;
        gap: .7rem;
        margin-bottom: 1.6rem;
    }

    .pbl-section-icon {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        background: rgba(200,150,12,.12);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--gold);
        font-size: .88rem;
    }

    .pbl-section-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.05rem;
        font-weight: 900;
        color: var(--navy);
        margin: 0;
    }

    /* ── BLOG CARD ── */
    .blog-card {
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 5px 24px rgba(11,31,58,.08);
        transition: transform .3s ease, box-shadow .3s ease;
        margin-bottom: 1.8rem;
        background: var(--white);
        border: 1px solid rgba(11,31,58,.06);
    }

        .blog-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 36px rgba(11,31,58,.13);
        }

    /* header — navy top bar */
    .blog-header {
        padding: .9rem 1.3rem;
        border-bottom: 1px solid rgba(11,31,58,.05);
        display: flex;
        align-items: center;
        gap: .75rem;
        background: var(--navy);
    }

    .user-photo {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid rgba(200,150,12,.3);
        box-shadow: 0 2px 8px rgba(11,31,58,.15);
        flex-shrink: 0;
    }

    .user-photo-placeholder {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: rgba(200,150,12,.15);
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid rgba(200,150,12,.25);
        color: var(--gold);
        font-size: 1.1rem;
        flex-shrink: 0;
    }

    .user-info {
        flex: 1;
    }

    .user-name {
        font-weight: 700;
        color: var(--white);
        font-size: .9rem;
        margin: 0 0 .1rem;
    }

    .post-date {
        font-size: .72rem;
        color: var(--slate);
        display: flex;
        align-items: center;
        gap: .3rem;
    }

        .post-date i {
            color: var(--gold);
            font-size: .68rem;
        }

    /* content */
    .blog-content {
        padding: 1.3rem 1.4rem;
    }

    .blog-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.2rem;
        font-weight: 900;
        color: var(--navy);
        margin: 0 0 .9rem;
        line-height: 1.3;
    }

    .blog-description {
        color: var(--muted);
        line-height: 1.7;
        font-size: .88rem;
        overflow: hidden;
        position: relative;
        max-height: 100px;
        transition: max-height .3s ease;
    }

        .blog-description.expanded {
            max-height: 2000px;
        }

        .blog-description.collapsed::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 70px;
            background: linear-gradient(to bottom, rgba(255,255,255,0), rgba(255,255,255,1));
            pointer-events: none;
        }

    .read-more-btn {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        color: var(--gold);
        font-weight: 700;
        font-size: .82rem;
        margin-top: .75rem;
        cursor: pointer;
        transition: color .2s;
    }

        .read-more-btn:hover {
            color: var(--gold-lt);
        }

    /* image */
    .blog-image-container {
        width: 100%;
        max-height: 400px;
        overflow: hidden;
    }

    .blog-image {
        width: 100%;
        height: auto;
        object-fit: cover;
        display: block;
        transition: transform .3s ease;
        cursor: pointer;
    }

        .blog-image:hover {
            transform: scale(1.02);
        }

    /* image modal */
    .image-modal {
        display: none;
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgba(0,0,0,.9);
        cursor: pointer;
    }

    .image-modal-content {
        position: relative;
        margin: auto;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        width: 100%;
        padding: 20px;
        box-sizing: border-box;
    }

    .image-modal-img {
        max-width: 90%;
        max-height: 90%;
        object-fit: contain;
        box-shadow: 0 0 20px rgba(255,255,255,.1);
        border-radius: 6px;
    }

    .image-modal-close {
        position: absolute;
        top: 20px;
        right: 30px;
        color: #f1f1f1;
        font-size: 40px;
        font-weight: bold;
        cursor: pointer;
        z-index: 1001;
        transition: .3s;
    }

        .image-modal-close:hover {
            color: var(--gold-lt);
            transform: scale(1.1);
        }

    @@media (max-width: 768px) {
        .pbl-wrap {
            padding: 1.2rem .75rem;
        }
    }
</style>

<div class="pbl-wrap">

    <div class="pbl-section-hd">
        <div class="pbl-section-icon"><i class="fas fa-newspaper"></i></div>
        <h2 class="pbl-section-title">Latest Blog Posts</h2>
    </div>

    @foreach (var blog in Model)
    {
        <div class="blog-card">
            <div class="blog-header">
                @if (!string.IsNullOrEmpty(blog.UserPhoto))
                {
                    <img src="~/UserImage/@blog.UserPhoto" alt="@blog.FirstName's photo" class="user-photo" />
                }
                else
                {
                    <div class="user-photo-placeholder">
                        <i class="fas fa-user"></i>
                    </div>
                }
                <div class="user-info">
                    <h6 class="user-name">
                        @blog.FirstName
                        @(!string.IsNullOrEmpty(blog.MiddleName) ? blog.MiddleName + " " : "")
                        @blog.LastName
                    </h6>
                    <span class="post-date">
                        <i class="far fa-calendar-alt"></i>
                        @blog.Postdate.ToString("MMMM dd, yyyy")
                    </span>
                </div>
            </div>

            <div class="blog-content">
                <h2 class="blog-title">@blog.SectionHeading</h2>
                <div class="blog-description collapsed">
                    @Html.Raw(blog.SectionDescription)
                </div>
                <div class="read-more-btn">
                    Read More <i class="fas fa-chevron-down ms-1"></i>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(blog.SectionImage))
            {
                <div class="blog-image-container">
                    <img src="~/BlogImage/@blog.SectionImage" class="blog-image" alt="Blog Image" />
                </div>
            }
        </div>
    }

</div>

<script>
    $(document).ready(function () {
        $('.read-more-btn').each(function () {
            var button = $(this);
            var description = button.prev('.blog-description');

            // Check if description needs a "Read More" button
            if (description.prop('scrollHeight') <= 100) {
                button.hide();
                description.removeClass('collapsed');
            }

            // Add click event
            button.on('click', function () {
                var isCollapsed = description.hasClass('collapsed');

                if (isCollapsed) {
                    description.removeClass('collapsed').addClass('expanded');
                    button.html('Show Less <i class="fas fa-chevron-up ms-1"></i>');
                } else {
                    description.removeClass('expanded').addClass('collapsed');
                    button.html('Read More <i class="fas fa-chevron-down ms-1"></i>');

                    // Smooth scroll
                    $('html, body').animate({
                        scrollTop: button.closest('.blog-card').offset().top - 20
                    }, 300);
                }
            });
        });

        // New image viewer functionality
        $('.blog-image').on('click', function () {
            var imageUrl = $(this).attr('src');

            // Create modal for full-size image view
            var imageModal = $('<div id="imageModal" class="image-modal">' +
                '<div class="image-modal-content">' +
                '<span class="image-modal-close">&times;</span>' +
                '<img src="' + imageUrl + '" class="image-modal-img">' +
                '</div></div>');

            // Add modal to body
            $('body').append(imageModal);

            // Show the modal
            $('#imageModal').fadeIn(300);

            // Close modal when clicking X or outside the image
            $('.image-modal-close, .image-modal').on('click', function (e) {
                if (e.target === this || $(e.target).hasClass('image-modal-close')) {
                    $('#imageModal').fadeOut(300, function () {
                        $(this).remove();
                    });
                }
            });
        });
    });
</script>
