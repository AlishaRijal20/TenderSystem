@model BlogContentEdit
@{
    ViewData["Title"] = "Publish Blog";
    Layout = "";
}

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<style>
    :root {
        --navy: #0B1F3A;
        --navy-mid: #122848;
        --gold: #C8960C;
        --gold-lt: #E8B84B;
        --ivory: #F7F3EC;
        --slate: #8A9BB5;
        --white: #ffffff;
        --muted: #5a6a80;
    }

    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        font-family: 'DM Sans', sans-serif;
        background: var(--ivory);
        min-height: 100vh;
    }

    /* ── PAGE ── */
    .pb-page {
        max-width: 860px;
        margin: 0 auto;
        padding: 2.5rem 1.5rem 4rem;
    }

    /* ── HEADER ── */
    .pb-hero {
        background: var(--navy);
        border-radius: 16px 16px 0 0;
        position: relative;
        overflow: hidden;
        padding: 2.2rem 2.2rem 3.5rem;
    }

        .pb-hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(200,150,12,.05) 1px, transparent 1px), linear-gradient(90deg, rgba(200,150,12,.05) 1px, transparent 1px);
            background-size: 40px 40px;
            pointer-events: none;
        }

        .pb-hero::after {
            content: '';
            position: absolute;
            top: -40%;
            right: -5%;
            width: 340px;
            height: 340px;
            background: radial-gradient(circle, rgba(200,150,12,.15) 0%, transparent 65%);
            pointer-events: none;
        }

    .pb-hero-inner {
        position: relative;
        z-index: 2;
    }

    .pb-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        font-size: .65rem;
        font-weight: 500;
        letter-spacing: .2em;
        text-transform: uppercase;
        color: var(--gold);
        margin-bottom: .5rem;
    }

        .pb-eyebrow span {
            display: inline-block;
            width: 18px;
            height: 1px;
            background: var(--gold);
        }

    .pb-hero h1 {
        font-family: 'Playfair Display', serif;
        font-size: clamp(1.4rem, 3vw, 1.9rem);
        font-weight: 900;
        color: var(--white);
        margin: 0 0 .3rem;
        line-height: 1.2;
    }

        .pb-hero h1 em {
            font-style: normal;
            color: var(--gold-lt);
        }

    .pb-hero-sub {
        font-size: .87rem;
        color: var(--slate);
    }

    /* ── CARD ── */
    .pb-card {
        background: var(--white);
        border-radius: 0 0 16px 16px;
        box-shadow: 0 12px 48px rgba(11,31,58,.12);
        overflow: hidden;
        margin-top: -1.4rem;
        position: relative;
        z-index: 2;
        padding: 2.2rem;
    }

    /* ── FIELD ── */
    .pb-field {
        margin-bottom: 1.5rem;
    }

    .pb-label {
        display: flex;
        align-items: center;
        gap: .4rem;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--slate);
        margin-bottom: .5rem;
    }

        .pb-label i {
            color: var(--gold);
            font-size: .78rem;
        }

    .pb-input,
    .pb-textarea {
        width: 100%;
        padding: .85rem 1rem;
        border: 1.5px solid rgba(11,31,58,.13);
        border-radius: 9px;
        font-size: .9rem;
        font-family: 'DM Sans', sans-serif;
        color: var(--navy);
        background: var(--white);
        transition: border-color .2s, box-shadow .2s;
        outline: none;
    }

        .pb-input::placeholder,
        .pb-textarea::placeholder {
            color: var(--slate);
            font-size: .87rem;
        }

        .pb-input:focus,
        .pb-textarea:focus {
            border-color: var(--gold);
            box-shadow: 0 0 0 3px rgba(200,150,12,.1);
        }

    .pb-textarea {
        resize: vertical;
        min-height: 180px;
        line-height: 1.7;
    }

    .pb-val-error {
        font-size: .72rem;
        color: #ef4444;
        margin-top: .3rem;
        display: block;
    }

    /* ── FILE UPLOAD ── */
    .pb-file-zone {
        width: 100%;
        padding: 1.1rem;
        background: var(--ivory);
        border: 1.5px dashed rgba(11,31,58,.18);
        border-radius: 9px;
        transition: border-color .2s, background .2s;
        cursor: pointer;
    }

        .pb-file-zone:hover {
            border-color: var(--gold);
            background: rgba(200,150,12,.04);
        }

    .pb-file-input {
        display: block;
        width: 100%;
        font-size: .84rem;
        color: var(--muted);
        font-family: 'DM Sans', sans-serif;
    }

        .pb-file-input::file-selector-button {
            margin-right: .75rem;
            padding: .38rem 1rem;
            border-radius: 999px;
            border: none;
            background: rgba(200,150,12,.12);
            color: var(--navy);
            font-weight: 700;
            font-size: .78rem;
            cursor: pointer;
            font-family: 'DM Sans', sans-serif;
            transition: background .2s;
        }

            .pb-file-input::file-selector-button:hover {
                background: rgba(200,150,12,.22);
            }

    /* image preview */
    #imagePreview {
        margin-top: .9rem;
    }

        #imagePreview img {
            max-height: 240px;
            border-radius: 10px;
            border: 2px solid rgba(200,150,12,.2);
            box-shadow: 0 4px 16px rgba(11,31,58,.1);
        }

    /* ── ACTIONS ── */
    .pb-actions {
        display: flex;
        justify-content: flex-end;
        margin-top: 1.8rem;
    }

    .pb-submit {
        display: inline-flex;
        align-items: center;
        gap: .55rem;
        padding: .9rem 2rem;
        border-radius: 9px;
        background: var(--navy);
        color: var(--white);
        font-size: .9rem;
        font-weight: 700;
        border: none;
        cursor: pointer;
        font-family: 'DM Sans', sans-serif;
        transition: background .2s, transform .2s, box-shadow .2s;
        box-shadow: 0 5px 20px rgba(11,31,58,.2);
        position: relative;
        overflow: hidden;
    }

        .pb-submit::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(200,150,12,.15), transparent);
            opacity: 0;
            transition: opacity .3s;
        }

        .pb-submit:hover {
            background: var(--navy-mid);
            transform: translateY(-2px);
            box-shadow: 0 8px 28px rgba(11,31,58,.28);
        }

            .pb-submit:hover::before {
                opacity: 1;
            }

        .pb-submit .btn-gold {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 26px;
            height: 26px;
            border-radius: 6px;
            background: var(--gold);
            color: var(--navy);
            font-size: .8rem;
            transition: transform .2s;
        }

        .pb-submit:hover .btn-gold {
            transform: scale(1.1);
        }

    /* divider */
    .pb-divider {
        height: 1px;
        background: rgba(11,31,58,.06);
        margin: 1.8rem 0;
    }

    @@media (max-width: 768px) {
        .pb-page {
            padding: 1.5rem .75rem 3rem;
        }

        .pb-hero {
            padding: 1.8rem 1.2rem 3rem;
        }

        .pb-card {
            padding: 1.5rem 1rem;
        }
    }
</style>

<div class="pb-page">

    <!-- HERO BANNER -->
    <div class="pb-hero">
        <div class="pb-hero-inner">
            <p class="pb-eyebrow"><span></span> Portal Blog</p>
            <h1>Publish <em>New Post</em></h1>
            <p class="pb-hero-sub">Share your thoughts and insights with the community</p>
        </div>
    </div>

    <!-- FORM CARD -->
    <div class="pb-card">
        <form asp-action="PublishBlog" asp-controller="Blog" method="post" enctype="multipart/form-data">

            <!-- Blog Title -->
            <div class="pb-field">
                <label asp-for="SectionHeading" class="pb-label">
                    <i class="fas fa-heading"></i> Blog Title
                </label>
                <input asp-for="SectionHeading" class="pb-input"
                       placeholder="Enter a compelling blog title" required />
                <span asp-validation-for="SectionHeading" class="pb-val-error"></span>
            </div>

            <div class="pb-divider"></div>

            <!-- Blog Content -->
            <div class="pb-field">
                <label asp-for="SectionDescription" class="pb-label">
                    <i class="fas fa-paragraph"></i> Blog Content
                </label>
                <textarea asp-for="SectionDescription" rows="6" class="pb-textarea"
                          placeholder="Write your blog content here..." required></textarea>
                <span asp-validation-for="SectionDescription" class="pb-val-error"></span>
            </div>

            <div class="pb-divider"></div>

            <!-- Blog Image -->
            <div class="pb-field">
                <label asp-for="BlogFile" class="pb-label">
                    <i class="fas fa-image"></i> Blog Image
                </label>
                <div class="pb-file-zone">
                    <input asp-for="BlogFile" type="file" accept="image/*"
                           class="pb-file-input" />
                </div>
                <span asp-validation-for="BlogFile" class="pb-val-error"></span>
                <div id="imagePreview"></div>
            </div>

            <!-- Submit -->
            <div class="pb-actions">
                <button type="submit" class="pb-submit">
                    <span class="btn-gold"><i class="fas fa-paper-plane"></i></span>
                    Publish Blog
                </button>
            </div>

        </form>
    </div>

</div>

<script>
    document.getElementById('BlogFile').addEventListener('change', function (e) {
        if (e.target.files && e.target.files[0]) {
            const reader = new FileReader();
            reader.onload = function (e) {
                const preview = document.createElement('img');
                preview.src = e.target.result;
                preview.className = 'max-h-64 rounded-lg';
                const previewDiv = document.getElementById('imagePreview');
                previewDiv.innerHTML = '';
                previewDiv.appendChild(preview);
            }
            reader.readAsDataURL(e.target.files[0]);
        }
    });
</script>
